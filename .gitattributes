# Normalize line endings: LF in the repository, native in the working tree.
# Landed before the Astro migration so that line-ending churn never mixes into
# migration diffs. Development is on Windows, CI runs on Ubuntu.
* text=auto eol=lf

# Binary assets — never normalize or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.mp3 binary
*.wav binary
*.ogg binary

# Lockfiles are generated — collapse them in diffs and reviews.
package-lock.json -diff linguist-generated
