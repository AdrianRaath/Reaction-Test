---
import { Icon } from 'astro-icon/components';
import BrandMark from './BrandMark.astro';

// The top bar is a SLOT, not a fixed set of buttons (§3.5). Sound and reset
// generalise across today's two tools, but an aim trainer wants sensitivity
// and a typing test wants a word-list picker — so each page passes its own
// controls in rather than the shell hardcoding them.

interface Props {
  /** Short label for the current page, shown on desktop. */
  label?: string;
  /**
   * Render the telemetry readout (best / average / tier). Tool pages only.
   * The rig fills these ids; before the first run every value shows a dimmed
   * dash rather than the strip disappearing.
   */
  showStats?: boolean;
}

const { label, showStats = false } = Astro.props;
---

<header class="topbar">
  <!-- Mobile only: the sidebar (and its brand) is hidden in a drawer, so the
       bar carries the logo instead — matching the legacy mobile header. -->
  <a href="/" class="topbar-brand">
    <BrandMark size={24} />
    <span>ReflexLab</span>
  </a>

  {label && <p class="topbar-label">{label}</p>}

  {
    showStats && (
      <div class="topbar-stats" id="topbar-stats">
        <span class="tb-stat">
          <span class="tb-label">Best</span>
          <span class="tb-value tb-best readout is-empty" id="topbar-best">
            —
          </span>
        </span>
        <span class="tb-sep" aria-hidden="true">
          ·
        </span>
        <span class="tb-stat">
          <span class="tb-label">Avg</span>
          <span class="tb-value readout is-empty" id="topbar-avg">
            —
          </span>
        </span>
        <span class="tb-sep" aria-hidden="true">
          ·
        </span>
        <span class="tb-stat">
          {/* The rig relabels this "Milestone" on tools that have no ranks. */}
          <span class="tb-label" id="topbar-tier-label">
            Rank
          </span>
          <span class="tb-tier is-empty" id="topbar-tier">
            —
          </span>
        </span>
      </div>
    )
  }

  <div class="topbar-controls">
    <slot />
    <button
      type="button"
      class="menu-btn"
      data-drawer-toggle
      aria-controls="sidebar"
      aria-expanded="false"
    >
      <Icon name="ph:list" width={20} height={20} aria-hidden="true" />
      <span class="visually-hidden">Open menu</span>
    </button>
  </div>
</header>

<style>
  .topbar {
    position: relative;
    display: flex;
    height: var(--topbar-height);
    align-items: center;
    gap: var(--space-sm);
    padding-inline: var(--space-md);
    border-block-end: 1px solid var(--line);
    background-color: var(--chassis-black);
  }

  .topbar-brand {
    display: none;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-title-size);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .topbar-label {
    font-size: var(--text-label-size);
    font-weight: 600;
    color: var(--ink-secondary);
  }

  /* --- Telemetry readout (tool pages) ------------------------------------- */

  /* Centred on the bar itself, not on the space left over between the label and
     the controls — auto margins would split the free space three ways with the
     controls' own auto margin and land it left of centre. Taken out of flow so
     neither neighbour can shift it. */
  .topbar-stats {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
  }

  .tb-stat {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .tb-label {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .tb-value {
    font-size: var(--text-label-size);
    font-weight: 600;
    color: var(--ink-primary);
  }

  /* Signal Green on the personal best is sanctioned by the One Signal Rule —
     "your best" is one of its three licensed meanings. */
  .tb-best {
    color: var(--signal-green);
  }

  .tb-sep {
    color: var(--ink-disabled);
  }

  /* Rank tint here is licensed by the Rank-Only Colour Rule: this is a rank
     badge. Milestone tools get the same chip with no tint. */
  .tb-tier {
    padding: 2px var(--space-sm);
    border-radius: var(--radius-sm);
    background-color: var(--panel-hover);
    color: var(--ink-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .tb-tier.elite {
    background-color: rgb(168 85 247 / 20%);
    color: var(--rank-elite);
  }
  .tb-tier.pro {
    background-color: rgb(34 197 94 / 20%);
    color: var(--rank-pro);
  }
  .tb-tier.advanced {
    background-color: rgb(59 130 246 / 20%);
    color: var(--rank-advanced);
  }
  .tb-tier.intermediate {
    background-color: rgb(245 158 11 / 20%);
    color: var(--rank-intermediate);
  }
  .tb-tier.beginner {
    background-color: rgb(144 144 153 / 20%);
    color: var(--rank-beginner);
  }

  /* Before the first run every value is a dash — dim, so the strip reads as
     "nothing yet" rather than a broken readout. */
  .tb-value.is-empty,
  .tb-tier.is-empty {
    color: var(--ink-disabled);
  }

  .tb-tier.is-empty {
    background-color: transparent;
    padding-inline: 0;
  }

  .topbar-controls {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-inline-start: auto;
  }

  .menu-btn {
    display: none;
    padding: var(--space-xs);
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    color: var(--ink-secondary);
  }

  .menu-btn:hover {
    background-color: var(--panel-hover);
    color: var(--ink-primary);
  }

  /* Desktop: the bar stays put while the main column scrolls (§3.5). */
  @media (min-width: 901px) {
    .topbar {
      position: sticky;
      top: 0;
      z-index: 20;
    }
  }

  /* The readout needs more room than the label, so it drops first. Below this
     width the same numbers are a short scroll away in the widgets. */
  @media (max-width: 1100px) {
    .topbar-stats {
      display: none;
    }
  }

  /* Mobile: deliberately NOT sticky. A pinned bar would permanently consume
     ~56px of vertical space, and nothing may compete with the test area on a
     small screen (§3.5). It scrolls away instead. */
  @media (max-width: 900px) {
    .menu-btn {
      display: block;
    }

    .topbar-brand {
      display: flex;
    }

    /* The brand identifies the page context on mobile; the label would crowd
       the controls on narrow screens. */
    .topbar-label {
      display: none;
    }
  }
</style>
