---
import type { PerkId } from '../../games/spacebar-clicker/config';

// One bespoke glyph per Spacebar Clicker perk, in the same idiom as the shop's
// own glyphs (ShopIcon.astro): 24-unit grid, 1.5 stroke, round caps and
// joins, currentColor. The perk's family colors it (DESIGN.md, the
// Perk-Family Exception), so the glyph alone has to say which perk it is.
// Decorative only: the perk's name always sits beside it.
//
// The page renders all 25 inside a <template>, and the script clones the one
// it needs into an offer row or a dialog.

interface Props {
  id: PerkId;
}

const GLYPHS: Record<PerkId, string> = {
  // --- Rhythm --------------------------------------------------------------
  // A metronome with its bob swung out.
  metronome:
    '<path d="M9 3.5h6l3.5 17h-13z"/><path d="M12 17 16.5 4.5"/>' +
    '<circle cx="14.6" cy="9.8" r="1.4"/>',
  // A pause that keeps the beat.
  'held-breath': '<circle cx="12" cy="12" r="8.5"/><path d="M10 8.5v7M14 8.5v7"/>',
  // A struck tuning fork, ringing.
  overtone:
    '<path d="M8 3v6.5a4 4 0 0 0 8 0V3"/><path d="M12 13.5v8"/>' +
    '<path d="M19.5 4.5a6.5 6.5 0 0 1 0 6.5M4.5 4.5a6.5 6.5 0 0 0 0 6.5"/>',
  // A ball with speed lines behind it.
  momentum: '<circle cx="15" cy="12" r="5.5"/><path d="M2.5 8.5h5M4 12h4.5M2.5 15.5h5"/>',
  // A cut gem: precious, and brittle.
  'glass-rhythm':
    '<path d="M6.5 4h11l4 5.5L12 20.5 2.5 9.5z"/><path d="M2.5 9.5h19"/>' +
    '<path d="M9.5 4 8 9.5l4 11 4-11L14.5 4"/>',
  // Two waves locked in phase, Synchronisation's waves made fast.
  'full-sync':
    '<path d="M2.5 9q2.4-4 4.75 0t4.75 0 4.75 0 4.75 0"/>' +
    '<path d="M2.5 15q2.4-4 4.75 0t4.75 0 4.75 0 4.75 0"/><path d="M7.25 9v6M16.75 9v6"/>',

  // --- Press power ---------------------------------------------------------
  // A fingerprint.
  'finger-memory':
    '<path d="M5.6 16.8A9.5 9.5 0 0 1 4.5 12a7.5 7.5 0 0 1 15 0c0 1.6-.1 3.1-.4 4.5"/>' +
    '<path d="M8.7 20.5A14 14 0 0 1 7.5 12a4.5 4.5 0 0 1 9 0c0 2.5-.3 4.8-.9 7"/>' +
    '<path d="M12 12c0 3.3-.4 6.3-1.2 9"/>',
  // A coil wound tight.
  'coiled-spring':
    '<path d="M10.5 12.75a1.5 1.5 0 0 1 3 0a3 3 0 0 1-6 0a4.5 4.5 0 0 1 9 0' +
    'a6 6 0 0 1-12 0a7.5 7.5 0 0 1 15 0"/>',
  // A sledgehammer mid-swing.
  'brute-force':
    '<g transform="rotate(-40 12 12)"><rect x="5" y="3" width="14" height="6.5" rx="1.5"/>' +
    '<path d="M12 9.5v12"/></g>',

  // --- Luck ----------------------------------------------------------------
  // A die showing five.
  'loaded-dice':
    '<rect x="3.5" y="3.5" width="17" height="17" rx="3.5"/>' +
    '<g fill="currentColor" stroke="none"><circle cx="8.5" cy="8.5" r="1.3"/>' +
    '<circle cx="15.5" cy="8.5" r="1.3"/><circle cx="12" cy="12" r="1.3"/>' +
    '<circle cx="8.5" cy="15.5" r="1.3"/><circle cx="15.5" cy="15.5" r="1.3"/></g>',
  // Dominoes falling, each tipping the next.
  'chain-reaction':
    '<path d="M2.5 20.5h19"/><rect x="3.5" y="9" width="3.5" height="11.5" rx="1"/>' +
    '<rect x="9" y="9" width="3.5" height="11.5" rx="1" transform="rotate(22 12.5 20.5)"/>' +
    '<rect x="14.5" y="9" width="3.5" height="11.5" rx="1" transform="rotate(48 18 20.5)"/>',
  // A ghost: presses that nobody made.
  'ghost-presses':
    '<path d="M5.5 20.5V11a6.5 6.5 0 0 1 13 0v9.5l-2.17-1.5-2.16 1.5-2.17-1.5-2.17 1.5-2.16-1.5z"/>' +
    '<path d="M10 10v1.5M14 10v1.5"/>',

  // --- Surges --------------------------------------------------------------
  // A bolt beside a rod raised to catch it.
  'lightning-rod':
    '<path d="M15.5 8v12.5M12 20.5h7"/><path d="M15.5 8 14 4.5l1.5-2 1.5 2z"/>' +
    '<path d="M9.5 2.5 6 9h4l-2.5 5.5"/>',
  // The sun just under the horizon, still glowing.
  afterglow:
    '<path d="M3 17.5h18M7.5 20.5h9"/><path d="M7 17.5a5 5 0 0 1 10 0"/>' +
    '<path d="M12 6.5v2.5M5.3 9.3l1.8 1.8M18.7 9.3l-1.8 1.8M2.5 13.5H5M19 13.5h2.5"/>',
  // A thundercloud.
  'storm-front':
    '<path d="M7.5 16.5h-1a4 4 0 0 1-.6-7.95A5.5 5.5 0 0 1 16.5 7a4 4 0 0 1 1.5 7.75"/>' +
    '<path d="M13 11.5 10.5 16h4L12 20.5"/>',
  // A pylon carrying the surge out to the machines.
  'surge-lines':
    '<path d="M7.5 21 12 3l4.5 18"/><path d="M5 7h14M6.5 11.5h11"/>' +
    '<path d="M10 15.5l5 3.5M14 15.5 9 19"/>',

  // --- Machines ------------------------------------------------------------
  // A clock with extra hours.
  overtime:
    '<circle cx="10.5" cy="13.5" r="7.5"/><path d="M10.5 9.5v4l2.75 1.75"/>' +
    '<path d="M19.5 2v5M17 4.5h5"/>',
  // Boxes riding a belt.
  'assembly-line':
    '<rect x="2.5" y="15" width="19" height="5.5" rx="2.75"/>' +
    '<rect x="4.5" y="7.5" width="6" height="7.5" rx="1"/>' +
    '<rect x="13.5" y="9.5" width="6" height="5.5" rx="1"/>' +
    '<path d="M6.5 17.75h.01M12 17.75h.01M17.5 17.75h.01"/>',
  // A price tag.
  'bulk-order':
    '<path d="M3.5 11.6V4.5a1 1 0 0 1 1-1h7.1a1 1 0 0 1 .7.3l8.4 8.4a1 1 0 0 1 0 1.4l-7.1 7.1' +
    'a1 1 0 0 1-1.4 0l-8.4-8.4a1 1 0 0 1-.3-.7z"/><circle cx="8" cy="8" r="1.5"/>',
  // A load gauge near the top of its dial.
  'critical-load':
    '<path d="M4.2 18.5a9 9 0 1 1 15.6 0"/><path d="M12 15l4.5-5.5"/>' +
    '<circle cx="12" cy="15" r="1.5"/>' +
    '<path d="M12 6.5V8M6 9.5l1.1 1.1M3.5 15H5M18 9.5l-1.1 1.1M20.5 15H19"/>',
  // An hourglass: the machines speed up while you wait.
  'idle-hands':
    '<path d="M6 3.5h12M6 20.5h12"/>' +
    '<path d="M7.5 3.5c0 4.5 4.5 5.5 4.5 8.5s-4.5 4-4.5 8.5M16.5 3.5c0 4.5-4.5 5.5-4.5 8.5s4.5 4 4.5 8.5"/>' +
    '<path d="M10 17.5h4"/>',
  // A moon and a star.
  'night-shift':
    '<path d="M19.5 14.5A8 8 0 1 1 9.5 4.5a6.5 6.5 0 0 0 10 10z"/><path d="M17 2.5v4M15 4.5h4"/>',
  // Two arrows chasing each other round.
  'feedback-loop':
    '<path d="M19.5 9.5A8 8 0 0 0 5.2 7.8M4.5 14.5a8 8 0 0 0 14.3 1.7"/>' +
    '<path d="M5 3.5V8h4.5M19 20.5V16h-4.5"/>',
  // A double helix: the blueprint copies itself.
  'self-replicator':
    '<path d="M7 2.5c0 5 10 4.5 10 9.5s-10 4.5-10 9.5M17 2.5c0 5-10 4.5-10 9.5s10 4.5 10 9.5"/>' +
    '<path d="M8.5 6.25h7M8.5 17.75h7"/>',
  // A robot at the controls.
  autopilot:
    '<rect x="4.5" y="8" width="15" height="11.5" rx="3"/><path d="M12 8V5.25"/>' +
    '<circle cx="12" cy="3.75" r="1.25"/>' +
    '<path d="M9.5 12.75v1.75M14.5 12.75v1.75M2.5 12.5v3M21.5 12.5v3"/>',
};
---

<svg
  class="perk-glyph"
  data-glyph={Astro.props.id}
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={GLYPHS[Astro.props.id]}
/>
