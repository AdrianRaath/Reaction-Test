---
import type { ShopItemId } from '../../games/spacebar-clicker/config';

// One bespoke glyph per Spacebar Clicker shop item. Drawn in the Phosphor
// idiom (24-unit grid, 1.5 stroke, round caps and joins, currentColor) so the
// shop sits beside the site's chrome icons without a second visual language.
// Emoji were tried first and dropped: their uneven widths broke row alignment.
// Decorative only — the item name beside it carries the meaning.
//
// Each glyph names its moving part (g-*), and plays a one-shot motion when the
// script adds .is-bought to the svg: the key presses, the spring compresses,
// the piston strokes, the arm swings, the atom spins.

interface Props {
  id: ShopItemId;
}

const GLYPHS: Record<ShopItemId, string> = {
  // A keycap with a plus on its face: +1 energy per press.
  finger:
    '<g class="g-key"><rect x="3" y="4" width="18" height="16" rx="3"/>' +
    '<rect x="6" y="6.5" width="12" height="9" rx="1.5"/></g>' +
    '<path class="g-plus" d="M12 8.75v4.5M9.75 11h4.5"/>',
  // One key behind another: a press that counts twice.
  double:
    '<rect x="3" y="9" width="12" height="12" rx="2"/>' +
    '<path class="g-back" d="M9 9V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-4"/>',
  // A coil between two plates; the top plate and coil compress together.
  spring:
    '<path d="M6 20h12"/>' + '<path class="g-coil" d="M6 4h12M12 4v2l4 1.5-8 3 8 3-8 3 4 1.5v2"/>',
  // The wire under a spacebar that keeps it level.
  stabiliser:
    '<rect class="g-bar" x="2.5" y="5" width="19" height="7" rx="2"/>' +
    '<path d="M6 12v5.5h12V12"/>',
  // Two waves that slide into phase.
  sync:
    '<path class="g-wave-a" d="M3 9q3-4 6 0t6 0 6 0"/>' +
    '<path class="g-wave-b" d="M3 15q3-4 6 0t6 0 6 0"/>',
  // A person at the bench.
  assistant:
    '<circle class="g-head" cx="12" cy="7.5" r="3.5"/>' +
    '<path d="M5 20.5c0-3.9 3.1-6.5 7-6.5s7 2.6 7 6.5"/>',
  // A piston above a key.
  pneumatic:
    '<rect x="8" y="3" width="8" height="6" rx="1.5"/>' +
    '<path class="g-piston" d="M12 9v4M8.5 13h7"/>' +
    '<rect x="5" y="15.5" width="14" height="5" rx="1.5"/>',
  // Base, two segments, one joint, a claw.
  arm:
    '<rect x="4" y="18" width="8" height="3" rx="1"/>' +
    '<circle cx="10" cy="10" r="2"/>' +
    '<path d="M8 18l1.5-6.05"/>' +
    '<path class="g-upper" d="M11.8 9.1L17 6.5M17 6.5l3-2M17 6.5l3.5 1.5"/>',
  // A keyboard with a dashed copy of itself: several states at once.
  quantum:
    '<path class="g-ghost" stroke-dasharray="2 2.5" d="M5 8V6a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-1"/>' +
    '<rect x="2" y="8" width="17" height="12" rx="2"/>' +
    '<path d="M5.5 12h.01M8.5 12h.01M11.5 12h.01M14.5 12h.01M7 16h7"/>',
  // Orbits around a nucleus.
  collider:
    '<g class="g-orbits"><ellipse cx="12" cy="12" rx="9.5" ry="3.75"/>' +
    '<ellipse cx="12" cy="12" rx="9.5" ry="3.75" transform="rotate(60 12 12)"/>' +
    '<ellipse cx="12" cy="12" rx="9.5" ry="3.75" transform="rotate(120 12 12)"/></g>' +
    '<circle cx="12" cy="12" r="1.25" fill="currentColor" stroke="none"/>',
};
---

<svg
  class="shop-glyph"
  data-glyph={Astro.props.id}
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={GLYPHS[Astro.props.id]}
/>

<style is:global>
  /* Global because the glyph parts arrive through set:html and carry no
     scope attribute. Every rule is prefixed with .shop-glyph. */
  .shop-glyph [class^='g-'] {
    transform-box: view-box;
  }

  .shop-glyph.is-bought .g-key {
    animation: glyph-press 360ms cubic-bezier(0.3, 0, 0.3, 1);
  }
  .shop-glyph.is-bought .g-plus {
    transform-origin: 12px 11px;
    animation: glyph-pop 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .shop-glyph.is-bought .g-back {
    animation: glyph-emerge 460ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .shop-glyph.is-bought .g-coil {
    transform-origin: 12px 20px;
    animation: glyph-compress 620ms cubic-bezier(0.3, 0, 0.3, 1);
  }
  .shop-glyph.is-bought .g-bar {
    animation: glyph-press 360ms cubic-bezier(0.3, 0, 0.3, 1);
  }
  .shop-glyph.is-bought .g-wave-a {
    animation: glyph-phase-a 560ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .shop-glyph.is-bought .g-wave-b {
    animation: glyph-phase-b 560ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .shop-glyph.is-bought .g-head {
    animation: glyph-nod 480ms cubic-bezier(0.3, 0, 0.3, 1);
  }
  .shop-glyph.is-bought .g-piston {
    animation: glyph-stroke 560ms ease-in-out;
  }
  .shop-glyph.is-bought .g-upper {
    transform-origin: 10px 10px;
    animation: glyph-swing 640ms cubic-bezier(0.3, 0, 0.3, 1);
  }
  .shop-glyph.is-bought .g-ghost {
    animation: glyph-ghost 560ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .shop-glyph.is-bought .g-orbits {
    transform-origin: 12px 12px;
    animation: glyph-spin 700ms cubic-bezier(0.3, 0, 0.2, 1);
  }

  @keyframes glyph-press {
    40% {
      transform: translateY(1.5px);
    }
  }
  @keyframes glyph-pop {
    0% {
      transform: scale(1.6);
    }
  }
  @keyframes glyph-emerge {
    0% {
      opacity: 0;
      transform: translate(-6px, 6px);
    }
  }
  @keyframes glyph-compress {
    35% {
      transform: scaleY(0.6);
    }
    70% {
      transform: scaleY(1.08);
    }
  }
  @keyframes glyph-phase-a {
    0% {
      transform: translateX(-3px);
    }
  }
  @keyframes glyph-phase-b {
    0% {
      transform: translateX(3px);
    }
  }
  @keyframes glyph-nod {
    35% {
      transform: translateY(-2px);
    }
    70% {
      transform: translateY(0.5px);
    }
  }
  @keyframes glyph-stroke {
    25%,
    75% {
      transform: translateY(2.5px);
    }
    50% {
      transform: translateY(0);
    }
  }
  @keyframes glyph-swing {
    35% {
      transform: rotate(-22deg);
    }
    70% {
      transform: rotate(8deg);
    }
  }
  @keyframes glyph-ghost {
    0% {
      opacity: 0;
      transform: translate(-3px, 4px);
    }
  }
  @keyframes glyph-spin {
    100% {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-glyph.is-bought [class^='g-'] {
      animation: none;
    }
  }
</style>
