---
import type { ShopItemId } from '../../games/spacebar-clicker/config';

// One bespoke glyph per Spacebar Clicker shop item. Drawn in the Phosphor
// idiom (24-unit grid, 1.5 stroke, round caps and joins, currentColor) so the
// shop sits beside the site's chrome icons without a second visual language.
// Emoji were tried first and dropped: their uneven widths broke row alignment.
// Decorative only — the item name beside it carries the meaning.

interface Props {
  id: ShopItemId;
}

const GLYPHS: Record<ShopItemId, string> = {
  // A keycap with a plus on its face: +1 energy per press.
  finger:
    '<rect x="3" y="4" width="18" height="16" rx="3"/>' +
    '<rect x="6" y="6.5" width="12" height="9" rx="1.5"/>' +
    '<path d="M12 8.75v4.5M9.75 11h4.5"/>',
  // One key behind another: a press that counts twice.
  double:
    '<rect x="3" y="9" width="12" height="12" rx="2"/>' +
    '<path d="M9 9V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-4"/>',
  // A coil between two plates.
  spring: '<path d="M6 4h12M6 20h12M12 4v2l4 1.5-8 3 8 3-8 3 4 1.5v2"/>',
  // The wire under a spacebar that keeps it level.
  stabiliser: '<rect x="2.5" y="5" width="19" height="7" rx="2"/><path d="M6 12v5.5h12V12"/>',
  // Two waves in phase.
  sync: '<path d="M3 9q3-4 6 0t6 0 6 0M3 15q3-4 6 0t6 0 6 0"/>',
  // A person at the bench.
  assistant:
    '<circle cx="12" cy="7.5" r="3.5"/><path d="M5 20.5c0-3.9 3.1-6.5 7-6.5s7 2.6 7 6.5"/>',
  // A piston above a key.
  pneumatic:
    '<rect x="8" y="3" width="8" height="6" rx="1.5"/>' +
    '<path d="M12 9v4M8.5 13h7"/>' +
    '<rect x="5" y="15.5" width="14" height="5" rx="1.5"/>',
  // Base, two segments, one joint, a claw.
  arm:
    '<rect x="4" y="18" width="8" height="3" rx="1"/>' +
    '<circle cx="10" cy="10" r="2"/>' +
    '<path d="M8 18l1.5-6.05M11.8 9.1L17 6.5M17 6.5l3-2M17 6.5l3.5 1.5"/>',
  // A keyboard with a dashed copy of itself: several states at once.
  quantum:
    '<path stroke-dasharray="2 2.5" d="M5 8V6a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-1"/>' +
    '<rect x="2" y="8" width="17" height="12" rx="2"/>' +
    '<path d="M5.5 12h.01M8.5 12h.01M11.5 12h.01M14.5 12h.01M7 16h7"/>',
  // Orbits around a nucleus.
  collider:
    '<ellipse cx="12" cy="12" rx="9.5" ry="3.75"/>' +
    '<ellipse cx="12" cy="12" rx="9.5" ry="3.75" transform="rotate(60 12 12)"/>' +
    '<ellipse cx="12" cy="12" rx="9.5" ry="3.75" transform="rotate(120 12 12)"/>' +
    '<circle cx="12" cy="12" r="1.25" fill="currentColor" stroke="none"/>',
};
---

<svg
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={GLYPHS[Astro.props.id]}
/>
