          ></span>
        </p>
        <div class="modal-actions">
          <button class="btn btn-primary" id="sc-away-collect" type="button">Collect</button>
        </div>
      </div>
    </div>

    <!-- Buying a perk that needs room: with all five slots full the player
         picks one to drop, and a second keystone asks before it swaps out the
         first. The script fills it for the offer at hand. -->
    <div
      class="modal-overlay"
      id="sc-swap-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sc-swap-title"
      aria-describedby="sc-swap-message"
      hidden
    >
      <div class="modal swap-modal">
        <h3 class="modal-title" id="sc-swap-title">Make room</h3>
        <div class="swap-incoming" id="sc-swap-incoming"></div>
        <p class="modal-message swap-message" id="sc-swap-message"></p>
        <ul class="swap-list" id="sc-swap-list"></ul>
        <div class="modal-actions">
          <button class="btn btn-secondary" id="sc-swap-cancel" type="button">Keep my perks</button>
          <button class="btn btn-primary" id="sc-swap-confirm" type="button" hidden>Swap</button>
        </div>
      </div>
    </div>

    <!-- Every perk's glyph, for the script to clone into offers and dialogs. -->
    <template id="sc-perk-glyphs">
      {PERKS.map((p) => <PerkIcon id={p.id} />)}
    </template>
  </section>

  <Content />

  <RelatedTools current="/spacebar-clicker" />
</BaseLayout>

