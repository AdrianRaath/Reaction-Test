          role="tabpanel"
          aria-labelledby="sc-tab-prestige"
          hidden
        >
          <!-- What a reset costs and pays, then where this run stands: the
               isotopes held, what a reset gives now, and a meter to the next
               isotope. The script writes the sentences with numbers in them. -->
          <div class="prestige">
            <p class="prestige-copy">
              Resetting the experiment starts the run over. Isotopes carry across: each one adds 10%
              to every gain, on every run after.
            </p>
            <dl class="prestige-terms">
              <div>
                <dt>Wiped</dt>
                <dd>
                  Energy, upgrades, auto-tappers, the reactor's state, and this run's perks and
                  offers.
                </dd>
              </div>
              <div>
                <dt>Kept</dt>
                <dd>
                  Isotopes, achievements, records and all-time stats, the perk codex, and every
                  auto-tapper the shop has shown you.
                </dd>
              </div>
            </dl>
            <div class="prestige-status">
              <p class="prestige-held" id="sc-prestige-held">No isotopes yet.</p>
              <p class="prestige-now" id="sc-prestige-now">
                Resetting unlocks at {whole(PRESTIGE_UNLOCK)} energy earned this run.
              </p>
              <div class="isotope-meter">
                <div class="isotope-meter-track" aria-hidden="true">
                  <div class="isotope-meter-fill" id="sc-isotope-meter"></div>
                </div>
                <p class="isotope-meter-label" id="sc-prestige-progress"></p>
              </div>
              <button type="button" class="btn btn-primary" id="sc-prestige-btn" hidden
                >Reset the experiment</button
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <ResetModal
      message="your energy, upgrades, auto-tappers, isotopes, achievements and stats. Sound settings stay"
    />

    <!-- Prestige confirm (spec §9: the player must confirm). -->
    <div
      class="modal-overlay"
      id="sc-prestige-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sc-prestige-modal-title"
      hidden
    >
      <div class="modal">
        <h3 class="modal-title" id="sc-prestige-modal-title">Reset the experiment?</h3>
        <!-- The script writes this, with the isotopes and the bonus before and after. -->
        <p class="modal-message" id="sc-prestige-modal-message"></p>
        <div class="modal-actions">
          <button class="btn btn-secondary" id="sc-prestige-cancel" type="button">Keep going</button
          >
          <button class="btn btn-primary" id="sc-prestige-confirm" type="button"
            >Reset and collect</button
          >
        </div>
      </div>
    </div>

    <!-- Offline progress (spec §7). -->
    <div
      class="modal-overlay"
      id="sc-away-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sc-away-title"
      hidden
    >
      <div class="modal">
        <h3 class="modal-title" id="sc-away-title">While you were away</h3>
        <p class="modal-message">
