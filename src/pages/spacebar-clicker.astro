  .arc-track {
    stroke: var(--line);
  }

  .arc-fill {
    stroke: var(--dial);
    stroke-linecap: round;
    transition: stroke-dashoffset var(--duration-base) linear;
  }

  /* Stage reached: the arc snaps full and holds, then sweeps back to the
     start of the new stage. */
  .arc-fill.is-complete {
    transition-duration: 180ms;
  }

  .arc-fill.is-sweeping {
    transition: stroke-dashoffset 800ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .led-dot,
  .led-halo {
    stroke: none;
  }

  .led-dot {
    fill: var(--ink-disabled);
