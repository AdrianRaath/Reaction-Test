                 An empty socket keeps its rarity's shape, so there is
                 something to hunt. Then a card for each perk found. -->
            <div class="codex-board">
              <p class="codex-label" id="sc-codex-press-label">Upgrades</p>
              <ul class="codex-row" id="sc-codex-press" aria-labelledby="sc-codex-press-label"></ul>
              <p class="codex-label" id="sc-codex-auto-label">Auto-tappers</p>
              <ul class="codex-row" id="sc-codex-auto" aria-labelledby="sc-codex-auto-label"></ul>
            </div>
            <ul class="perk-cards" id="sc-codex"></ul>
          </section>
        </div>

