---
import { getEntry, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import PerkIcon from '../components/games/PerkIcon.astro';
import ShopIcon from '../components/games/ShopIcon.astro';
import RelatedTools from '../components/tool/RelatedTools.astro';
import ResetModal from '../components/tool/ResetModal.astro';
import {
  ACHIEVEMENTS,
  AUTO_TAPPERS,
  ISOTOPE_TRACK,
  PERK_SLOTS,
  PERKS,
  PRESS_UPGRADES,
  PRESTIGE_UNLOCK,
  REACTOR_STATES,
  RESTART_PRESSES,
  TRACK_EFFECT,
} from '../games/spacebar-clicker/config';
import { formatEnergy } from '../games/spacebar-clicker/format';
import '../styles/content.css';
import '../styles/instrument.css';

// A game page, not a tool page: it is in the registry (sidebar, cross-links,
// sitemap) with `telemetry: false`, so no rig and no top-bar readout. The game
// keeps its own save and its own HUD. See src/scripts/spacebar-clicker.ts.

// Authored for the primary keyword "spacebar clicker". No "| ReflexLab" suffix.
const TITLE = 'Spacebar Clicker - Free Online Idle Spacebar Game';
const DESCRIPTION =
  'Play Spacebar Clicker free. Every press charges the reactor, upgrades and auto-tappers do the rest, and a steady rhythm earns up to 3x. No ads, saves in your browser.';

const entry = await getEntry('tools', 'spacebar-clicker');
if (!entry) throw new Error('Missing tools/spacebar-clicker content entry');
const { Content } = await render(entry);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entry.data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const whole = (v: number) => v.toLocaleString('en-US');

// The dial around the core, in its SVG's 100-unit box. The progress arc sits
// just outside the core; beyond it, one indicator light per reactor state past
// Dormant, spaced evenly clockwise from the top (the SVG is turned -90deg, so
// angle 0 is twelve o'clock). The script reads the arc length from the circle.
const ARC_R = 41;
const ARC_LEN = Number((2 * Math.PI * ARC_R).toFixed(2));
const LED_R = 45.5;
// The core's bezel: a dashed ring the script turns at a speed tied to energy
// per second. The dash period divides the circumference exactly, so the ring
// has no seam where the dashes meet.
const BEZEL_R = 49.5;
const BEZEL_SEGMENTS = 60;
const bezelPeriod = (2 * Math.PI * BEZEL_R) / BEZEL_SEGMENTS;
const BEZEL_DASH = `${(bezelPeriod * 0.4).toFixed(3)} ${(bezelPeriod * 0.6).toFixed(3)}`;

// Motes orbiting inside the core, more of them at each stage (CSS hides the
// rest). Spread by a fixed formula rather than Math.random, so the build is
// stable: radius as a fraction of the core, period, start angle, direction.
const MOTES = Array.from({ length: 12 }, (_, i) => ({
  rf: (0.2 + ((i * 7) % 12) * 0.022).toFixed(3),
  dur: `${(7 + ((i * 5) % 9) * 0.9).toFixed(1)}s`,
  start: `${(i * 137.5) % 360}deg`,
  size: `${i % 3 === 0 ? 3 : 2}px`,
  dir: i % 4 === 3 ? 'reverse' : 'normal',
}));

// The restart's marks (SPACEBAR-CLICKER.md §8.5): RESTART_PRESSES segments on
// the arc's own circle, clockwise from twelve o'clock with a small gap
// between each, out of a path length of 100.
const RESTART_STEP = 100 / RESTART_PRESSES;
const RESTART_GAP = 1.6;
const RESTART_DASH = `${RESTART_STEP - RESTART_GAP} ${100 - RESTART_STEP + RESTART_GAP}`;
const restartMarks = Array.from({ length: RESTART_PRESSES }, (_, i) =>
  (-(i * RESTART_STEP + RESTART_GAP / 2)).toFixed(2)
);

const dialLeds = REACTOR_STATES.slice(1).map((s, i, all) => {
  const angle = (i / all.length) * 2 * Math.PI;
  return {
    id: s.id,
    x: Number((50 + LED_R * Math.cos(angle)).toFixed(2)),
    y: Number((50 + LED_R * Math.sin(angle)).toFixed(2)),
  };
});

// A perk offer's window, drawn as a ring around its 36px glyph tile. It runs
// clockwise from twelve o'clock, so as the window drains the ring retreats to
// the top, like a clock running down. The script sets its dash offset out of
// a path length of 100.
const RING = 'M18 1H28A7 7 0 0 1 35 8V28A7 7 0 0 1 28 35H8A7 7 0 0 1 1 28V8A7 7 0 0 1 8 1Z';

// The perk shelf has a socket for every slot a run can have: five, and a
// sixth with the Sixth Slot rung. The script hides the ones a run lacks.
const MAX_SLOTS = Math.max(PERK_SLOTS, TRACK_EFFECT.sixthSlotSlots);
---

<BaseLayout
  title={TITLE}
  description={DESCRIPTION}
  path="/spacebar-clicker"
  topbarLabel="Spacebar Clicker"
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <button slot="controls" type="button" class="ctl" id="sound-toggle" aria-label="Toggle sound">
    <span class="ctl-icon" id="sound-icon-on">
      <Icon name="ph:speaker-high" width={18} height={18} aria-hidden="true" />
    </span>
    <span class="ctl-icon" id="sound-icon-off" hidden>
      <Icon name="ph:speaker-slash" width={18} height={18} aria-hidden="true" />
    </span>
  </button>
  <button slot="controls" type="button" class="ctl" id="reset-btn" aria-label="Reset all progress">
    <Icon name="ph:trash" width={18} height={18} aria-hidden="true" />
    <span>Reset</span>
  </button>

  <!-- ========== HERO ========== -->
  <section class="hero-section">
    <div class="hero-content">
      <h1 class="hero-title">Spacebar Clicker</h1>
      <p class="hero-subtitle">
        Press space to feed the reactor. Buy upgrades, hire auto-tappers, and hold a steady rhythm
        for up to 3x energy. Your progress saves in this browser.
      </p>
    </div>
  </section>

  <!-- ========== GAME ========== -->
  <section id="game-section" class="game-section">
    <div class="game-card">
      <div class="game-grid">
        <!-- The reactor face, with the isotope and perk shelves over its top corners. -->
        <div class="reactor-wrap" id="sc-reactor-wrap">
          <!-- The reactor face: the instrument the whole game is played on. -->
          <div
            id="sc-reactor"
            class="test-area reactor-face"
            data-state="dormant"
            tabindex="0"
            role="button"
            aria-label="Reactor. Press the spacebar, or tap here, to generate energy."
          >
            <!-- Stage change: the graticule lights in a band travelling out from the core. -->
            <div class="grid-wash" id="sc-wash" aria-hidden="true"></div>

            <div class="energy-block">
              <p class="energy-row">
                <span class="energy-value readout" id="sc-energy">0</span>
                <span class="energy-unit">energy</span>
              </p>
              <p class="energy-rates">
                <span><span class="readout" id="sc-eps">0.0</span> per second</span>
                <span><span class="readout" id="sc-epp">1</span> per press</span>
              </p>
              <!-- Where the energy comes from (§8.5.10): the player's presses,
                 surges and what their combo adds to the auto-tappers, against
                 the auto-tappers alone, over the last few seconds. It shows
                 once the run has auto-tappers; its row is always there, so
                 nothing moves when it does. -->
              <p class="share" id="sc-share">
                <span class="share-side"
                  >You <span class="readout share-pct" id="sc-share-you">100%</span></span
                >
                <span class="share-bar" aria-hidden="true"
                  ><span class="share-fill" id="sc-share-fill"></span></span
                >
                <span class="share-side share-side-end"
                  ><span class="readout share-pct" id="sc-share-machines">0%</span>{' '}<span
                    class="word-long">auto-tappers</span
                  ><span class="word-short">auto</span></span
                >
              </p>
            </div>

            <div class="core-wrap">
              <!-- The dial: progress to the next state as an arc, and one light per
                 state reached, so the run's history reads at a glance. -->
              <svg class="core-arc" viewBox="0 0 100 100" aria-hidden="true">
                <g class="dial-arc">
                  <circle class="arc-track" cx="50" cy="50" r={ARC_R}></circle>
                  <circle
                    class="arc-fill"
                    id="sc-arc"
                    cx="50"
                    cy="50"
                    r={ARC_R}
                    stroke-dasharray={ARC_LEN}
                    stroke-dashoffset={ARC_LEN}></circle>
                </g>
                {
                  dialLeds.map((led) => (
                    <g class={`dial-led led-${led.id}`} data-led={led.id}>
                      <circle class="led-halo" cx={led.x} cy={led.y} r="3.4" />
                      <circle class="led-dot" cx={led.x} cy={led.y} r="1.5" />
                    </g>
                  ))
                }
              </svg>
              <!-- A faulted reactor: the dial's arc gives way to the restart's marks
                 on the same circle, one lit for each press on the beat. Its own
                 layer, so the grey of the fault never reaches it. -->
              <svg
                class="restart-ring"
                id="sc-restart-ring"
                viewBox="0 0 100 100"
                aria-hidden="true"
              >
                {
                  restartMarks.map((offset) => (
                    <circle
                      class="restart-mark"
                      cx="50"
                      cy="50"
                      r={ARC_R}
                      pathLength="100"
                      stroke-dasharray={RESTART_DASH}
                      stroke-dashoffset={offset}
                    />
                  ))
                }
              </svg>
              <span class="shockwave" id="sc-shockwave" aria-hidden="true"></span>
              <div class="core" id="sc-core" data-state="dormant" aria-hidden="true">
                <svg class="core-bezel" id="sc-bezel" viewBox="0 0 100 100" aria-hidden="true">
                  <circle cx="50" cy="50" r={BEZEL_R} stroke-dasharray={BEZEL_DASH}></circle>
                </svg>
                <span class="core-ring core-ring-inner"></span>
                <span class="motes" aria-hidden="true">
                  {
                    MOTES.map((m) => (
                      <span
                        class="mote"
                        style={`--rf:${m.rf};--dur:${m.dur};--start:${m.start};--size:${m.size};--dir:${m.dir}`}
                      />
                    ))
                  }
                </span>
                <span class="core-heart"></span>
                <!-- Surge (spec §5): the countdown, then the live rate, read from the core. -->
                <span class="core-readout">
                  <span class="core-num readout" id="sc-core-num"></span>
                  <span class="core-unit" id="sc-core-unit"></span>
                </span>
              </div>
              <div class="sparks" id="sc-sparks" aria-hidden="true"></div>
              <div class="floats" id="sc-floats" aria-hidden="true"></div>

              <!-- Surge results, laid over the core for a few seconds. The numbers
                 tally up; screen readers get the totals from the announcer. -->
              <div class="surge-card" id="sc-surge-summary" aria-hidden="true" hidden>
                <p class="surge-card-title">Surge over</p>
                <dl class="surge-stats">
                  <div><dt>Presses</dt><dd class="readout" id="sc-surge-presses">0</dd></div>
                  <div><dt>Per second</dt><dd class="readout" id="sc-surge-rate">0.0</dd></div>
                  <div><dt>Energy</dt><dd class="readout" id="sc-surge-earned">0</dd></div>
                </dl>
                <p class="surge-best" id="sc-surge-best" hidden>
                  <span aria-hidden="true">🏆</span> New best surge
                </p>
                <!-- A surge is a boss fight: now and then it drops a perk. -->
                <p class="surge-drop" id="sc-surge-drop" hidden>
                  <span id="sc-surge-drop-kind">Perk drop</span>:{' '}
                  <span class="surge-drop-name" id="sc-surge-drop-name"></span>
                </p>
                <!-- Capacitor's extra second, credited with what it brought in. -->
                <p class="surge-credit" id="sc-surge-credit" hidden></p>
              </div>

              <!-- After a reset that reaches new rungs of the isotope track, a
                 card over the core names them once the beads land. Screen
                 readers hear them from the announcer. -->
              <div class="unlock-card" id="sc-unlock-card" aria-hidden="true" hidden>
                <p class="unlock-card-title">Unlocked</p>
                <ul class="unlock-list" id="sc-unlock-list"></ul>
                <p class="unlock-more" id="sc-unlock-more" hidden></p>
              </div>
            </div>

            <p class="state-label" id="sc-state-label">
              <span class="state-name" id="sc-state">Dormant</span>
              <span class="state-noun">reactor</span>
            </p>
            <p class="surge-label" id="sc-surge-label" hidden>Surge incoming</p>
            <!-- Left alone, the reactor runs down, then faults (§8.5): this stands
               in for the state label, with the output left or the restart's count. -->
            <p class="power-label" id="sc-power-label" hidden>
              <span class="power-name" id="sc-power-name">Running down</span>
              <span class="power-detail" id="sc-power-detail"></span>
            </p>

            <div class="combo" id="sc-combo-meter">
              <div class="combo-row">
                <span class="combo-count readout" id="sc-combo">0</span>
                <span class="combo-tier" id="sc-combo-tier">combo</span>
                <span class="combo-next" id="sc-combo-next">10 to Steady</span>
                <!-- The tier's multiplier on presses and, once Synchronisation
                   shares it (§8.5.10), on the auto-tappers, under it. -->
                <span class="combo-mults">
                  <span class="combo-mult readout" id="sc-combo-mult">x1</span>
                  <span class="combo-sync" id="sc-combo-sync">
                    <span class="combo-sync-line"
                      ><span class="word-long">auto-tappers</span><span class="word-short"
                        >auto</span
                      >{' '}<span class="readout" id="sc-combo-sync-mult">x1</span></span
                    >
                  </span>
                </span>
              </div>
              <div class="combo-track" role="presentation">
                <div class="combo-fill" id="sc-combo-fill"></div>
              </div>
              <!-- The rhythm scope: one spike per press, scrolling left. Even
                 spacing is a steady beat; off-beat presses draw half height. -->
              <canvas class="rhythm-scope" id="sc-scope" aria-hidden="true"></canvas>
            </div>

            <p class="test-hint" id="sc-hint">
              Press the spacebar to generate energy. Keep a steady beat to build a combo.
            </p>
            <p class="keycap" id="sc-keycap" aria-hidden="true">space</p>

            <div class="toast" id="sc-toast" hidden>
              <span id="sc-toast-text"></span>
            </div>

            <p class="visually-hidden" id="sc-announce" aria-live="polite"></p>
          </div>

          <!-- The isotope badge (SPACEBAR-CLICKER.md §8.5.17): the isotopes
             held as a count, a ring filling toward the next one, and beside
             it what they are and how far off the next is. A "+1" tag hangs
             from the ring once a reset is open. Before any isotope is held a
             bead waits in the ring. It shows from a first run's start, so a
             new player sees the goal. A click opens the Isotopes tab. It sits
             beside the face like the perk shelf, so a click never presses. -->
          <div class="isotope-shelf" id="sc-shelf">
            <button type="button" class="isotope-badge" id="sc-isotope-badge">
              <span class="isotope-dial" id="sc-isotope-dial">
                <svg
                  class="isotope-ring"
                  viewBox="0 0 30 30"
                  width="30"
                  height="30"
                  aria-hidden="true"
                >
                  <circle class="isotope-ring-track" cx="15" cy="15" r="13.5"></circle>
                  <circle
                    class="isotope-ring-fill"
                    id="sc-isotope-ring"
                    cx="15"
                    cy="15"
                    r="13.5"
                    pathLength="100"
                    stroke-dasharray="100"
                    stroke-dashoffset="100"></circle>
                </svg>
                <span class="isotope-count readout" id="sc-isotope-count" hidden></span>
                <span class="isotope-seed" id="sc-isotope-seed"></span>
                <span class="isotope-tag readout" id="sc-isotope-tag" hidden></span>
              </span>
              <span class="isotope-lines" aria-hidden="true">
                <span class="isotope-line-name" id="sc-isotope-name"></span>
                <span class="isotope-line-next" id="sc-isotope-progress"></span>
              </span>
            </button>
            <!-- Visual only: the badge's accessible name carries the same text. -->
            <div class="shelf-tip" id="sc-isotope-tip" aria-hidden="true" hidden>
              <div class="shelf-tip-box">
                <p class="shelf-tip-name" id="sc-isotope-tip-name"></p>
                <p class="shelf-tip-kind" id="sc-isotope-tip-kind"></p>
                <p class="shelf-tip-detail" id="sc-isotope-tip-detail"></p>
                <p class="shelf-tip-unlock" id="sc-isotope-tip-unlock" hidden></p>
              </div>
            </div>
          </div>

          <!-- The perk shelf: this run's perks, mirroring the isotopes top-left,
             with level pips and a tooltip on hover, focus or tap. It sits
             beside the face rather than inside it, so its buttons aren't
             nested in the face's role="button" and a tap on it is never a
             press. Empty sockets show how many of the run's slots are free:
             five, or six with the Sixth Slot rung. -->
          <div class="perk-shelf" id="sc-perk-shelf" hidden>
            <ul class="perk-slots" id="sc-perk-slots" aria-label="Perks this run">
              {
                Array.from({ length: MAX_SLOTS }, (_, i) => (
                  <li class="perk-slot" data-empty aria-hidden="true" hidden={i >= PERK_SLOTS}>
                    <button type="button" class="perk-chip" hidden>
                      <span class="perk-chip-glyph" />
                    </button>
                    <span class="perk-pips" aria-hidden="true">
                      <span />
                      <span />
                      <span />
                    </span>
                  </li>
                ))
              }
            </ul>
            <!-- Visual only: each chip's accessible name carries the same text. -->
            <div class="shelf-tip" id="sc-perk-tip" aria-hidden="true" hidden>
              <div class="shelf-tip-box">
                <p class="shelf-tip-name">
                  <span id="sc-perk-tip-name"></span>
                  <span class="perk-level" id="sc-perk-tip-level" hidden></span>
                </p>
                <p class="shelf-tip-kind" id="sc-perk-tip-kind"></p>
                <p class="shelf-tip-detail" id="sc-perk-tip-detail"></p>
              </div>
            </div>
          </div>
        </div>

        <!-- Shop (spec §6), rendered from the rulebook so the first paint is right. -->
        <aside class="shop" aria-labelledby="shop-heading">
          <h2 class="section-title shop-heading" id="shop-heading">Shop</h2>

          <!-- Two tabs, styled like the site's setting buttons. A closed tab that
               gains something (a newly revealed auto-tapper, or an item newly
               affordable at its current price) wears an amber "New" tag until
               it is opened (DESIGN.md, the Shop-Signal Exception). -->
          <div class="shop-tabs" role="tablist" aria-label="Shop sections">
            <button
              type="button"
              class="tab shop-tab"
              role="tab"
              id="sc-shop-tab-press"
              data-shop-tab="press"
              aria-selected="true"
              aria-controls="sc-shop-press"
            >
              Upgrades
              <span class="shop-new-tag" id="sc-new-press" hidden>
                <span aria-hidden="true">New</span>
                <span class="visually-hidden">, new items</span>
              </span>
            </button>
            <button
              type="button"
              class="tab shop-tab"
              role="tab"
              id="sc-shop-tab-auto"
              data-shop-tab="auto"
              aria-selected="false"
              aria-controls="sc-shop-auto"
              tabindex="-1"
            >
              Auto-tappers
              <span class="shop-new-tag" id="sc-new-auto" hidden>
                <span aria-hidden="true">New</span>
                <span class="visually-hidden">, new items</span>
              </span>
            </button>
          </div>

          <div
            class="shop-panel"
            id="sc-shop-press"
            role="tabpanel"
            aria-labelledby="sc-shop-tab-press"
          >
            <ul class="shop-list">
              <!-- The perk on offer here, if any (SPACEBAR-CLICKER.md §8.1). An
                   empty shell on the shop rows' own grid: the script fills it
                   when a perk drops, keeps its price, ring and notes current,
                   and hides it once bought or gone. With the Reroll rung, a
                   small button under it swaps the offer, once a run. The
                   Auto-tappers tab has the same row. -->
              <li class="perk-offer" id="sc-offer-press" hidden>
                <button type="button" class="shop-buy perk-buy" aria-disabled="true">
                  <span class="perk-tile">
                    <svg class="perk-ring" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                      <path class="perk-ring-track" d={RING}></path>
                      <path class="perk-ring-fill" d={RING} pathLength="100"></path>
                    </svg>
                    <span class="perk-glyph-slot" data-perk-glyph></span>
                  </span>
                  <span class="shop-text">
                    <span class="shop-name"
                      ><span data-perk-name></span>
                      <span class="perk-level" data-perk-level hidden></span></span
                    >
                    <span class="shop-detail perk-detail" data-perk-detail></span>
                    <span class="perk-note" data-perk-note hidden></span>
                    <span class="perk-credit" data-perk-credit hidden></span>
                    <span class="visually-hidden" data-perk-window></span>
                  </span>
                  <span class="shop-nums">
                    <span class="shop-cost readout" data-perk-cost></span>
                    <span class="perk-rarity" data-perk-rarity></span>
                  </span>
                </button>
                <button type="button" class="perk-reroll" data-perk-reroll hidden>
                  <Icon name="ph:arrows-clockwise" width={12} height={12} aria-hidden="true" />
                  Reroll<span class="visually-hidden"
                    >: swap this offer for a fresh drop, once a run</span
                  >
                </button>
              </li>
              {
                PRESS_UPGRADES.map((u) => (
                  <li class="shop-item" data-kind="press" data-id={u.id}>
                    <button type="button" class="shop-buy" aria-disabled="true">
                      <span class="shop-icon">
                        <ShopIcon id={u.id} />
                      </span>
                      <span class="shop-text">
                        <span class="shop-name">{u.name}</span>
                        <span class="shop-detail">{u.detail}</span>
                        {/* Until it is bought, what it would add at the player's combo (§8.5.12). */}
                        {u.id === 'sync' && <span class="shop-note" data-sync-preview hidden />}
                      </span>
                      <span class="shop-nums">
                        <span class="shop-cost readout" data-cost>
                          {whole(u.baseCost)}
                        </span>
                        <span class="shop-level readout" data-level>
                          {u.max === 1 ? '' : `0/${u.max}`}
                        </span>
                      </span>
                    </button>
                  </li>
                ))
              }
            </ul>
          </div>

          <div
            class="shop-panel"
            id="sc-shop-auto"
            role="tabpanel"
            aria-labelledby="sc-shop-tab-auto"
            hidden
          >
            <ul class="shop-list">
              <li class="perk-offer" id="sc-offer-auto" hidden>
                <button type="button" class="shop-buy perk-buy" aria-disabled="true">
                  <span class="perk-tile">
                    <svg class="perk-ring" viewBox="0 0 36 36" aria-hidden="true" focusable="false">
                      <path class="perk-ring-track" d={RING}></path>
                      <path class="perk-ring-fill" d={RING} pathLength="100"></path>
                    </svg>
                    <span class="perk-glyph-slot" data-perk-glyph></span>
                  </span>
                  <span class="shop-text">
                    <span class="shop-name"
                      ><span data-perk-name></span>
                      <span class="perk-level" data-perk-level hidden></span></span
                    >
                    <span class="shop-detail perk-detail" data-perk-detail></span>
                    <span class="perk-note" data-perk-note hidden></span>
                    <span class="perk-credit" data-perk-credit hidden></span>
                    <span class="visually-hidden" data-perk-window></span>
                  </span>
                  <span class="shop-nums">
                    <span class="shop-cost readout" data-perk-cost></span>
                    <span class="perk-rarity" data-perk-rarity></span>
                  </span>
                </button>
                <button type="button" class="perk-reroll" data-perk-reroll hidden>
                  <Icon name="ph:arrows-clockwise" width={12} height={12} aria-hidden="true" />
                  Reroll<span class="visually-hidden"
                    >: swap this offer for a fresh drop, once a run</span
                  >
                </button>
              </li>
              {
                AUTO_TAPPERS.map((t, i) => (
                  <li class="shop-item" data-kind="auto" data-id={t.id} hidden={i > 0}>
                    <button type="button" class="shop-buy" aria-disabled="true">
                      <span class="shop-icon">
                        <ShopIcon id={t.id} />
                      </span>
                      <span class="shop-text">
                        <span class="shop-name">{t.name}</span>
                        <span class="shop-detail">
                          {t.detail}. <span class="readout">{t.eps}</span> per second each.
                        </span>
                      </span>
                      <span class="shop-nums">
                        <span class="shop-cost readout" data-cost>
                          {whole(t.baseCost)}
                        </span>
                        <span class="shop-level readout">
                          <span data-owned>0</span> owned
                        </span>
                      </span>
                    </button>
                  </li>
                ))
              }
            </ul>
            <p class="shop-hint" id="sc-shop-hidden-hint">
              More auto-tappers appear as the reactor earns.
            </p>
          </div>
        </aside>
      </div>

      <!-- Stats, achievements, prestige (spec §9–11) behind tabs. -->
      <div class="panels">
        <div class="tabs" role="tablist" aria-label="Game panels">
          <button
            type="button"
            class="tab"
            role="tab"
            id="sc-tab-stats"
            data-tab="stats"
            aria-selected="true"
            aria-controls="sc-panel-stats">Stats</button
          >
          <button
            type="button"
            class="tab"
            role="tab"
            id="sc-tab-achievements"
            data-tab="achievements"
            aria-selected="false"
            aria-controls="sc-panel-achievements"
            tabindex="-1">Achievements</button
          >
          <button
            type="button"
            class="tab"
            role="tab"
            id="sc-tab-perks"
            data-tab="perks"
            aria-selected="false"
            aria-controls="sc-panel-perks"
            tabindex="-1">Perks</button
          >
          <button
            type="button"
            class="tab"
            role="tab"
            id="sc-tab-prestige"
            data-tab="prestige"
            aria-selected="false"
            aria-controls="sc-panel-prestige"
            tabindex="-1">Isotopes</button
          >
        </div>

        <div class="panel" id="sc-panel-stats" role="tabpanel" aria-labelledby="sc-tab-stats">
          <dl class="stats">
            <div><dt>Total presses</dt><dd class="readout" id="sc-stat-presses">0</dd></div>
            <div><dt>Energy this run</dt><dd class="readout" id="sc-stat-run">0</dd></div>
            <div><dt>Energy all time</dt><dd class="readout" id="sc-stat-lifetime">0</dd></div>
            <div><dt>Energy per second</dt><dd class="readout" id="sc-stat-eps">0.0</dd></div>
            <div><dt>Energy per press</dt><dd class="readout" id="sc-stat-epp">1</dd></div>
            <div><dt>Energy from you</dt><dd class="readout" id="sc-stat-share">—</dd></div>
            <div><dt>Isotopes</dt><dd class="readout" id="sc-stat-isotopes">0</dd></div>
            <div><dt>Experiments reset</dt><dd class="readout" id="sc-stat-prestiges">0</dd></div>
            <!-- The bests, together: four to a row on a desktop (§8.5.16). -->
            <div><dt>Best combo</dt><dd class="readout" id="sc-stat-best-combo">0</dd></div>
            <div>
              <dt>Best surge, per second</dt><dd class="readout" id="sc-stat-best-surge">—</dd>
            </div>
            <div><dt>Best run</dt><dd class="readout" id="sc-stat-best-run">0</dd></div>
            <div>
              <dt>Fastest million</dt><dd class="readout" id="sc-stat-fastest-million">—</dd>
            </div>
            <div><dt>Time played</dt><dd class="readout" id="sc-stat-played">0s</dd></div>
          </dl>
        </div>

        <div
          class="panel"
          id="sc-panel-achievements"
          role="tabpanel"
          aria-labelledby="sc-tab-achievements"
          hidden
        >
          <h3 class="section-title" id="sc-ach-title">
            Achievements <span class="section-count"
              ><span class="readout" id="sc-ach-count">0 of {ACHIEVEMENTS.length}</span> unlocked</span
            >
          </h3>
          <ul class="achievements">
            {
              ACHIEVEMENTS.map((a) => (
                <li class="achievement" data-id={a.id}>
                  <span class="achievement-mark" aria-hidden="true">
                    ✗
                  </span>
                  <span class="achievement-text">
                    <span class="achievement-name">{a.name}</span>
                    <span class="achievement-detail">{a.detail}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Perks in full (SPACEBAR-CLICKER.md §4.7, §8.5.17): this run's as
             cards, then the codex of every perk ever found as a board, read one
             perk at a time in the card under it. The script fills both. -->
        <div
          class="panel"
          id="sc-panel-perks"
          role="tabpanel"
          aria-labelledby="sc-tab-perks"
          hidden
        >
          <section class="perks-section" aria-labelledby="sc-perks-run-title">
            <h3 class="section-title" id="sc-perks-run-title">
              This run <span class="section-count"
                ><span class="readout" id="sc-perks-slots">0 of {PERK_SLOTS}</span> slots</span
              >
            </h3>
            <p class="panel-intro" id="sc-perks-empty">
              No perks yet. They drop into the shop as you play, and once bought they last the rest
              of the run.
            </p>
            <ul class="run-cards" id="sc-perks-run"></ul>
          </section>
          <section class="perks-section" aria-labelledby="sc-codex-title">
            <h3 class="section-title" id="sc-codex-title">
              Codex <span class="section-count"
                ><span class="readout" id="sc-codex-count">0 of {PERKS.length}</span> found</span
              >
            </h3>
            <!-- The collection at a glance: a row of sockets per shop tab, in
                 family bands, lit once found. An empty socket keeps its
                 rarity's shape, so there is something to hunt. One Tab stop;
                 arrow keys move along it. -->
            <div class="codex-board" id="sc-codex-board">
              <p class="codex-label" id="sc-codex-press-label">
                Upgrades <span class="codex-label-count readout" id="sc-codex-press-count"></span>
              </p>
              <div
                class="codex-row"
                id="sc-codex-press"
                role="group"
                aria-labelledby="sc-codex-press-label"
              >
              </div>
              <p class="codex-label" id="sc-codex-auto-label">
                Auto-tappers <span class="codex-label-count readout" id="sc-codex-auto-count"
                ></span>
              </p>
              <div
                class="codex-row"
                id="sc-codex-auto"
                role="group"
                aria-labelledby="sc-codex-auto-label"
              >
              </div>
            </div>
            <!-- Whichever socket is pointed at, focused or tapped, in full. -->
            <div class="codex-read" id="sc-codex-read">
              <p class="codex-read-empty" id="sc-codex-read-empty">
                Point at a perk to read it. The codex keeps every perk you find, through every
                reset; only the top-bar reset clears it.
              </p>
              <div class="codex-read-perk" id="sc-codex-read-perk" hidden></div>
            </div>
          </section>
        </div>

        <div
          class="panel"
          id="sc-panel-prestige"
          role="tabpanel"
          aria-labelledby="sc-tab-prestige"
          hidden
        >
          <!-- Action first, reference last (SPACEBAR-CLICKER.md §4.7, §8.5.17):
               what a reset is, then one card with where this run stands and
               the button, then the isotope track, then what a reset wipes and
               keeps. The script writes the numbers. -->
          <section class="perks-section" aria-labelledby="sc-reset-title">
            <h3 class="section-title" id="sc-reset-title">Next reset</h3>
            <!-- For a player who hasn't reset yet; the script hides it after. -->
            <p class="panel-intro" id="sc-reset-intro">
              Resetting the experiment starts the run over. Isotopes carry across: each one adds 10%
              to every gain, on every run after, and unlocks the next rung of the isotope track.
            </p>
            <!-- One card: the figures, then what the reset unlocks beside the
                 button. Until a reset opens it shows the isotopes held and the
                 way to the first; once one is open, what it pays and the gains
                 after, as the reset dialog does. -->
            <div class="reset-card">
              <dl class="reset-figures" id="sc-reset-tiles">
                <div class="reset-figure" id="sc-prestige-held-fig">
                  <dt>Isotopes held</dt>
                  <dd>
                    <span class="readout reset-figure-value" id="sc-prestige-held">0</span>
                    <span class="reset-figure-sub" id="sc-prestige-bonus"></span>
                  </dd>
                </div>
                <div class="reset-figure" id="sc-prestige-pays" hidden>
                  <dt>A reset pays</dt>
                  <dd>
                    <span class="readout reset-figure-value" id="sc-prestige-gain"></span>
                    <span class="reset-figure-sub" id="sc-prestige-to"></span>
                  </dd>
                </div>
                <div class="reset-figure" id="sc-prestige-gains" hidden>
                  <dt>All gains</dt>
                  <dd>
                    <span class="readout reset-figure-value" id="sc-prestige-after"></span>
                    <span class="reset-figure-sub" id="sc-prestige-from"></span>
                  </dd>
                </div>
                <div class="reset-figure reset-figure-meter">
                  <dt id="sc-prestige-next">Reset opens at {formatEnergy(PRESTIGE_UNLOCK)}</dt>
                  <dd>
                    <div class="reset-figure-bar" aria-hidden="true">
                      <div class="isotope-meter-track">
                        <div class="isotope-meter-fill" id="sc-isotope-meter"></div>
                      </div>
                    </div>
                    <span class="reset-figure-sub" id="sc-prestige-progress"></span>
                  </dd>
                </div>
              </dl>
              <div class="reset-card-foot" id="sc-reset-action">
                <p class="reset-unlocks" id="sc-reset-unlocks" hidden></p>
                <button type="button" class="btn btn-primary" id="sc-prestige-btn" hidden
                  >Reset the experiment</button
                >
              </div>
            </div>
          </section>

          <!-- The isotope track (SPACEBAR-CLICKER.md §8.3, §8.5.17): a card per
               rung in rows of three, as the track runs, every third a fork.
               Held rungs are lit, the next two named with a blue rim, the
               rest dashed with only their number. The script builds them. -->
          <section class="perks-section track" aria-labelledby="sc-track-title">
            <h3 class="section-title" id="sc-track-title">
              Isotope track <span class="section-count"
                ><span class="readout" id="sc-track-count">0 of {ISOTOPE_TRACK.length}</span> unlocked</span
              >
            </h3>
            <p class="panel-intro">
              Each isotope you hold unlocks a rung for good. A fork is a choice of two: you pick
              when a reset first reaches it, and can switch at any reset after.
            </p>
            <ol class="track-grid" id="sc-track" aria-labelledby="sc-track-title"></ol>
          </section>

          <!-- The reference: the same every visit, so it comes last, in two
               lines as in the reset dialog, which names them again before
               anything happens. -->
          <section class="perks-section" aria-labelledby="sc-reset-about-title">
            <h3 class="section-title" id="sc-reset-about-title">What a reset does</h3>
            <dl class="reset-terms prestige-terms">
              <div>
                <dt>Wiped</dt>
                <dd>
                  Energy, upgrades and auto-tappers, the reactor's state, and this run's perks and
                  offers
                </dd>
              </div>
              <div>
                <dt>Kept</dt>
                <dd>
                  Isotopes and the track's unlocks, achievements, records and all-time stats, the
                  perk codex, and every auto-tapper the shop has shown you
                </dd>
              </div>
            </dl>
          </section>
        </div>
      </div>
    </div>

    <ResetModal
      message="your energy, upgrades, auto-tappers, isotopes, achievements and stats. Sound settings stay"
    />

    <!-- Prestige confirm (spec §9: the player must confirm). -->
    <div
      class="modal-overlay"
      id="sc-prestige-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sc-prestige-modal-title"
      hidden
    >
      <!-- The body scrolls on a short screen; the buttons stay pinned under
           it (SPACEBAR-CLICKER.md §8.5.17). -->
      <div class="modal reset-dialog">
        <div class="reset-body" id="sc-reset-body">
          <h3 class="modal-title" id="sc-prestige-modal-title">Reset the experiment?</h3>
          <!-- What the reset pays, as tiles like the Isotopes tab's. The script
               writes the numbers. -->
          <dl class="reset-sum">
            <div class="reset-tile">
              <dt>A reset pays</dt>
              <dd>
                <span class="readout reset-tile-value" id="sc-reset-sum-gain"></span>
                <span class="reset-tile-sub" id="sc-reset-sum-to"></span>
              </dd>
            </div>
            <div class="reset-tile">
              <dt>All gains</dt>
              <dd>
                <span class="readout reset-tile-value" id="sc-reset-sum-bonus"></span>
                <span class="reset-tile-sub" id="sc-reset-sum-from"></span>
              </dd>
            </div>
          </dl>
          <dl class="reset-terms">
            <div>
              <dt>Wiped</dt>
              <dd>Energy, upgrades, auto-tappers, reactor state and this run's perks</dd>
            </div>
            <div>
              <dt>Kept</dt>
              <dd>Isotopes, achievements, records and the perk codex</dd>
            </div>
            <div id="sc-reset-head-row">
              <dt>Head start</dt>
              <dd id="sc-reset-head"></dd>
            </div>
          </dl>
          <!-- The isotope track's part, filled by the script: the rungs this
               reset unlocks, a new fork's pick, the perk Heirloom or
               Cornerstone carries, then the forks picked before as switches.
               A new fork must be picked to reset. -->
          <div class="reset-choices" id="sc-reset-choices"></div>
        </div>
        <div class="reset-foot">
          <p class="reset-pick-hint" id="sc-reset-pick-hint" role="alert" hidden></p>
          <div class="modal-actions">
            <button class="btn btn-secondary" id="sc-prestige-cancel" type="button"
              >Keep going</button
            >
            <button class="btn btn-primary" id="sc-prestige-confirm" type="button"
              >Reset and collect</button
            >
          </div>
        </div>
      </div>
      <!-- A past pick's tooltip, on hover or keyboard focus: what the rung does.
           Visual only; each switch's radio is described by the same words. -->
      <div class="pick-tip" id="sc-pick-tip" aria-hidden="true" hidden>
        <div class="pick-tip-box">
          <p class="pick-tip-name" id="sc-pick-tip-name"></p>
          <p class="pick-tip-detail" id="sc-pick-tip-detail"></p>
        </div>
      </div>
    </div>

    <!-- Buying a perk that needs room: with all five slots full the player
         picks one to drop, and a second keystone asks before it swaps out the
         first. The script fills it for the offer at hand. -->
    <div
      class="modal-overlay"
      id="sc-swap-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sc-swap-title"
      aria-describedby="sc-swap-message"
      hidden
    >
      <div class="modal swap-modal">
        <h3 class="modal-title" id="sc-swap-title">Make room</h3>
        <div class="swap-incoming" id="sc-swap-incoming"></div>
        <p class="modal-message swap-message" id="sc-swap-message"></p>
        <ul class="swap-list" id="sc-swap-list"></ul>
        <div class="modal-actions">
          <button class="btn btn-secondary" id="sc-swap-cancel" type="button">Keep my perks</button>
          <button class="btn btn-primary" id="sc-swap-confirm" type="button" hidden>Swap</button>
        </div>
      </div>
    </div>

    <!-- Every perk's glyph, for the script to clone into offers and dialogs. -->
    <template id="sc-perk-glyphs">
      {PERKS.map((p) => <PerkIcon id={p.id} />)}
    </template>
  </section>

  <Content />

  <RelatedTools current="/spacebar-clicker" />
</BaseLayout>

<script>
  import '../scripts/spacebar-clicker';
</script>

<style>
  /* --- Top-bar controls (slot content, styled by the page) ---------------- */

  .ctl {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    color: var(--ink-secondary);
    font-size: var(--text-label-size);
  }

  .ctl:hover {
    background-color: var(--panel-hover);
    color: var(--ink-primary);
  }

  .ctl.muted {
    color: var(--ink-muted);
  }

  .ctl-icon {
    display: inline-flex;
  }

  /* --- Hero ----------------------------------------------------------------- */

  .hero-section {
    padding: var(--space-xl) 0 var(--space-md);
    text-align: center;
  }

  .hero-content {
    max-width: 620px;
    margin-inline: auto;
  }

  .hero-title {
    margin-block-end: var(--space-md);
    font-size: var(--text-display-size);
    font-weight: var(--text-display-weight);
    line-height: var(--text-display-lh);
    letter-spacing: var(--text-display-ls);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--ink-secondary);
  }

  /* --- Game card --------------------------------------------------------------- */

  .game-section {
    /* The Reactor-Ramp (DESIGN.md), here rather than on the face because
       isotopes wear Blue-White on Cherenkov Blue off the face too: the
       shelf beside it and the Isotopes tab. */
    --ramp-green: #22c55e;
    --ramp-teal: #2dd4bf;
    --ramp-cyan: #22d3ee;
    --ramp-blue: #38bdf8;
    --ramp-white: #e0f2fe;

    /* Surge Gold (DESIGN.md): the reactor in overdrive. Lighter than Caution
       Amber, so it never reads as the shop's "New" tag. */
    --gold: #fcd34d;
    --gold-deep: #fbbf24;
    --gold-ink: #fef3c7;

    /* The Perk-Family Exception (DESIGN.md): a perk wears its family's hue,
       so the build reads at a glance. Surge perks take Surge Gold, since gold
       already means a surge here. Each hue clears every reserved color and
       the others by at least ΔE 13, and the perk's name always goes with it. */
    --perk-rhythm: #a78bfa;
    --perk-press: #fb7185;
    --perk-luck: #e879f9;
    --perk-surge: var(--gold);
    --perk-machines: #a3e635;
    --perk: var(--ink-primary);

    /* One card (SPACEBAR-CLICKER.md §8.5.18): every surface that holds a
       thing, a shop row, a stat, an achievement, a perk, a rung, is Panel 03
       inside a Line Subtle hairline at Radius md. The Next reset card is the
       one large card: Radius lg and wider padding. Small glyph tiles under
       36px take Radius sm. */
    --card-bg: var(--panel-03);
    --card-line: var(--line-subtle);
    --card-radius: var(--radius-md);
    --card-pad: var(--space-sm) var(--space-md);
    --tile-radius-sm: var(--radius-sm);

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    padding-block: var(--space-md) var(--space-2xl);
  }

  /* Whatever carries a perk's family, a shop row, a dialog card, a float or
     a toast, sets --perk for everything inside it. */
  .game-section :global([data-family='rhythm']) {
    --perk: var(--perk-rhythm);
  }
  .game-section :global([data-family='press']) {
    --perk: var(--perk-press);
  }
  .game-section :global([data-family='luck']) {
    --perk: var(--perk-luck);
  }
  .game-section :global([data-family='surge']) {
    --perk: var(--perk-surge);
  }
  .game-section :global([data-family='machines']) {
    --perk: var(--perk-machines);
  }
  /* Not a perk: a rung of the isotope track credited where it acts, in the
     isotopes' blue (the Reactor-Ramp Exception), such as Night Lab's toast. */
  .game-section :global([data-family='track']) {
    --perk: var(--ramp-blue);
  }

  .game-card {
    display: flex;
    width: 100%;
    max-width: 960px;
    flex-direction: column;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--line);
    border-radius: var(--radius-2xl);
    background-color: var(--panel-02);
  }

  /* Stretch, so the shop column is pinned to the reactor's height and the two
     read as one instrument; the shop scrolls inside itself if it must. */
  .game-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--space-lg);
    align-items: stretch;
  }

  /* The face and the two shelves over its top corners. A container of its
     own, so the shelves can answer to the face's width. */
  .reactor-wrap {
    container: reactor-wrap / inline-size;
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .reactor-wrap > .reactor-face {
    flex: 1;
  }

  /* --- Reactor face ------------------------------------------------------------- */

  /* State is carried by custom properties set per data-state, so the core,
     dial, lights, gains and stage name all read one source.

     The Reactor-Ramp Exception (DESIGN.md): the reactor climbs a closed
     five-step ramp grounded in Cherenkov glow, the blue light of a working
     water-cooled reactor. Green, teal, cyan, Cherenkov blue, then blue-white
     at Supercritical. No red, no amber; every color change is paired with the
     stage name. Nothing flickers.

     The color properties are registered, so a stage change fades between
     colors rather than swapping. Without @property support they simply swap. */
  .reactor-face {
    container: reactor / inline-size;

    --stage: var(--ramp-green);
    /* The dial follows the stage, except while a surge counts down. */
    --dial: var(--stage);
    --halo: var(--ramp-green);
    --core-heart: color-mix(in srgb, var(--ramp-green) 45%, transparent);
    --core-alpha: 14%;
    --core-glow: 0px;
    --core-pulse: 0s;
    --stage-fade:
      --stage 800ms ease, --halo 800ms ease, --core-heart 800ms ease, --core-alpha 800ms ease,
      --core-glow 800ms ease;

    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 0.625rem;
    /* The face's padding, and where the energy readout must start to clear
       the perk shelf: its 47px plus a gap, from inside the 2px border. */
    --face-pad: var(--space-lg);
    --shelf-clear: 54px;

    min-height: 520px;
    padding: var(--face-pad);
    border: 2px solid var(--line);
    border-radius: var(--radius-xl);
    background-color: var(--panel-03);
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    cursor: pointer;
    transition:
      border-color var(--duration-base) var(--ease),
      box-shadow var(--duration-base) var(--ease),
      var(--stage-fade);
  }

  /* On first paint the saved stage applies without fading up from Dormant. */
  .reactor-face.is-booting,
  .reactor-face.is-booting
    :is(
      .combo-sync,
      .energy-block,
      .energy-rates,
      .share,
      .core-wrap,
      .combo,
      .test-hint,
      .keycap
    ) {
    transition: none;
  }

  .reactor-face:focus-visible {
    outline: 2px solid var(--signal-green);
    outline-offset: 3px;
  }

  .reactor-face[data-state='warming'] {
    --core-alpha: 26%;
    --core-glow: 14px;
    --core-pulse: 3.2s;
  }
  .reactor-face[data-state='stable'] {
    --core-alpha: 40%;
    --core-glow: 22px;
    --core-pulse: 2.4s;
  }
  .reactor-face[data-state='charged'] {
    --stage: var(--ramp-teal);
    --halo: var(--ramp-teal);
    --core-heart: rgb(153 246 228 / 85%);
    --core-alpha: 55%;
    --core-glow: 30px;
    --core-pulse: 1.8s;
  }
  .reactor-face[data-state='unstable'] {
    --stage: var(--ramp-cyan);
    --halo: var(--ramp-cyan);
    --core-heart: rgb(165 243 252 / 90%);
    --core-alpha: 70%;
    --core-glow: 40px;
    --core-pulse: 1.3s;
  }
  .reactor-face[data-state='critical'] {
    --stage: var(--ramp-blue);
    --halo: var(--ramp-blue);
    --core-heart: rgb(186 230 253 / 95%);
    --core-alpha: 85%;
    --core-glow: 52px;
    --core-pulse: 0.95s;
  }
  /* Supercritical: a blue-white core inside a Cherenkov-blue halo. */
  .reactor-face[data-state='supercritical'] {
    --stage: var(--ramp-white);
    --halo: var(--ramp-blue);
    --core-heart: var(--ink-primary);
    --core-alpha: 100%;
    --core-glow: 68px;
    --core-pulse: 0.75s;
  }

  /* --- Surge phases (data-surge) ----------------------------------------------

     warning:  the core counts down 3, 2, 1, the dial drains in gold, and the
               border warms to gold over the three seconds.
     active:   overdrive. The core, halo, gains and dial run gold, the core
               reads the live rate, and the border glows (Glow-Is-A-Signal).
     summary:  the results card; the reactor fades back to its stage color. */

  .reactor-face[data-surge='warning'] {
    --dial: var(--gold);
    border-color: color-mix(in srgb, var(--gold) 75%, transparent);
    transition:
      border-color 3s linear,
      var(--stage-fade);
  }

  .reactor-face[data-surge='active'] {
    --stage: var(--gold);
    --halo: var(--gold-deep);
    --core-heart: var(--gold-ink);
    --dial: var(--gold);
    --core-alpha: 75%;
    --core-glow: 48px;
    --core-pulse: 0.6s;
    /* Into overdrive fast; the way back uses the stage's slower fade. */
    --stage-fade:
      --stage 250ms ease, --halo 250ms ease, --core-heart 250ms ease, --core-alpha 250ms ease,
      --core-glow 250ms ease;
    border-color: var(--gold);
    box-shadow:
      0 0 20px color-mix(in srgb, var(--gold) 22%, transparent),
      0 0 40px color-mix(in srgb, var(--gold) 14%, transparent);
  }

  /* The two hottest stages are already brighter than overdrive's floor. */
  .reactor-face[data-surge='active'][data-state='critical'] {
    --core-alpha: 85%;
    --core-glow: 52px;
  }
  .reactor-face[data-surge='active'][data-state='supercritical'] {
    --core-alpha: 100%;
    --core-glow: 68px;
  }

  .energy-block {
    z-index: 1;
    width: 100%;
    text-align: center;
  }

  /* The number sits on the core's axis (SPACEBAR-CLICKER.md §8.5.18): its
     unit takes no width and hangs off its right, so the row is as wide as
     the number alone. */
  .energy-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    line-height: 0.9;
  }

  .energy-value {
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .energy-unit {
    width: 0;
    font-size: var(--text-title-size);
    color: var(--ink-secondary);
    text-indent: var(--space-sm);
    white-space: nowrap;
  }

  /* Six characters, 10,000 to 99,999, under a sixth perk socket: centred,
     the number's corner would meet the socket on a wide monospace face, so
     it steps down a size until 100K shortens it. Narrower faces already set
     the readout under the shelves. */
  @container reactor-wrap (min-width: 550px) {
    .reactor-wrap:has(.perk-slot:nth-child(6):not([hidden])) .energy-value.is-long {
      font-size: 3rem;
      /* The row keeps the height it has at 3.5rem, so the face holds still. */
      line-height: 1.05;
    }
  }

  .energy-rates {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    margin-block-start: var(--space-sm);
    font-size: var(--text-label-size);
    color: var(--ink-secondary);
  }

  /* Idle Hands at work: the per-second rate wears the machines' hue. */
  .energy-rates .readout.is-boosted {
    color: var(--perk-machines);
  }

  .energy-rates .readout {
    color: var(--ink-primary);
  }

  /* --- Where the energy comes from (SPACEBAR-CLICKER.md §8.5.10) ------------

     The player's share of the last few seconds' energy against the
     auto-tappers' own: the stage color for the player, the track's grey for
     the machines. The script eases the share, so the edge glides rather than
     jumps, and a broken combo or a stop drains it over a few seconds. The row
     is always laid out and fades in once the run has auto-tappers, so nothing
     around it moves. */
  .share {
    --share: 1;

    display: grid;
    /* Equal sides, so the bar sits on the core's axis whatever the words
       beside it; each side's text ends against the bar. */
    grid-template-columns:
      minmax(max-content, 1fr) minmax(80px, var(--share-bar, 168px))
      minmax(max-content, 1fr);
    align-items: center;
    gap: var(--space-sm);
    width: min(400px, 100%);
    margin: 4px auto 0;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--ink-muted);
    opacity: 0;
    transition: opacity 600ms var(--ease);
  }

  .share.is-shown {
    opacity: 1;
  }

  .share-side {
    text-align: end;
    white-space: nowrap;
  }

  .share-side-end {
    text-align: start;
  }

  /* Room for 100%, so the bar keeps its length as the numbers change; each
     number sits against the bar. */
  .share-pct {
    display: inline-block;
    min-width: 4ch;
    color: var(--ink-secondary);
    text-align: end;
  }

  .share-side-end .share-pct {
    text-align: start;
  }

  .share-bar {
    position: relative;
    height: 3px;
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--ink-muted) 28%, transparent);
  }

  /* Clipped rather than scaled, so its rounded end stays round. */
  .share-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background-color: var(--stage);
    clip-path: inset(0 calc((1 - var(--share)) * 100%) 0 0 round 2px);
  }

  /* Run down, the fill fades and greys with the core; a fault earns nothing,
     so the row stands down until the restart. */
  .reactor-face[data-power] .share-fill {
    opacity: calc(0.3 + 0.7 * var(--power));
    filter: saturate(calc(0.15 + 0.85 * var(--power)));
  }

  .reactor-face[data-power='fault'] .share {
    opacity: 0;
  }

  /* On a narrow face, "auto-tappers" shortens to "auto", here and on the
     combo meter. */
  .word-short {
    display: none;
  }

  @container reactor (max-width: 400px) {
    .word-long {
      display: none;
    }

    .word-short {
      display: inline;
    }
  }

  /* The core: a disc of light inside two rings. Depth is tonal; the only
     shadow is the glow, which reports state. */
  .core-wrap {
    --core-size: 168px;

    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    /* Room for the dial and its lights outside the core. */
    padding: 26px 0;
  }

  /* The dial: the arc fills toward the next state; the lights record each
     state reached this run. */
  .core-arc {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: calc(var(--core-size) + 56px);
    height: calc(var(--core-size) + 56px);
    overflow: visible;
    transform: translate(-50%, -50%) rotate(-90deg);
    pointer-events: none;
    transition:
      opacity 900ms ease,
      filter 900ms ease;
  }

  .arc-track,
  .arc-fill {
    fill: none;
    stroke-width: 2.2;
  }

  .arc-track {
    stroke: var(--line);
  }

  .arc-fill {
    stroke: var(--dial);
    stroke-linecap: round;
    transition: stroke-dashoffset var(--duration-base) linear;
  }

  /* Stage reached: the arc snaps full and holds, then sweeps back to the
     start of the new stage. */
  .arc-fill.is-complete {
    transition-duration: 180ms;
  }

  .arc-fill.is-sweeping {
    transition: stroke-dashoffset 800ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .led-dot,
  .led-halo {
    stroke: none;
  }

  .led-dot {
    fill: var(--ink-disabled);
    transition: fill 400ms var(--ease);
  }

  .led-halo {
    fill: var(--led);
    opacity: 0;
    transition:
      opacity 400ms var(--ease),
      fill 400ms var(--ease);
  }

  /* Every lit light wears the dial's color, as the arc does: the stage's,
     fading to the next stage's on a change, and gold from a surge's
     countdown until its results. Unlit ones stay grey. */
  .dial-led {
    --led: var(--dial);
  }

  .dial-led.is-lit .led-dot {
    fill: var(--led);
  }

  .dial-led.is-lit .led-halo {
    opacity: 0.3;
  }

  .dial-led.is-new {
    transform-box: fill-box;
    transform-origin: center;
    animation: led-pop 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes led-pop {
    0% {
      transform: scale(2.6);
    }
    100% {
      transform: scale(1);
    }
  }

  /* One ring of light rolling out from the core on a stage change. */
  .shockwave {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: var(--core-size);
    height: var(--core-size);
    border: 2px solid var(--stage);
    border-radius: var(--radius-full);
    box-shadow:
      0 0 24px color-mix(in srgb, var(--stage) 40%, transparent),
      inset 0 0 24px color-mix(in srgb, var(--stage) 25%, transparent);
    opacity: 0;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .shockwave.is-firing {
    animation: shockwave 1000ms cubic-bezier(0.2, 0.6, 0.3, 1);
  }

  @keyframes shockwave {
    0% {
      opacity: 0.9;
      transform: translate(-50%, -50%) scale(0.9);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(3.4);
    }
  }

  /* The graticule lit in the stage color, masked to a soft band whose radius
     travels outward. The script centres it on the core. */
  .grid-wash {
    --wash-x: 50%;
    --wash-y: 45%;

    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--stage) 45%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--stage) 45%, transparent) 1px,
        transparent 1px
      );
    background-size: 32px 32px;
    background-position: center;
    opacity: 0;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(
      circle at var(--wash-x) var(--wash-y),
      transparent calc(var(--wash-r) - 140px),
      #000 calc(var(--wash-r) - 50px),
      transparent var(--wash-r)
    );
    mask-image: radial-gradient(
      circle at var(--wash-x) var(--wash-y),
      transparent calc(var(--wash-r) - 140px),
      #000 calc(var(--wash-r) - 50px),
      transparent var(--wash-r)
    );
  }

  .grid-wash.is-washing {
    animation: grid-wash 1100ms ease-out;
  }

  @keyframes grid-wash {
    0% {
      --wash-r: 0px;
      opacity: 1;
    }
    75% {
      opacity: 0.9;
    }
    100% {
      --wash-r: 760px;
      opacity: 0;
    }
  }

  .core {
    position: relative;
    width: var(--core-size);
    height: var(--core-size);
    border-radius: var(--radius-full);
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--stage) var(--core-alpha), transparent) 0%,
      color-mix(in srgb, var(--halo) calc(var(--core-alpha) * 0.45), transparent) 42%,
      transparent 72%
    );
    box-shadow:
      0 0 var(--core-glow) color-mix(in srgb, var(--halo) 25%, transparent),
      0 0 calc(var(--core-glow) * 2) color-mix(in srgb, var(--halo) 12%, transparent);
    animation: core-breathe var(--core-pulse) ease-in-out infinite;
    transition:
      opacity 900ms ease,
      filter 900ms ease;
  }

  /* --- Bezel and motes ---------------------------------------------------------- */

  /* A dashed bezel just inside the core's edge. The script turns it, faster
     as energy per second climbs; it holds still with no auto-tappers. */
  .core-bezel {
    position: absolute;
    inset: 0;
    overflow: visible;
    pointer-events: none;
  }

  .core-bezel circle {
    fill: none;
    stroke: color-mix(in srgb, var(--stage) 35%, var(--line));
    stroke-width: 0.9;
  }

  /* Faint particles orbiting inside the core: none while Dormant, two more
     with each stage, twelve at Supercritical. */
  .motes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .mote {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    display: none;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2);
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--stage) 70%, #fff);
    box-shadow: 0 0 6px color-mix(in srgb, var(--stage) 80%, transparent);
    opacity: 0.55;
    animation: mote-orbit var(--dur) linear infinite;
    animation-direction: var(--dir);
  }

  .reactor-face[data-state='warming'] .mote:nth-child(-n + 2),
  .reactor-face[data-state='stable'] .mote:nth-child(-n + 4),
  .reactor-face[data-state='charged'] .mote:nth-child(-n + 6),
  .reactor-face[data-state='unstable'] .mote:nth-child(-n + 8),
  .reactor-face[data-state='critical'] .mote:nth-child(-n + 10),
  .reactor-face[data-state='supercritical'] .mote {
    display: block;
  }

  @keyframes mote-orbit {
    from {
      transform: rotate(var(--start)) translateX(calc(var(--core-size) * var(--rf)));
    }
    to {
      transform: rotate(calc(var(--start) + 360deg)) translateX(calc(var(--core-size) * var(--rf)));
    }
  }

  /* --- Run-down, fault and restart (SPACEBAR-CLICKER.md §8.5) ----------------

     Left alone, the reactor runs down: the core and the dial fade and lose
     their color in step with the output, --power, which the script steps from
     1 to 0. A press brings it straight back, the color returning over the
     same 0.9 s fade. At nothing it faults: a grey, still core, and the dial's
     arc gives way to the restart's marks, which light in the stage color one
     press on the beat at a time. Grey is all the run-down adds: no red, no
     amber, and nothing flickers (the Reactor-Ramp Exception). */
  .reactor-face {
    --power: 1;
  }

  .reactor-face[data-power] .core,
  .reactor-face[data-power] .core-arc {
    opacity: calc(0.3 + 0.7 * var(--power));
    filter: saturate(calc(0.15 + 0.85 * var(--power)));
  }

  /* Still: the core no longer breathes, and its motes hold where they are. */
  .reactor-face[data-power='fault'] .core {
    opacity: 0.28;
    filter: grayscale(1);
    animation: none;
  }

  .reactor-face[data-power='fault'] .mote {
    animation-play-state: paused;
  }

  .reactor-face[data-power='fault'] .core-arc {
    opacity: 0.45;
    filter: grayscale(1);
  }

  .dial-arc,
  .dial-led {
    transition: opacity 400ms ease;
  }

  /* The dial clears for the restart's marks; its arc and lights come back after. */
  .reactor-face[data-power='fault'] :is(.dial-arc, .dial-led) {
    opacity: 0;
  }

  /* The restart's marks, on the arc's own circle. Unlit, they are hairlines;
     lit, the stage color with a little of its glow. */
  .restart-ring {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: calc(var(--core-size) + 56px);
    height: calc(var(--core-size) + 56px);
    overflow: visible;
    opacity: 0;
    transform: translate(-50%, -50%) rotate(-90deg);
    pointer-events: none;
    transition: opacity 400ms ease;
  }

  .reactor-face[data-power='fault'] .restart-ring {
    opacity: 1;
  }

  .restart-mark {
    fill: none;
    stroke: var(--line);
    stroke-width: 3;
    transition:
      stroke 320ms ease,
      filter 320ms ease;
  }

  .restart-mark.is-lit {
    stroke: var(--stage);
    filter: drop-shadow(0 0 2.5px color-mix(in srgb, var(--stage) 70%, transparent));
    transition-duration: 120ms;
  }

  /* Each press on the beat: its mark lands a touch heavy, then settles. */
  .restart-mark.is-igniting {
    animation: mark-ignite 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes mark-ignite {
    0% {
      stroke-width: 6;
    }
    100% {
      stroke-width: 3;
    }
  }

  /* The tenth press: the full ring swells once and fades as the dial's arc
     and the core's color come back. */
  .restart-ring.is-complete {
    animation: restart-done 1000ms ease forwards;
  }

  .restart-ring.is-complete .restart-mark {
    stroke: var(--stage);
    animation: mark-swell 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes restart-done {
    0%,
    45% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes mark-swell {
    40% {
      stroke-width: 6;
    }
  }

  /* Reset the experiment: everything else on the face dims while the core
     collapses to a point; then it blooms back as Dormant. No flash. The
     isotope shelf sits beside the face, so it dims as a sibling. */
  .reactor-face > :is(.energy-block, .state-label, .surge-label, .combo, .test-hint, .keycap),
  .reactor-face ~ .isotope-shelf {
    transition: opacity 600ms ease;
  }

  .reactor-face.is-imploding
    > :is(.energy-block, .state-label, .surge-label, .combo, .test-hint, .keycap),
  .reactor-face.is-imploding ~ .isotope-shelf {
    opacity: 0.3;
    transition-duration: 400ms;
  }

  .reactor-face.is-imploding .core {
    animation: implode 500ms cubic-bezier(0.55, 0, 1, 0.45) forwards;
  }

  .reactor-face.is-blooming .core {
    animation: bloom 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes implode {
    0% {
      transform: scale(1);
    }
    25% {
      transform: scale(1.06);
    }
    100% {
      transform: scale(0.04);
    }
  }

  @keyframes bloom {
    0% {
      transform: scale(0.04);
    }
    100% {
      transform: scale(1);
    }
  }

  /* --- Isotope badge ---------------------------------------------------------- */

  /* Over the face's top-left corner (SPACEBAR-CLICKER.md §8.5.17): a ring with
     the isotopes held as a count, filling toward the next one, and beside it
     two lines saying what they are and how far off the next is. The button
     is padded to a large target, and the shelf pulled out by that padding,
     so the ring sits 16px in from the face's outer edge, level with the perk
     shelf. At 1440 the lines end clear of the centred energy readout, so it
     doesn't step down for them; narrower, it steps down under both shelves. */
  .isotope-shelf {
    position: absolute;
    inset-block-start: 6px;
    inset-inline-start: 8px;
    z-index: 4;
    display: flex;
    align-items: center;
  }

  .isotope-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .isotope-badge:focus-visible {
    outline: 2px solid var(--ramp-blue);
    outline-offset: -2px;
  }

  .isotope-dial {
    position: relative;
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 30px;
    height: 30px;
  }

  .isotope-ring,
  .isotope-count,
  .isotope-seed {
    grid-area: 1 / 1;
  }

  .isotope-ring {
    overflow: visible;
    transform: rotate(-90deg);
    transition: filter 400ms ease;
  }

  .isotope-ring circle {
    fill: none;
    stroke-width: 2.25;
  }

  .isotope-ring-track {
    stroke: color-mix(in srgb, var(--ramp-blue) 22%, transparent);
    transition: stroke 150ms ease;
  }

  .isotope-ring-fill {
    stroke: var(--ramp-blue);
    stroke-linecap: round;
    transition: stroke-dashoffset 500ms linear;
  }

  .isotope-badge:hover .isotope-ring-track {
    stroke: color-mix(in srgb, var(--ramp-blue) 45%, transparent);
  }

  /* A reset is open: the ring glows, since it reports a state. */
  .isotope-badge.is-open .isotope-ring {
    filter: drop-shadow(0 0 3px color-mix(in srgb, var(--ramp-blue) 60%, transparent));
  }

  .isotope-count {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ink-primary);
  }

  .isotope-count[data-digits='3'] {
    font-size: 0.625rem;
  }

  /* An isotope: a small blue-white bead with the Cherenkov glow. Before any
     is held, one waits dimly in the ring, and brightens once a reset would
     pay it; the reset's isotopes fly in as beads. */
  .isotope-seed,
  .reactor-face :global(.isotope-flyer) {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: radial-gradient(
      circle at 35% 35%,
      #fff 0,
      var(--ramp-white) 35%,
      var(--ramp-blue) 100%
    );
    box-shadow: 0 0 6px color-mix(in srgb, var(--ramp-blue) 70%, transparent);
  }

  .isotope-seed {
    opacity: 0.45;
    transition: opacity 400ms ease;
  }

  .isotope-badge.is-open .isotope-seed {
    opacity: 1;
  }

  .reactor-face :global(.isotope-flyer) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 3;
    pointer-events: none;
  }

  /* Each isotope landing pops the ring. */
  .isotope-dial.is-landed {
    animation: dial-land 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes dial-land {
    0% {
      transform: scale(1.3);
    }
  }

  /* What a reset pays now, hanging from the ring's foot: "+1". */
  .isotope-tag {
    position: absolute;
    inset-block-end: -6px;
    inset-inline-start: 50%;
    min-width: 18px;
    padding: 1px 3px;
    border: 1px solid color-mix(in srgb, var(--ramp-blue) 70%, transparent);
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--ramp-blue) 24%, var(--panel-01));
    font-size: 0.5625rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    color: var(--ramp-white);
    translate: -50% 0;
  }

  /* A reset opens: the tag grows in. Each isotope more: it pops. */
  .isotope-tag.is-arriving {
    animation: tag-arrive 560ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .isotope-tag.is-up {
    animation: tag-up 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes tag-arrive {
    0% {
      opacity: 0;
      transform: scale(0.3);
    }
  }

  @keyframes tag-up {
    0% {
      transform: scale(1.35);
    }
  }

  /* "13 isotopes" over "next in 600K"; "Reset for +1" in the isotopes' blue
     once a reset is open. A fixed width, so the shelves' fit never flips as
     the numbers change. */
  .isotope-lines {
    display: flex;
    flex-direction: column;
    gap: 1px;
    width: 6rem;
    line-height: 1.25;
    white-space: nowrap;
  }

  .isotope-line-name,
  .isotope-line-next {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .isotope-line-name {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-secondary);
  }

  .isotope-line-next {
    font-size: 0.6875rem;
    color: var(--ink-muted);
  }

  .isotope-badge.is-open .isotope-line-next {
    color: var(--ramp-blue);
  }

  /* With the perk shelf near (a narrow face), the lines go and the ring
     stands alone; the script measures. */
  .reactor-wrap.is-compact .isotope-lines {
    display: none;
  }

  /* --- Perk shelf ------------------------------------------------------------

     This run's perks over the face's top-right corner, mirroring the isotope
     badge top-left: five sockets, each lit with a perk in its family's hue
     (DESIGN.md, Perk-Family Exception) or left as a dashed outline, and three
     pips under each for its level. At 566px of face it clears the energy
     readout; narrower, the readout steps down under it, and on a narrow face
     with a long row of isotopes the shelf drops below the beads. */

  .perk-shelf {
    position: absolute;
    inset-block-start: 14px;
    inset-inline-end: 16px;
    z-index: 4;
    transition: opacity 400ms ease;
  }

  /* Resetting the experiment: the shelf fades with the imploding core. */
  .perk-shelf.is-clearing {
    opacity: 0;
  }

  /* Filled from the corner inward: the first perk takes the rightmost socket,
     and Sixth Slot's socket opens on the left. Reversed in the layout only,
     so the markup, reading order and Tab still go first perk first. */
  .perk-slots {
    display: flex;
    flex-direction: row-reverse;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .perk-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .perk-slot[data-empty]::before {
    content: '';
    width: 26px;
    height: 26px;
    border: 1px dashed var(--line);
    border-radius: var(--tile-radius-sm);
  }

  .perk-slot[data-empty] .perk-pips {
    visibility: hidden;
  }

  .perk-chip {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: var(--tile-radius-sm);
    background-color: color-mix(in srgb, var(--perk) 16%, var(--panel-01));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--perk) 55%, transparent);
    color: var(--perk);
  }

  .perk-chip :global(svg) {
    width: 16px;
    height: 16px;
  }

  .perk-slot[data-rarity='rare'] .perk-chip {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--perk) 55%, transparent),
      0 0 8px color-mix(in srgb, var(--perk) 30%, transparent);
  }

  .perk-slot[data-rarity='keystone'] .perk-chip {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--perk) 55%, transparent),
      0 0 10px color-mix(in srgb, var(--perk) 40%, transparent);
  }

  .perk-slot[data-rarity='keystone'] .perk-chip::after {
    content: '';
    position: absolute;
    inset: 3px;
    border: 1px solid color-mix(in srgb, var(--perk) 40%, transparent);
    border-radius: 4px;
    pointer-events: none;
  }

  /* A perk flying in from the shop: the socket waits, then the chip lands. */
  .perk-slot.is-pending .perk-chip {
    opacity: 0;
  }

  .perk-chip.is-landed {
    animation: chip-land 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes chip-land {
    0% {
      transform: scale(1.6);
    }
  }

  .perk-pips {
    display: flex;
    gap: 2px;
  }

  .perk-pips > span {
    width: 4px;
    height: 4px;
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--perk) 22%, transparent);
  }

  .perk-pips[data-level='1'] > span:nth-child(-n + 1),
  .perk-pips[data-level='2'] > span:nth-child(-n + 2),
  .perk-pips[data-level='3'] > span {
    background-color: var(--perk);
  }

  /* A shelf's tooltip hangs under it, its caret on the chip or bead it
     describes: right-aligned under the perk shelf, left-aligned under the
     isotopes. Its top padding bridges the gap, so the pointer can cross onto
     it. A perk's tooltip wears its family's hue; the isotopes' wears theirs. */
  .shelf-tip {
    --tip-ink: var(--perk);

    position: absolute;
    inset-block-start: 100%;
    inset-inline-end: 0;
    z-index: 5;
    width: max-content;
    max-width: min(260px, calc(100cqi - 32px));
    padding-block-start: 8px;
  }

  .isotope-shelf .shelf-tip {
    --tip-ink: var(--ramp-blue);

    inset-inline: 8px auto;
  }

  /* A shelf showing its tooltip comes forward, so the tooltip is never under
     the other shelf on a narrow face. */
  .reactor-wrap > :has(> .shelf-tip:not([hidden])) {
    z-index: 5;
  }

  .shelf-tip-box {
    position: relative;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid color-mix(in srgb, var(--tip-ink) 55%, var(--line));
    border-radius: var(--radius-md);
    background-color: var(--panel-01);
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 40%),
      0 4px 6px -4px rgb(0 0 0 / 30%);
    text-align: start;
  }

  .shelf-tip-box::before {
    content: '';
    position: absolute;
    inset-block-start: -5px;
    inset-inline-end: calc(var(--caret-right, 13px) - 5px);
    width: 8px;
    height: 8px;
    border-block-start: 1px solid color-mix(in srgb, var(--tip-ink) 55%, var(--line));
    border-inline-start: 1px solid color-mix(in srgb, var(--tip-ink) 55%, var(--line));
    background-color: var(--panel-01);
    transform: rotate(45deg);
  }

  .isotope-shelf .shelf-tip-box::before {
    inset-inline: calc(var(--caret-left, 4px) - 5px) auto;
  }

  .shelf-tip-name {
    font-size: var(--text-label-size);
    font-weight: 600;
    color: var(--ink-primary);
  }

  .shelf-tip-kind {
    margin-block: 2px 4px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tip-ink);
  }

  .shelf-tip-detail {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  /* The isotope track's line, rung names lit: after the detail on the beads,
     before it on the ring. */
  .shelf-tip-unlock {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  .shelf-tip-detail + .shelf-tip-unlock:not([hidden]),
  .shelf-tip-unlock:not([hidden]) + .shelf-tip-detail {
    margin-block-start: 4px;
  }

  .shelf-tip-unlock :global(.rung-name) {
    font-weight: 600;
    color: var(--ink-primary);
  }

  /* A bought perk on its way from the shop to its socket (the script flies it). */
  .game-section :global(.perk-tile.perk-flyer) {
    position: fixed;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 60;
    pointer-events: none;
    transform-origin: 0 0;
  }

  /* Below 550px of wrap the centred energy readout would run under the
     badge's lines or the perk shelf, so it steps down under both shelves,
     whatever the face's padding. The badge always shows, so the readout keeps
     one place through a run. */
  @container reactor-wrap (max-width: 549px) {
    .reactor-wrap .energy-block {
      padding-block-start: calc(var(--shelf-clear) - var(--face-pad));
    }
  }

  /* On a very narrow face even the ring alone would meet the perk shelf. The
     script measures, and marks the wrap stacked: the perk shelf drops below
     the badge, and the readout with it. */
  .reactor-wrap.is-stacked > .perk-shelf {
    inset-block-start: 52px;
  }

  .reactor-wrap.is-stacked > .reactor-face {
    --shelf-clear: 92px;
  }

  .core[data-state='dormant'] {
    animation: none;
  }

  .core-ring {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-full);
    border: 1px solid var(--line);
    pointer-events: none;
  }

  .core-ring-inner {
    inset: 22px;
    border-color: color-mix(in srgb, var(--stage) calc(var(--core-alpha) * 0.6), transparent);
  }

  .core-heart {
    position: absolute;
    inset: 50%;
    width: 18px;
    height: 18px;
    border-radius: var(--radius-full);
    background-color: var(--core-heart);
    transform: translate(-50%, -50%);
  }

  .core.is-pressed {
    animation: core-press 160ms var(--ease);
  }

  /* Reaching a new state: one larger snap as the glow steps up. */
  .core.is-stepped {
    animation: core-step 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes core-step {
    0% {
      transform: scale(1.18);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes core-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.04);
    }
  }

  @keyframes core-press {
    0% {
      transform: scale(1.08);
    }
    100% {
      transform: scale(1);
    }
  }

  .floats {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .floats :global(.float) {
    position: absolute;
    font-size: var(--text-title-size);
    font-weight: 700;
    color: var(--stage); /* a gain takes the reactor's current stage color */
    white-space: nowrap;
    transform: translate(-50%, -50%);
    animation: float-rise 720ms ease-out forwards;
  }

  @keyframes float-rise {
    0% {
      opacity: 0.95;
      transform: translate(-50%, -50%);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, calc(-50% - 72px));
    }
  }

  /* A lucky press (Double Tap): gold, with a small bounce before it rises. */
  .floats :global(.float.is-lucky) {
    color: var(--gold);
    text-shadow: 0 0 10px color-mix(in srgb, var(--gold) 55%, transparent);
    animation: lucky-rise 820ms cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
  }

  @keyframes lucky-rise {
    0% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(0.6);
    }
    18% {
      transform: translate(-50%, calc(-50% - 10px)) scale(1.25);
    }
    32% {
      transform: translate(-50%, calc(-50% - 16px)) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, calc(-50% - 84px)) scale(1);
    }
  }

  /* Chain Reaction: each doubling pops out beside the last, x2, x4, x8, a
     little larger and a beat later each time (the script staggers them). */
  .floats :global(.float.is-chain) {
    animation: chain-pop 900ms cubic-bezier(0.2, 0.8, 0.3, 1) both;
  }

  @keyframes chain-pop {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.4);
    }
    20% {
      opacity: 1;
      transform: translate(-50%, calc(-50% - 6px)) scale(1.3);
    }
    35% {
      transform: translate(-50%, calc(-50% - 10px)) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, calc(-50% - 64px)) scale(1);
    }
  }

  /* Afterglow: presses keep a surge's gold for a while after it. */
  .reactor-face.is-afterglow .floats :global(.float:not(.is-idle)) {
    color: var(--gold);
  }

  /* A perk at work, such as Self-Replicator's free copy: an idle-style drift
     in the perk's own hue. */
  .floats :global(.float.is-perk) {
    color: var(--perk);
  }

  /* A rung of the isotope track at work: Perfect Pitch catching a press. */
  .floats :global(.float.is-track) {
    color: var(--ramp-blue);
  }

  /* Idle income: small, dim, slow, drifting off the core's rim. */
  .floats :global(.float.is-idle) {
    font-size: var(--text-label-size);
    font-weight: 600;
    animation: idle-drift 1700ms ease-out forwards;
  }

  @keyframes idle-drift {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%);
    }
    20% {
      opacity: 0.5;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, calc(-50% - 40px));
    }
  }

  /* Overdrive gains: gold (via --stage) and larger, so the 10x reads at once. */
  .reactor-face[data-surge='active'] .floats :global(.float) {
    font-size: 1.375rem;
    text-shadow: 0 0 12px color-mix(in srgb, var(--gold) 55%, transparent);
  }

  /* --- Core readout (surge countdown and live rate) ------------------------- */

  .core-readout {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease);
  }

  .reactor-face[data-surge='warning'] .core-readout,
  .reactor-face[data-surge='active'] .core-readout {
    opacity: 1;
  }

  /* The readout takes the heart's place while it shows. */
  .core-heart {
    transition: opacity var(--duration-base) var(--ease);
  }

  .reactor-face[data-surge='warning'] .core-heart,
  .reactor-face[data-surge='active'] .core-heart {
    opacity: 0;
  }

  .core-num {
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--gold-ink);
    text-shadow: 0 0 18px color-mix(in srgb, var(--gold) 70%, transparent);
  }

  .reactor-face[data-surge='warning'] .core-num {
    color: var(--gold);
  }

  .core-unit {
    font-size: 0.75rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--gold) 65%, var(--ink-primary));
  }

  /* Each countdown second lands with a snap. */
  .core-num.is-tick {
    animation: core-tick 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes core-tick {
    0% {
      opacity: 0;
      transform: scale(1.6);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* --- Sparks (one burst per overdrive press) -------------------------------- */

  .sparks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* A short streak that flies out from the core's rim along its own angle.
     Placed at the core's centre by the script; rotate, then travel. */
  .sparks :global(.spark) {
    position: absolute;
    width: 14px;
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(to right, transparent, var(--gold-ink));
    box-shadow: 0 0 6px color-mix(in srgb, var(--gold) 80%, transparent);
    transform-origin: 0 50%;
    animation: spark 480ms ease-out forwards;
  }

  @keyframes spark {
    0% {
      opacity: 1;
      transform: rotate(var(--a)) translateX(var(--r0));
    }
    100% {
      opacity: 0;
      transform: rotate(var(--a)) translateX(var(--r1)) scaleX(0.3);
    }
  }

  .state-label {
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-size: var(--text-title-size);
  }

  /* Tinted toward the stage color, so the name and the glow read together. */
  .state-name {
    font-weight: 700;
    color: color-mix(in srgb, var(--stage) 50%, var(--ink-primary));
  }

  .state-name.is-settling {
    animation: name-settle 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes name-settle {
    0% {
      opacity: 0;
      letter-spacing: 0.3em;
    }
    100% {
      opacity: 1;
      letter-spacing: 0;
    }
  }

  .state-noun {
    color: var(--ink-muted);
  }

  /* Stands in for the state label while a surge counts down and runs. */
  .surge-label {
    z-index: 1;
    font-size: var(--text-title-size);
    font-weight: 700;
    color: var(--gold);
  }

  /* Stands in for the state label while the reactor runs down or has
     faulted: neutral ink, since the run-down adds no color. */
  .power-label {
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-size: var(--text-title-size);
  }

  .power-name {
    font-weight: 700;
    color: var(--ink-secondary);
  }

  .power-label.is-fault .power-name {
    color: var(--ink-primary);
  }

  .power-detail {
    color: var(--ink-muted);
  }

  .power-detail :global(.readout) {
    color: var(--ink-secondary);
  }

  .power-name.is-settling {
    animation: name-settle 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* --- Combo meter ----------------------------------------------------------- */

  .combo {
    z-index: 1;
    width: min(360px, 100%);
  }

  .combo-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-block-end: var(--space-xs);
  }

  /* A faulted reactor has no combo to show (SPACEBAR-CLICKER.md §8.5.18):
     the row and its grace bar fade out, keeping their room, until the
     restart. The scope stays, as it draws the restart's beat. */
  .combo-row,
  .combo-track {
    transition: opacity 300ms var(--ease);
  }

  .reactor-face[data-power='fault'] :is(.combo-row, .combo-track) {
    opacity: 0;
  }

  .combo-count {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .combo-tier {
    font-size: var(--text-label-size);
    color: var(--ink-muted);
  }

  .combo-tier.is-tiered {
    font-weight: 600;
    color: var(--ink-primary);
  }

  /* Tier up: the label snaps, the way the GO state does. */
  .combo-tier.is-up {
    animation: tier-up 360ms cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: left center;
  }

  @keyframes tier-up {
    0% {
      transform: scale(1.35);
      color: var(--signal-green);
    }
    100% {
      transform: scale(1);
    }
  }

  /* The next target, so the player chases a number rather than waits. */
  .combo-next {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  /* The tier's multiplier, and under it what the tier gives the auto-tappers
     once Synchronisation shares it. The first line keeps the row's baseline;
     the second opens when the sharing starts, with a purchase or a perk, and
     closes with a reset. */
  .combo-mults {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin-inline-start: auto;
  }

  .combo-mult {
    font-size: var(--text-title-size);
    font-weight: 700;
    color: var(--ink-secondary);
  }

  .combo-sync {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 420ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 420ms ease;
  }

  .combo.is-synced .combo-sync {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .combo-sync-line {
    min-height: 0;
    overflow: hidden;
    font-size: 0.75rem;
    line-height: 0.875rem;
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .combo-sync .readout {
    font-weight: 700;
    color: var(--ink-secondary);
  }

  .combo-track {
    width: 100%;
    height: 4px;
    border-radius: var(--radius-full);
    background-color: var(--panel-01);
    overflow: hidden;
  }

  /* The fill draining is the grace window: green as "active", and it fades to
     nothing the moment the combo is gone. */
  .combo-fill {
    width: 100%;
    height: 100%;
    background-color: var(--signal-green);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  /* Brute Force: there is no combo to build, so the meter stands down. */
  .combo.is-off .combo-count,
  .combo.is-off .combo-mult,
  .combo.is-off .combo-sync .readout {
    color: var(--ink-muted);
  }

  .test-hint {
    z-index: 1;
    max-width: 38ch;
    font-size: var(--text-label-size);
    font-style: italic;
    color: var(--ink-muted);
    text-align: center;
  }

  /* --- The retired hint's room (SPACEBAR-CLICKER.md §8.5.18) ----------------

     Once the player has held a combo the standing hint goes for good, and
     its line with it; the run-down's and the fault's instructions bring it
     back while they are needed. The height it gives up, its line and the
     gap over it, is spread through the face above it, where the readouts
     and the dial sat close together, so the face keeps its height. The line
     closes and the room opens together, over 400ms, where the browser can
     ease a height to nothing; elsewhere both happen at once. */
  .reactor-face {
    /* The hint's one line and the face's gap; two lines on a narrow face. */
    --hint-room: calc(2.625rem + 0.625rem);
    --room: 0px;

    interpolate-size: allow-keywords;
  }

  @container reactor (min-width: 460px) {
    .reactor-face > * {
      --hint-room: calc(1.3125rem + 0.625rem);
    }
  }

  .reactor-face.is-roomy > * {
    --room: var(--hint-room);
  }

  /* Shares of the room, adding to the whole of it. On a narrow face the
     readout already sits under the shelves, so the room is spread evenly.
     On a wide one the number shares a band with the isotope badge and the
     perk shelf: most of the room goes over it, setting it clear below the
     shelf's pips, and none under the dial. */
  .reactor-face > * {
    --room-readout: 0.2;
    --room-rates: 0.13;
    --room-share: 0.13;
    --room-dial: 0.22;
    --room-combo: 0.19;
    --room-key: 0.13;
  }

  @container reactor-wrap (min-width: 550px) {
    .reactor-face > * {
      --room-readout: 0.6;
      --room-rates: 0.1;
      --room-share: 0.1;
      --room-dial: 0.2;
      --room-combo: 0;
      --room-key: 0;
    }
  }

  .test-hint.is-retired {
    height: 0;
    margin-block-start: -0.625rem; /* the face's gap, which it gives up too */
    overflow: hidden;
    opacity: 0;
  }

  .energy-block {
    margin-block-start: calc(var(--room) * var(--room-readout));
  }

  .reactor-face .energy-rates {
    margin-block-start: calc(var(--space-sm) + var(--room) * var(--room-rates));
  }

  .reactor-face .share {
    margin-block-start: calc(4px + var(--room) * var(--room-share));
  }

  .core-wrap {
    margin-block-start: calc(var(--room) * var(--room-dial));
  }

  .combo {
    margin-block-start: calc(var(--room) * var(--room-combo));
  }

  .keycap {
    margin-block-start: calc(var(--room) * var(--room-key));
  }

  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      .energy-block,
      .energy-rates,
      .core-wrap,
      .combo,
      .keycap {
        transition: margin-block-start 400ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .share {
        transition:
          opacity 600ms var(--ease),
          margin-block-start 400ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .test-hint {
        transition:
          height 400ms cubic-bezier(0.16, 1, 0.3, 1),
          margin-block-start 400ms cubic-bezier(0.16, 1, 0.3, 1),
          opacity 200ms var(--ease);
      }
    }
  }

  /* On a wide face the hint takes one line, which pays for the share row
     under the readouts: the face still fits a 1440x900 screen. */
  @container reactor (min-width: 460px) {
    .test-hint {
      max-width: none;
    }
  }

  .keycap {
    z-index: 1;
    display: block;
    width: min(320px, 70%);
    padding: var(--space-sm) 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--panel-01);
    /* The key's lip is a shadow, not a border, so pressing it moves nothing
       around it. */
    box-shadow: 0 2px 0 var(--line);
    color: var(--ink-muted);
    font-size: var(--text-label-size);
    font-weight: var(--text-label-weight);
    letter-spacing: 0.24em;
    text-align: center;
    text-transform: uppercase;
  }

  /* Every press bottoms the key out for a moment, lit in the stage color. */
  .keycap.is-down {
    animation: key-down 170ms var(--ease);
  }

  @keyframes key-down {
    0% {
      transform: translateY(2px);
      box-shadow: 0 0 0 var(--line);
      border-color: color-mix(in srgb, var(--stage) 45%, var(--line));
      color: var(--stage);
    }
  }

  /* --- Rhythm scope ------------------------------------------------------------ */

  /* Drawn by the script. The left edge fades out, so old presses scroll away
     rather than drop off a cliff. */
  .rhythm-scope {
    display: block;
    width: 100%;
    height: 24px;
    margin-block-start: 6px;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 30%);
    mask-image: linear-gradient(to right, transparent, #000 30%);
  }

  /* --- Surge results card ------------------------------------------------------ */

  .surge-card {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    min-width: min(300px, calc(100vw - 4rem));
    padding: var(--space-md) var(--space-lg);
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    border-radius: var(--radius-lg);
    background-color: var(--panel-01);
    box-shadow: 0 0 32px color-mix(in srgb, var(--gold) 12%, transparent);
    text-align: center;
    transform: translate(-50%, -50%);
    pointer-events: none;
    animation: card-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translate(-50%, calc(-50% + 10px));
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%);
    }
  }

  .surge-card-title {
    font-size: var(--text-label-size);
    font-weight: 700;
    color: var(--gold);
  }

  .surge-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
    width: 100%;
  }

  .surge-stats > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .surge-stats dt {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .surge-stats dd {
    font-size: var(--text-headline-size);
    font-weight: 700;
    line-height: 1.1;
  }

  .surge-best {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
    background-color: rgb(34 197 94 / 10%);
    color: var(--signal-green); /* "your best" */
    font-size: var(--text-label-size);
    font-weight: 600;
    overflow: hidden;
  }

  /* One sheen across the chip once the numbers land. */
  .surge-best.is-shining::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgb(255 255 255 / 40%) 50%,
      transparent 70%
    );
    transform: translateX(-100%);
    animation: sheen 900ms ease-out forwards;
  }

  @keyframes sheen {
    to {
      transform: translateX(100%);
    }
  }

  /* The boss's loot: a perk the surge dropped, named in its hue. */
  .surge-drop {
    font-size: var(--text-label-size);
    font-weight: 600;
    color: var(--ink-secondary);
  }

  .surge-drop-name {
    color: var(--perk);
  }

  /* --- Unlock card ------------------------------------------------------------

     After a reset reaches new rungs of the isotope track, the surge card's
     shape in the isotopes' blue names them over the core (DESIGN.md,
     Reactor-Ramp Exception). */

  .unlock-card {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    width: max-content;
    max-width: min(340px, calc(100% - 2rem));
    padding: var(--space-md) var(--space-lg);
    border: 1px solid color-mix(in srgb, var(--ramp-blue) 45%, transparent);
    border-radius: var(--radius-lg);
    background-color: var(--panel-01);
    box-shadow: 0 0 32px color-mix(in srgb, var(--ramp-blue) 14%, transparent);
    text-align: center;
    transform: translate(-50%, -50%);
    pointer-events: none;
    animation: card-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .unlock-card-title {
    font-size: var(--text-label-size);
    font-weight: 700;
    color: var(--ramp-blue);
  }

  .unlock-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .unlock-list :global(.unlock-name) {
    display: block;
    font-weight: 700;
    color: var(--ink-primary);
  }

  .unlock-list :global(.unlock-detail) {
    display: block;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  /* A reset that lands more rungs than the card lists points to the rest. */
  .unlock-more {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .unlock-more :global(.readout) {
    color: var(--ramp-blue);
  }

  /* While a card is over the core, the core's area comes forward, so a tall
     card covers the labels around it rather than sitting under them. */
  .core-wrap:has(> :is(.unlock-card, .surge-card):not([hidden])) {
    z-index: 2;
  }

  /* --- Toast ---------------------------------------------------------------- */

  /* A notice takes the keycap's place for as long as it shows
     (SPACEBAR-CLICKER.md §8.5.18): the same foot of the face, at least the
     key's width and height with its lip, so the key never shows around it.
     The key is decoration, and the core still answers every press. A long
     notice grows wider, then upward. The top corners belong to the isotope
     and perk shelves. */
  .toast {
    position: absolute;
    inset-block-end: calc(var(--face-pad) - 2px);
    inset-inline-start: 50%;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    /* The keycap's 70% is of the face's content; this is of its padding box. */
    min-width: min(320px, calc(70% - 1.4 * var(--face-pad)));
    min-height: 41px;
    max-width: calc(100% - 2 * var(--face-pad));
    translate: -50% 0;
    text-align: center;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--panel-01);
    font-size: var(--text-label-size);
    font-weight: 500;
    color: var(--ink-primary);
  }

  .toast[hidden] {
    display: none;
  }

  /* A perk drop's toast wears the perk's hue. */
  .toast[data-family] {
    border-color: color-mix(in srgb, var(--perk) 55%, var(--line));
    color: var(--perk);
  }

  .toast.is-in {
    animation: toast-in var(--duration-base) var(--ease);
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --- Shop -------------------------------------------------------------------- */

  .shop {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
    min-height: 0; /* lets the list scroll inside the pinned height */
  }

  /* The shop's column sets its own gaps, so its title drops the margin. */
  .section-title.shop-heading {
    margin-block-end: 0;
  }

  /* The tabs themselves take the shared .tab look (setting-button parity);
     these rules only lay them out and carry the tag. */
  .shop-tabs {
    display: flex;
    gap: var(--space-sm);
    margin-block-end: var(--space-xs);
  }

  .shop-tab {
    position: relative;
    flex: 1;
  }

  /* Shop-Signal Exception: amber means "something new to spend on". Pinned to
     the tab's top-right corner so it never shifts the label. */
  .shop-new-tag {
    position: absolute;
    inset-block-start: -9px;
    inset-inline-end: -6px;
    padding: 2px 7px;
    border-radius: var(--radius-full);
    background-color: var(--caution-amber);
    color: var(--chassis-black);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.02em;
    pointer-events: none;
    animation: new-tag-in 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes new-tag-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .shop-panel {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .shop-list {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    gap: var(--space-xs);
    padding: 0;
    overflow-y: auto;
    list-style: none;
  }

  /* Three fixed columns: glyph tile, text, numbers. Every row puts its name at
     the same x, whatever the price beside it. */
  .shop-buy {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.75rem;
    width: 100%;
    padding: var(--space-sm) var(--space-md) var(--space-sm) var(--space-sm);
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    background-color: var(--card-bg);
    color: var(--ink-secondary);
    text-align: start;
    cursor: default;
    transition:
      border-color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease);
  }

  .shop-buy.is-affordable {
    border-color: var(--line);
    color: var(--ink-primary);
    cursor: pointer;
  }

  .shop-buy.is-affordable:hover {
    background-color: var(--panel-hover);
    border-color: var(--ink-muted);
  }

  .shop-buy.is-maxed {
    opacity: 0.7;
  }

  /* A recessed tile for the glyph, as the related-tools cards do. It
     brightens with the row when the item is affordable. */
  .shop-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
    background-color: var(--panel-01);
    color: var(--ink-muted);
    transition:
      color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease);
  }

  .shop-buy.is-affordable .shop-icon {
    border-color: var(--line);
    color: var(--ink-primary);
  }

  .shop-text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .shop-name {
    font-size: var(--text-label-size);
    font-weight: 600;
  }

  .shop-detail {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  /* Synchronisation's row, until it is bought: what it would add to the
     auto-tappers at the player's combo (SPACEBAR-CLICKER.md §8.5.12). The
     number brightens with the row once it is affordable. */
  .shop-note {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .shop-note :global(.readout) {
    color: var(--ink-secondary);
  }

  .shop-buy.is-affordable .shop-note :global(.readout) {
    color: var(--ink-primary);
  }

  .shop-nums {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .shop-cost {
    font-size: var(--text-label-size);
    font-weight: 700;
    color: var(--ink-muted);
  }

  .shop-buy.is-affordable .shop-cost {
    color: var(--ink-primary);
  }

  .shop-level {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .shop-hint {
    font-size: 0.75rem;
    font-style: italic;
    color: var(--ink-muted);
  }

  /* --- Perk offers --------------------------------------------------------------

     A perk on offer tops its tab on the shop rows' own grid. It is always lit
     in its family's hue, affordable or not, because it is only here for a
     while: the ring around its tile is the window draining. Rarity shows in
     the tile: a rare glows, a keystone is set in a second ring. */

  .perk-buy {
    position: relative;
    overflow: hidden; /* clips the keystone's arrival sheen */
    border-color: color-mix(in srgb, var(--perk) 32%, var(--line));
    background-image: linear-gradient(
      90deg,
      color-mix(in srgb, var(--perk) 9%, transparent),
      transparent 70%
    );
    color: var(--ink-primary);
  }

  .perk-buy.is-affordable {
    border-color: color-mix(in srgb, var(--perk) 65%, var(--line));
  }

  .perk-buy.is-affordable:hover {
    border-color: var(--perk);
  }

  /* The glyph tile: the shop's recessed tile, lit in the family hue. Shared
     with the dialog's perk cards, which the script builds. */
  .game-section :global(.perk-tile) {
    position: relative;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background-color: color-mix(in srgb, var(--perk) 14%, var(--panel-01));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--perk) 45%, transparent);
    color: var(--perk);
  }

  .game-section :global(.perk-glyph-slot) {
    display: flex;
  }

  .game-section :global([data-rarity='rare'] .perk-tile) {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--perk) 45%, transparent),
      0 0 10px color-mix(in srgb, var(--perk) 30%, transparent);
  }

  .game-section :global([data-rarity='keystone'] .perk-tile) {
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--perk) 45%, transparent),
      0 0 14px color-mix(in srgb, var(--perk) 40%, transparent);
  }

  /* A keystone is set in a second, inner ring. */
  .game-section :global([data-rarity='keystone'] .perk-tile::after) {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid color-mix(in srgb, var(--perk) 45%, transparent);
    border-radius: 5px;
    pointer-events: none;
  }

  /* The offer's tile drops its hairline for the ring, which is its border. */
  .perk-offer .perk-tile {
    box-shadow: none;
  }

  .perk-offer[data-rarity='rare'] .perk-tile {
    box-shadow: 0 0 10px color-mix(in srgb, var(--perk) 30%, transparent);
  }

  .perk-offer[data-rarity='keystone'] .perk-tile {
    box-shadow: 0 0 14px color-mix(in srgb, var(--perk) 40%, transparent);
  }

  .perk-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke-width: 2;
  }

  .perk-ring-track {
    stroke: color-mix(in srgb, var(--perk) 22%, transparent);
  }

  .perk-ring-fill {
    stroke: var(--perk);
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 160ms linear;
  }

  /* The last fifth of the window: the ring breathes. Never a flash. */
  .perk-offer.is-fading .perk-ring-fill {
    animation: ring-breathe 1.1s ease-in-out infinite alternate;
  }

  @keyframes ring-breathe {
    to {
      opacity: 0.35;
    }
  }

  .game-section :global(.perk-level) {
    display: inline-block;
    margin-inline-start: 2px;
    padding: 0 6px;
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--perk) 16%, transparent);
    color: var(--perk);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.45;
    vertical-align: 1px;
  }

  .game-section :global(.perk-level[hidden]) {
    display: none;
  }

  /* The perk's numbers carry its hue, and never break from their unit
     ("5 s"). An upgrade strikes the old one out. */
  .game-section :global(.perk-value) {
    font-weight: 600;
    color: var(--perk);
    white-space: nowrap;
  }

  .game-section :global(.perk-was) {
    color: var(--ink-muted);
  }

  .perk-note {
    font-size: 0.75rem;
    color: var(--ink-secondary);
  }

  /* The isotope track's credit where a rung acts: on an offer (Prodigy, the
     finds, Patience, Familiar) and on the surge card (Capacitor). In the
     isotopes' blue after a bead, so it reads as the track's doing (DESIGN.md,
     Reactor-Ramp Exception). */
  .perk-credit {
    display: flex;
    flex-direction: column;
  }

  .perk-credit :global(.credit),
  .surge-credit {
    display: flex;
    align-items: flex-start;
    gap: 5px;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ramp-blue);
  }

  /* The bead sits on the first line's middle, however the line wraps. */
  .perk-credit :global(.credit)::before,
  .surge-credit::before {
    content: '';
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    margin-block-start: 6px;
    border-radius: var(--radius-full);
    background: radial-gradient(
      circle at 35% 35%,
      #fff 0,
      var(--ramp-white) 35%,
      var(--ramp-blue) 100%
    );
  }

  .surge-credit {
    font-weight: 600;
  }

  /* Rare and keystone call out in the family hue; a common stays quiet, so a
     high tier reads as the event it is. */
  .perk-rarity {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--perk);
  }

  .perk-offer[data-rarity='common']:not(.is-upgrade) .perk-rarity {
    color: var(--ink-secondary);
  }

  /* A drop: the row slides in and the tile pops. A rare or a keystone also
     throws a ring off its tile, and a keystone sends a sheen down the row. */
  .perk-offer.is-arriving {
    animation: offer-in 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes offer-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .perk-offer.is-arriving .perk-tile {
    animation: tile-pop 560ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes tile-pop {
    0% {
      transform: scale(0.55);
    }
    55% {
      transform: scale(1.12);
    }
  }

  .perk-offer.is-arriving:not([data-rarity='common']) .perk-tile::before,
  .perk-tile.is-claimed::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid var(--perk);
    border-radius: var(--radius-md);
    opacity: 0;
    pointer-events: none;
    animation: tile-burst 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .perk-offer.is-arriving[data-rarity='keystone'] .perk-tile::before {
    animation-duration: 1000ms;
  }

  @keyframes tile-burst {
    0% {
      opacity: 0.9;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(2.2);
    }
  }

  .perk-offer.is-arriving[data-rarity='keystone'] .perk-buy::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 30%,
      color-mix(in srgb, var(--perk) 28%, transparent) 50%,
      transparent 70%
    );
    transform: translateX(-100%);
    pointer-events: none;
    animation: sheen 1100ms ease-out 220ms forwards;
  }

  /* Bought: the tile flares and throws its ring; the script then folds the
     row away, as it does when an offer runs out. */
  .perk-tile.is-claimed {
    animation: tile-claim 320ms cubic-bezier(0.3, 0, 0.3, 1);
  }

  @keyframes tile-claim {
    45% {
      transform: scale(1.14);
      background-color: color-mix(in srgb, var(--perk) 40%, var(--panel-01));
    }
  }

  .perk-offer.is-leaving {
    overflow: hidden;
    pointer-events: none;
  }

  /* With the Reroll rung, a small pill under the offer swaps it for a fresh
     drop, once a run. It is a sibling of the row's button, not inside it. */
  .perk-offer {
    display: flex;
    flex-direction: column;
  }

  .perk-reroll {
    display: inline-flex;
    align-self: flex-end;
    align-items: center;
    gap: 4px;
    min-height: 24px;
    margin-block-start: 4px;
    padding: 0 var(--space-sm);
    border: 1px solid color-mix(in srgb, var(--perk) 35%, var(--line));
    border-radius: var(--radius-full);
    background: none;
    color: var(--perk);
    font: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease);
  }

  .perk-reroll:hover {
    border-color: var(--perk);
    background-color: color-mix(in srgb, var(--perk) 10%, transparent);
  }

  /* --- Panels -------------------------------------------------------------------- */

  /* The isotope ring scrolls the panels into view; the margin keeps the Reset
     button off the window's edge. */
  .panels {
    container: panels / inline-size;
    padding-block-start: var(--space-lg);
    border-block-start: 1px solid var(--line-subtle);
    scroll-margin-block: var(--space-xl);
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-end: var(--space-lg);
  }

  /* Too narrow for one row (the four need about 370px), the tabs sit two by
     two at equal widths rather than leave one wrapped alone. The margin
     covers wider system fonts. */
  @container panels (max-width: 440px) {
    .tabs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .tab {
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--panel-03);
    color: var(--ink-secondary);
    font-size: var(--text-label-size);
    font-weight: var(--text-label-weight);
    transition: all var(--duration-fast) var(--ease);
  }

  .tab:hover {
    background-color: var(--panel-hover);
    border-color: var(--ink-muted);
    color: var(--ink-primary);
  }

  /* Selected reads as the active setting button: a recessed, illuminated key.
     Shared by the shop tabs and the panel tabs. */
  .tab[aria-selected='true'] {
    background-color: var(--chassis-black);
    border-color: var(--signal-green);
    color: var(--ink-primary);
  }

  .tab[aria-selected='true']:hover {
    background-color: var(--panel-hover);
    border-color: var(--signal-green);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-sm);
  }

  .stats > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--card-pad);
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    background-color: var(--card-bg);
  }

  .stats dt {
    font-size: var(--text-label-size);
    color: var(--ink-secondary);
  }

  .stats dd {
    font-weight: 700;
  }

  .panel-intro {
    margin-block-end: var(--space-md);
    font-size: var(--text-label-size);
    color: var(--ink-secondary);
  }

  .achievements {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-sm);
    padding: 0;
    list-style: none;
  }

  .achievement {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--card-pad);
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    background-color: var(--card-bg);
  }

  .achievement-mark {
    min-width: 20px;
    font-weight: 700;
    color: var(--ink-muted);
  }

  .achievement.is-unlocked .achievement-mark {
    color: var(--signal-green); /* achieved, as the rank checklist does */
  }

  .achievement-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .achievement-name {
    font-size: var(--text-label-size);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .achievement.is-unlocked .achievement-name {
    color: var(--ink-primary);
  }

  .achievement-detail {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  /* The Perks panel (SPACEBAR-CLICKER.md §8.5.17): this run's perks as cards
     shaped like the isotope track's, then the codex as a board of sockets and
     one card that reads whichever socket is shown. The panel is a container,
     so its layout follows its own width. */
  #sc-panel-perks {
    container: perks-panel / inline-size;
  }

  .perks-section + .perks-section {
    margin-block-start: var(--space-xl);
  }

  /* One heading for every section of the game (SPACEBAR-CLICKER.md
     §8.5.18): the shop's, and each section of the panels. A title, and
     where there is something to count, the count in the readout face with
     its word after it. */
  .section-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
    margin-block-end: var(--space-sm);
    font-size: var(--text-title-size);
    font-weight: 600;
  }

  .section-count {
    font-size: var(--text-label-size);
    font-weight: 500;
    color: var(--ink-secondary);
  }

  .section-count .readout {
    color: var(--ink-primary);
  }

  /* One accent per perk here: its tile in the family hue, without the glow
     a rare or keystone wears elsewhere. A keystone keeps its inner ring. */
  #sc-panel-perks :global([data-family][data-rarity] .perk-tile) {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--perk) 45%, transparent);
  }

  /* This run: tile, name and level on one line, the rarity at its end, the
     effect under them. */
  .run-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .run-cards :global(.run-card) {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-sm) var(--space-md) 10px var(--space-sm);
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    background-color: var(--card-bg);
  }

  .run-cards :global(.run-card-head) {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--space-sm);
  }

  .run-cards :global(.perk-tile) {
    width: 28px;
    height: 28px;
    border-radius: var(--tile-radius-sm);
  }

  .run-cards :global(.perk-tile svg) {
    width: 18px;
    height: 18px;
  }

  .run-cards :global([data-rarity='keystone'] .perk-tile::after) {
    inset: 3px;
    border-radius: 4px;
  }

  .run-cards :global(.run-card-name) {
    min-width: 0;
    font-size: var(--text-label-size);
    font-weight: 600;
    color: var(--ink-primary);
  }

  /* A rare or keystone says so, quietly; a common says nothing. */
  .run-cards :global(.run-card-rarity) {
    margin-inline-start: auto;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .run-cards :global(.perk-card-detail) {
    padding-inline-start: calc(28px + var(--space-sm));
  }

  /* The codex board: a row per shop tab, its label and count beside it, the
     sockets in family bands. */
  .codex-board {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-md);
    margin-block-end: var(--space-md);
  }

  .codex-label {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-block-start: 9px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-secondary);
  }

  .codex-label-count {
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--ink-muted);
  }

  .codex-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  .codex-row :global(.codex-band) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* A socket: its tile, room under it for the held-this-run dot, and a ring
     round it while the card reads it. Keyboard focus draws the ring in the
     site's focus green, since focus is what the card then reads. */
  .codex-row :global(.codex-socket) {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 0 9px;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .codex-row :global(.codex-socket::before) {
    content: '';
    position: absolute;
    top: -4px;
    left: -4px;
    width: 44px;
    height: 44px;
    border: 2px solid var(--perk);
    border-radius: 12px;
    opacity: 0;
    pointer-events: none;
  }

  .codex-row :global(.codex-socket.is-shown::before) {
    opacity: 1;
  }

  .codex-row :global(.codex-socket:focus-visible) {
    outline: none;
  }

  .codex-row :global(.codex-socket:focus-visible::before) {
    border-color: var(--signal-green);
    opacity: 1;
  }

  /* Held this run: a dot under the socket, as a dock marks what is open. */
  .codex-row :global(.codex-socket.is-now::after) {
    content: '';
    position: absolute;
    bottom: 1px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--perk);
  }

  /* Found but never held: lit, but dimmer than one that was held. */
  .codex-row :global(.codex-socket.is-unheld .perk-tile) {
    opacity: 0.45;
  }

  /* Not found yet: an empty socket in its rarity's shape, nothing more. The
     reading card draws one the same way. */
  .codex-row :global(.codex-socket.is-undiscovered),
  .codex-read-perk:global(.is-undiscovered) {
    --perk: var(--ink-muted);
  }

  .codex-row :global(.codex-socket.is-undiscovered .perk-tile),
  .codex-read-perk:global(.is-undiscovered) :global(.perk-tile) {
    background-color: transparent;
    box-shadow: none;
    outline: 1px dashed color-mix(in srgb, var(--ink-muted) 45%, transparent);
    outline-offset: -1px;
  }

  .codex-row :global(.codex-socket.is-undiscovered .perk-tile::after),
  .codex-read-perk:global(.is-undiscovered) :global(.perk-tile::after) {
    border-style: dashed;
  }

  /* The reading card: the shown perk in full, or, with none shown, what the
     codex is. Its least height is about a perk's, so pointing along the
     board barely moves what is under it. */
  .codex-read {
    display: flex;
    min-height: 5.5rem;
  }

  .codex-read-empty {
    display: flex;
    flex: 1;
    align-items: center;
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    border: 1px dashed var(--line);
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  .codex-read-perk {
    display: grid;
    flex: 1;
    grid-template-columns: 36px minmax(0, 1fr);
    align-items: start;
    column-gap: var(--space-md);
    padding: var(--space-sm) var(--space-md) var(--space-sm) var(--space-sm);
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    background-color: var(--card-bg);
  }

  .codex-read-perk :global(.codex-read-text) {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 3px;
  }

  .codex-read-perk :global(.codex-read-name) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-sm);
    margin: 0;
    font-size: var(--text-label-size);
    font-weight: 600;
    color: var(--ink-primary);
  }

  .codex-read-perk :global(.codex-read-kind) {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  /* Every level's number, those held filled, the one the effect quotes in
     the perk's hue; then how far it was held. */
  .codex-read-perk :global(.codex-read-foot) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px var(--space-md);
    margin-block-start: 4px;
  }

  .codex-read-perk :global(.codex-ladder) {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .codex-read-perk :global(.codex-ladder li) {
    display: flex;
    align-items: baseline;
    gap: 5px;
    padding: 2px 8px;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .codex-read-perk :global(.codex-ladder-num) {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .codex-read-perk :global(.codex-ladder .is-held) {
    border-color: color-mix(in srgb, var(--perk) 45%, transparent);
    background-color: color-mix(in srgb, var(--perk) 12%, transparent);
    color: var(--ink-secondary);
  }

  .codex-read-perk :global(.codex-ladder .is-quoted) {
    color: var(--perk);
  }

  .codex-read-perk :global(.codex-read-status) {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  /* A narrow panel: each row's label above it, the effect under the tile. */
  @container perks-panel (max-width: 560px) {
    .codex-board {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }

    .codex-label {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-sm);
      padding-block-start: var(--space-sm);
    }

    .codex-row {
      gap: 6px 14px;
    }

    .run-cards :global(.perk-card-detail) {
      padding-inline-start: 0;
    }
  }

  /* The Isotopes tab (SPACEBAR-CLICKER.md §8.5.17), in three sections on the
     Perks tab's pattern: the next reset as one card, the isotope track as
     cards in rows of three, then what a reset does in two lines. Everything
     spans the panel. The panel is a container so its layout follows its own
     width, beside the sidebar or not. */
  #sc-panel-prestige {
    container: reset-panel / inline-size;
  }

  /* The script writes these numbers, so they are global. */
  .reset-figures :global(.readout),
  .modal-message :global(.readout) {
    color: var(--ink-primary);
  }

  /* The figures with the button beside them, and under both, what the
     reset unlocks. Closed, the figures take the width. */
  .reset-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'figures button'
      'unlocks unlocks';
    align-items: center;
    column-gap: var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--card-line);
    border-radius: var(--radius-lg);
    background-color: var(--card-bg);
  }

  .reset-card:has(.btn[hidden]) {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'figures'
      'unlocks';
  }

  /* Closed: the isotopes held, then the way to the first isotope. Open: what
     a reset pays, the gains after, then the way to the next. */
  .reset-figures {
    grid-area: figures;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-md) var(--space-lg);
    margin: 0;
  }

  .reset-figures.is-open {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.6fr);
  }

  .reset-figure {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .reset-figure dt {
    font-size: var(--text-label-size);
    color: var(--ink-secondary);
  }

  /* Every figure has the same rows: the label, the value (in the meter's,
     the bar, centred in the value's line), then a line under it, so they
     line up at any width. */
  .reset-figure dd {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: auto 0 0;
  }

  .reset-figure-value,
  .reset-figure-bar {
    height: calc(var(--text-headline-size) * 1.2);
    font-size: var(--text-headline-size);
    font-weight: 700;
    line-height: 1.2;
  }

  .reset-figure-bar {
    display: flex;
    align-items: center;
  }

  .reset-figure-bar > .isotope-meter-track {
    flex: 1;
  }

  .reset-figure-sub {
    font-size: var(--text-label-size);
    color: var(--ink-secondary);
  }

  /* Run energy toward the next isotope, in the isotopes' Cherenkov blue
     (DESIGN.md, Reactor-Ramp Exception), on the badge's scale. */
  .isotope-meter-track {
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--line);
    overflow: hidden;
  }

  .isotope-meter-fill {
    width: 100%;
    height: 100%;
    background-color: var(--ramp-blue);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 500ms linear;
  }

  /* Under the figures: what the reset unlocks, its rungs in the isotopes'
     blue. */
  .reset-card-foot {
    display: contents;
  }

  .reset-card-foot .btn {
    grid-area: button;
  }

  .reset-unlocks {
    grid-area: unlocks;
    margin-block-start: var(--space-md);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--line-subtle);
    font-size: var(--text-label-size);
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  .reset-unlocks :global(.rung-name) {
    font-weight: 600;
    color: var(--ramp-blue);
  }

  @container reset-panel (max-width: 560px) {
    .reset-card {
      padding: var(--space-md);
    }

    .reset-figures,
    .reset-figures.is-open {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .reset-figure-meter,
    .reset-figures:not(.is-open) .reset-figure {
      grid-column: 1 / -1;
    }

    .reset-card,
    .reset-card:has(.btn[hidden]) {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'figures'
        'unlocks'
        'button';
    }

    .reset-card-foot .btn {
      width: 100%;
      margin-block-start: var(--space-md);
    }
  }

  /* The isotope track: a card per rung in rows of three, as the track runs,
     every third a fork with its two options side by side. Held rungs are
     lit like the badge's bead, in the isotopes' blue (DESIGN.md,
     Reactor-Ramp Exception); the next two wear a blue rim; the rest are
     dashed with only their number, like the codex's undiscovered perks. The
     script builds the cards, so their rules are global under the grid. */
  .track-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .track-grid :global(.track-card) {
    grid-column: span 3;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-sm) var(--space-md) 10px;
    border: 1px solid var(--card-line);
    border-radius: var(--card-radius);
    background-color: var(--card-bg);
  }

  .track-grid :global(.track-card.is-next) {
    border-color: color-mix(in srgb, var(--ramp-blue) 45%, var(--line));
  }

  .track-grid :global(.track-card[data-fork]) {
    grid-column: span 6;
  }

  /* Still hidden: a small dashed socket, its number under it. */
  .track-grid :global(.track-card.is-hidden) {
    grid-column: span 1;
    align-items: center;
    padding: 6px 2px;
    border-style: dashed;
    border-color: var(--line);
    background-color: transparent;
  }

  .track-grid :global(.track-card.is-hidden .track-card-head) {
    flex-direction: column;
    gap: 4px;
  }

  /* Socket, number and name on one line; "Next" at its end. */
  .track-grid :global(.track-card-head) {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: var(--space-sm);
    min-height: 22px;
  }

  .track-grid :global(.track-card-num) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-secondary);
  }

  .track-grid :global(.is-lit .track-card-num) {
    color: var(--ink-primary);
  }

  .track-grid :global(.track-card-tag) {
    margin-inline-start: auto;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ramp-blue);
  }

  .track-grid :global(.track-card-name) {
    min-width: 0;
    font-size: var(--text-label-size);
    font-weight: 600;
    color: var(--ink-primary);
  }

  .track-grid :global(.track-card-detail) {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  /* A fork: its socket, number and any "Next" down the side, its options
     beside them. */
  .track-grid :global(.track-card[data-fork]:not(.is-hidden)) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-sm);
    padding: var(--space-sm);
  }

  .track-grid :global(.track-card-side) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding-block-start: 2px;
  }

  .track-grid :global(.track-card-side .track-card-tag) {
    margin: 0;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .track-grid :global(.track-card-body) {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
  }

  /* A fork's two options. The pick is lit, with a dot so it never rests on
     color alone; the other stays readable, since a reset can switch to it. */
  .track-grid :global(.track-options) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .track-grid :global(.track-option) {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
    padding: 6px var(--space-sm);
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-sm);
  }

  .track-grid :global(.track-option.is-picked) {
    border-color: color-mix(in srgb, var(--ramp-blue) 55%, transparent);
    background-color: color-mix(in srgb, var(--ramp-blue) 8%, var(--panel-03));
  }

  .track-grid :global(.track-option.is-picked .track-card-name::before) {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-inline-end: 6px;
    border-radius: var(--radius-full);
    background-color: var(--ramp-blue);
    vertical-align: middle;
  }

  .track-grid :global(.is-lit .track-option:not(.is-picked) .track-card-name) {
    color: var(--ink-secondary);
  }

  /* Narrower: each rung revealed across the panel, the hidden ones six
     sockets to a row. */
  @container reset-panel (max-width: 560px) {
    .track-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .track-grid :global(.track-card),
    .track-grid :global(.track-card[data-fork]) {
      grid-column: 1 / -1;
    }

    .track-grid :global(.track-card.is-hidden) {
      grid-column: span 1;
    }
  }

  /* A rung's socket, as on the badge: a bead when held, a fork in two halves
     with the pick lit. */
  .track :global(.track-gem) {
    display: flex;
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    border: 1px dashed var(--line);
    border-radius: var(--radius-full);
    background-color: var(--panel-02);
    overflow: hidden;
  }

  .track :global([data-fork] .track-gem) {
    width: 22px;
    height: 22px;
  }

  .track :global(.track-half) {
    flex: 1;
  }

  .track :global(.track-half + .track-half) {
    border-inline-start: 1px dashed var(--line);
  }

  /* Held: lit like a bead. A fork held lights its rim and the half picked. */
  .track :global(.is-lit .track-gem),
  .track :global(.track-half.is-picked) {
    background: radial-gradient(
      circle at 35% 35%,
      #fff 0,
      var(--ramp-white) 35%,
      var(--ramp-blue) 100%
    );
  }

  .track :global(.is-lit .track-gem) {
    border: 0;
    box-shadow: 0 0 6px color-mix(in srgb, var(--ramp-blue) 70%, transparent);
  }

  .track :global(.is-lit[data-fork] .track-gem) {
    border: 1px solid var(--ramp-blue);
    background: var(--panel-02);
  }

  .track :global(.is-lit[data-fork] .track-half + .track-half) {
    border-inline-start: 1px solid color-mix(in srgb, var(--ramp-blue) 60%, transparent);
  }

  /* The next two: a solid rim in the isotopes' blue, still empty. */
  .track :global(.is-next .track-gem) {
    border-style: solid;
    border-color: color-mix(in srgb, var(--ramp-blue) 55%, var(--line));
  }

  .track :global(.is-next .track-half + .track-half) {
    border-inline-start-style: solid;
    border-inline-start-color: color-mix(in srgb, var(--ramp-blue) 40%, var(--line));
  }

  /* What a reset does: Wiped and Kept as the reset dialog has them, a label
     column and a value column, at the panel's text size. */
  .reset-terms.prestige-terms {
    margin: 0;
    font-size: var(--text-label-size);
    line-height: 1.6;
  }

  .reset-terms.prestige-terms > div {
    grid-template-columns: 3.5rem minmax(0, 1fr);
  }

  /* --- Buttons and dialogs ---------------------------------------------------------- */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    font-size: var(--text-label-size);
    font-weight: 600;
    transition: all var(--duration-fast) var(--ease);
  }

  .btn-primary {
    background-color: var(--signal-green);
    border-color: var(--signal-green);
    color: var(--chassis-black);
  }

  .btn-primary:hover {
    background-color: var(--signal-green-deep);
    border-color: var(--signal-green-deep);
    transform: translateY(-1px);
    box-shadow:
      0 0 20px rgb(34 197 94 / 20%),
      0 0 40px rgb(34 197 94 / 20%);
  }

  .btn-secondary {
    border-color: var(--line);
    background: transparent;
    color: var(--ink-primary);
  }

  .btn-secondary:hover {
    background-color: var(--panel-hover);
    border-color: var(--ink-muted);
  }

  /* Mirrors ResetModal.astro so the three dialogs read as one component. */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
    background-color: rgb(0 0 0 / 70%);
    backdrop-filter: blur(4px);
  }

  .modal {
    width: 100%;
    max-width: 400px;
    padding: var(--space-xl);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background-color: var(--panel-02);
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 40%),
      0 4px 6px -4px rgb(0 0 0 / 30%);
    text-align: center;
  }

  .modal-title {
    margin-block-end: var(--space-md);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .modal-message {
    margin-block-end: var(--space-xl);
    font-size: var(--text-label-size);
    line-height: 1.7;
    color: var(--ink-secondary);
  }

  .modal-message .readout {
    color: var(--ink-primary);
    font-weight: 700;
  }

  .modal-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
  }

  /* The reset dialog grows with the isotope track, so it is built to stay
     short (SPACEBAR-CLICKER.md §8.5.17): the numbers as tiles, what a reset
     does in three lines, a new fork's pick as cards, a kept perk as chips,
     and the forks picked before as switches. The body scrolls inside itself
     on a short screen while the buttons stay pinned under it. */
  .reset-dialog {
    display: flex;
    flex-direction: column;
    max-width: 480px;
    max-height: calc(100dvh - 2 * var(--space-lg));
    padding: 0;
    overflow: hidden;
    text-align: start;
  }

  .reset-body {
    flex: 1;
    min-height: 0;
    padding: var(--space-xl) var(--space-xl) var(--space-lg);
    overflow-y: auto;
  }

  .reset-body .modal-title {
    text-align: center;
  }

  .reset-foot {
    padding: var(--space-md) var(--space-xl) var(--space-lg);
    border-block-start: 1px solid var(--line);
  }

  .reset-sum {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    margin: 0;
  }

  .reset-sum .readout {
    color: var(--ink-primary);
  }

  /* Each tile: the label, the value, then a line under it. */
  .reset-tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    background-color: var(--panel-03);
  }

  .reset-tile dt {
    font-size: var(--text-label-size);
    color: var(--ink-secondary);
  }

  .reset-tile dd {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: auto 0 0;
  }

  .reset-tile-value {
    height: calc(var(--text-headline-size) * 1.2);
    font-size: var(--text-headline-size);
    font-weight: 700;
    line-height: 1.2;
  }

  .reset-tile-sub {
    font-size: var(--text-label-size);
    color: var(--ink-secondary);
  }

  /* Wiped, Kept and the head start: a label column and a value column. */
  .reset-terms {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin: var(--space-md) 0 0;
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .reset-terms > div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-sm);
  }

  .reset-terms dt {
    color: var(--ink-muted);
  }

  .reset-terms dd {
    margin: 0;
    color: var(--ink-secondary);
  }

  .reset-choices {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-block-start: var(--space-lg);
  }

  .reset-choices:empty,
  .reset-choices :global(#sc-reset-keep:empty) {
    display: none;
  }

  .reset-choices :global(.reset-group) {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .reset-choices :global(.reset-group-title) {
    margin-block-end: 6px;
    padding: 0;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ramp-blue);
  }

  /* The forks picked before are a quieter group than a pick to make. */
  .reset-choices :global(.reset-group.is-quiet .reset-group-title) {
    color: var(--ink-muted);
  }

  .reset-choices :global(.reset-group-head) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .reset-choices :global(.reset-group-note) {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .reset-choices :global(.reset-unlocks) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Set at the detail's size, so a wrapped line keeps the detail's leading. */
  .reset-choices :global(.reset-unlocks li) {
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .reset-choices :global(.reset-options) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  /* An option is a card with a radio's dot top-right: filled when picked,
     so the pick never rests on color alone. The chips and the switches below
     follow the same rule. */
  .reset-choices :global(.reset-option) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-sm) calc(var(--space-md) + 16px) var(--space-sm) var(--space-md);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--panel-03);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease);
  }

  .reset-choices :global(.reset-option::after),
  .reset-choices :global(.reset-chip::after),
  .reset-choices :global(.reset-keep-none::before) {
    content: '';
    width: 10px;
    height: 10px;
    border: 1px solid var(--ink-muted);
    border-radius: var(--radius-full);
  }

  .reset-choices :global(.reset-option::after) {
    position: absolute;
    inset-block-start: 10px;
    inset-inline-end: 10px;
  }

  .reset-choices :global(.reset-option:hover),
  .reset-choices :global(.reset-chip:hover),
  .reset-choices :global(.reset-keep-none:hover) {
    border-color: var(--ink-muted);
  }

  .reset-choices :global(.reset-option:has(input:checked)),
  .reset-choices :global(.reset-chip:has(input:checked)),
  .reset-choices :global(.reset-keep-none:has(input:checked)) {
    border-color: var(--ramp-blue);
    background-color: color-mix(in srgb, var(--ramp-blue) 8%, var(--panel-03));
  }

  .reset-choices :global(.reset-option:has(input:checked)::after),
  .reset-choices :global(.reset-chip:has(input:checked)::after),
  .reset-choices :global(.reset-keep-none:has(input:checked)::before) {
    border-color: var(--ramp-blue);
    background-color: var(--ramp-blue);
    box-shadow: inset 0 0 0 2px var(--panel-03);
  }

  .reset-choices :global(.reset-option:has(input:focus-visible)),
  .reset-choices :global(.reset-chip:has(input:focus-visible)),
  .reset-choices :global(.reset-keep-none:has(input:focus-visible)),
  .reset-choices :global(.reset-seg-option:has(input:focus-visible)) {
    outline: 2px solid var(--ramp-blue);
    outline-offset: 2px;
  }

  .reset-choices :global(.reset-option input),
  .reset-choices :global(.reset-chip input),
  .reset-choices :global(.reset-keep-none input),
  .reset-choices :global(.reset-seg-option input) {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .reset-choices :global(.reset-option-name) {
    font-size: var(--text-label-size);
    font-weight: 600;
    color: var(--ink-primary);
  }

  .reset-choices :global(.reset-option-detail) {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  /* The perk Heirloom or Cornerstone keeps. The legend and "Keep none" float
     on one line, as a legend can't be a flex item in every browser. */
  .reset-choices :global(.reset-keep-group > legend) {
    float: inline-start;
    margin-block: 6px 0;
  }

  .reset-choices :global(.reset-keep-none) {
    position: relative;
    display: flex;
    float: inline-end;
    align-items: center;
    gap: 6px;
    min-height: 26px;
    padding: 0 10px 0 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    color: var(--ink-secondary);
    cursor: pointer;
  }

  .reset-choices :global(.reset-keep-note) {
    clear: both;
    padding-block: 4px var(--space-sm);
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--ink-secondary);
  }

  .reset-choices :global(.reset-chips) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }

  .reset-choices :global(.reset-chip) {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 5px 28px 5px 5px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--panel-03);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease);
  }

  .reset-choices :global(.reset-chip::after) {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 10px;
    translate: 0 -50%;
  }

  .reset-choices :global(.reset-chip .perk-tile) {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-sm);
  }

  .reset-choices :global(.reset-chip .perk-tile svg) {
    width: 18px;
    height: 18px;
  }

  .reset-choices :global(.reset-chip-name) {
    overflow: hidden;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink-primary);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .reset-choices :global(.reset-chip-level) {
    font-weight: 500;
    color: var(--ink-muted);
  }

  /* The forks picked before: "At 3", then a two-way switch, the names only.
     What each rung does shows in a tooltip on hover or keyboard focus. */
  .reset-choices :global(.reset-picks) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .reset-choices :global(.reset-pick) {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .reset-choices :global(.reset-pick > legend) {
    float: inline-start;
    width: 2.75rem;
    padding: 0;
    font-size: 0.75rem;
    line-height: 36px;
    color: var(--ink-muted);
  }

  .reset-choices :global(.reset-pick > legend b) {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--ink-secondary);
  }

  .reset-choices :global(.reset-seg) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3px;
    margin-inline-start: calc(2.75rem + var(--space-sm));
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--panel-01);
  }

  .reset-choices :global(.reset-seg-option) {
    position: relative;
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 28px;
    padding: 0 6px;
    border-radius: calc(var(--radius-md) - 2px);
    font-size: 0.8125rem;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease);
  }

  .reset-choices :global(.reset-seg-option:hover) {
    background-color: var(--panel-hover);
    color: var(--ink-secondary);
  }

  .reset-choices :global(.reset-seg-option:has(input:checked)) {
    background-color: color-mix(in srgb, var(--ramp-blue) 14%, var(--panel-03));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ramp-blue) 55%, transparent);
    color: var(--ink-primary);
    font-weight: 600;
  }

  /* The picked half's dot, so the pick never rests on color alone. */
  .reset-choices :global(.reset-seg-option:has(input:checked)::before) {
    content: '';
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--ramp-blue);
  }

  .reset-choices :global(.reset-seg-name) {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* Over the dialog, above the switch it describes (below it if there is no
     room), in the isotopes' blue like their tooltips. Its padding bridges the
     gap, so the pointer can cross onto it. */
  .pick-tip {
    position: absolute;
    z-index: 1;
    width: max-content;
    max-width: min(260px, calc(100vw - 32px));
    padding-block-end: 8px;
  }

  .pick-tip.is-below {
    padding-block: 8px 0;
  }

  .pick-tip-box {
    position: relative;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid color-mix(in srgb, var(--ramp-blue) 55%, var(--line));
    border-radius: var(--radius-md);
    background-color: var(--panel-01);
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 40%),
      0 4px 6px -4px rgb(0 0 0 / 30%);
  }

  .pick-tip-box::after {
    content: '';
    position: absolute;
    inset-block-end: -5px;
    inset-inline-start: calc(var(--caret, 50%) - 5px);
    width: 8px;
    height: 8px;
    border-block-end: 1px solid color-mix(in srgb, var(--ramp-blue) 55%, var(--line));
    border-inline-end: 1px solid color-mix(in srgb, var(--ramp-blue) 55%, var(--line));
    background-color: var(--panel-01);
    transform: rotate(45deg);
  }

  .pick-tip.is-below .pick-tip-box::after {
    inset-block: -5px auto;
    transform: rotate(225deg);
  }

  .pick-tip-name {
    font-size: var(--text-label-size);
    font-weight: 600;
    color: var(--ink-primary);
  }

  .pick-tip-detail {
    margin-block-start: 2px;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--ink-secondary);
  }

  .reset-pick-hint {
    margin-block-end: var(--space-sm);
    font-size: var(--text-label-size);
    font-weight: 600;
    text-align: center;
    color: var(--caution-amber);
  }

  /* On a phone: narrower margins, a new fork's cards stacked, chip names on
     up to two lines, and both buttons on one row, Reset and collect taking
     the rest of it. */
  @media (max-width: 480px) {
    .reset-body {
      padding: var(--space-lg) 1.25rem var(--space-md);
    }

    .reset-foot {
      padding: var(--space-md) 1.25rem;
    }

    .reset-foot .modal-actions {
      gap: var(--space-sm);
    }

    .reset-foot .btn {
      padding-inline: var(--space-md);
