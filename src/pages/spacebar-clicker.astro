---
import { getEntry, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import ShopIcon from '../components/games/ShopIcon.astro';
import RelatedTools from '../components/tool/RelatedTools.astro';
import ResetModal from '../components/tool/ResetModal.astro';
import {
  ACHIEVEMENTS,
  AUTO_TAPPERS,
  PRESS_UPGRADES,
  PRESTIGE_UNLOCK,
  REACTOR_STATES,
} from '../games/spacebar-clicker/config';
import '../styles/content.css';
import '../styles/instrument.css';

// A game page, not a tool page: it is in the registry (sidebar, cross-links,
// sitemap) with `telemetry: false`, so no rig and no top-bar readout. The game
// keeps its own save and its own HUD. See src/scripts/spacebar-clicker.ts.

// Authored for the primary keyword "spacebar clicker". No "| ReflexLab" suffix.
const TITLE = 'Spacebar Clicker - Free Online Idle Spacebar Game';
const DESCRIPTION =
  'Play Spacebar Clicker free. Every press charges the reactor, upgrades and auto-tappers do the rest, and a steady rhythm earns up to 3x. No ads, saves in your browser.';

const entry = await getEntry('tools', 'spacebar-clicker');
if (!entry) throw new Error('Missing tools/spacebar-clicker content entry');
const { Content } = await render(entry);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entry.data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const whole = (v: number) => v.toLocaleString('en-US');

// The dial around the core, in its SVG's 100-unit box. The progress arc sits
// just outside the core; beyond it, one indicator light per reactor state past
// Dormant, spaced evenly clockwise from the top (the SVG is turned -90deg, so
// angle 0 is twelve o'clock). The script reads the arc length from the circle.
const ARC_R = 41;
const ARC_LEN = Number((2 * Math.PI * ARC_R).toFixed(2));
const LED_R = 45.5;
// The core's bezel: a dashed ring the script turns at a speed tied to energy
// per second. The dash period divides the circumference exactly, so the ring
// has no seam where the dashes meet.
const BEZEL_R = 49.5;
const BEZEL_SEGMENTS = 60;
const bezelPeriod = (2 * Math.PI * BEZEL_R) / BEZEL_SEGMENTS;
const BEZEL_DASH = `${(bezelPeriod * 0.4).toFixed(3)} ${(bezelPeriod * 0.6).toFixed(3)}`;

// Motes orbiting inside the core, more of them at each stage (CSS hides the
// rest). Spread by a fixed formula rather than Math.random, so the build is
// stable: radius as a fraction of the core, period, start angle, direction.
const MOTES = Array.from({ length: 12 }, (_, i) => ({
  rf: (0.2 + ((i * 7) % 12) * 0.022).toFixed(3),
  dur: `${(7 + ((i * 5) % 9) * 0.9).toFixed(1)}s`,
  start: `${(i * 137.5) % 360}deg`,
  size: `${i % 3 === 0 ? 3 : 2}px`,
  dir: i % 4 === 3 ? 'reverse' : 'normal',
}));

const dialLeds = REACTOR_STATES.slice(1).map((s, i, all) => {
  const angle = (i / all.length) * 2 * Math.PI;
  return {
    id: s.id,
    x: Number((50 + LED_R * Math.cos(angle)).toFixed(2)),
    y: Number((50 + LED_R * Math.sin(angle)).toFixed(2)),
  };
});
---

<BaseLayout
  title={TITLE}
  description={DESCRIPTION}
  path="/spacebar-clicker"
  topbarLabel="Spacebar Clicker"
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <button slot="controls" type="button" class="ctl" id="sound-toggle" aria-label="Toggle sound">
    <span class="ctl-icon" id="sound-icon-on">
      <Icon name="ph:speaker-high" width={18} height={18} aria-hidden="true" />
    </span>
    <span class="ctl-icon" id="sound-icon-off" hidden>
      <Icon name="ph:speaker-slash" width={18} height={18} aria-hidden="true" />
    </span>
  </button>
  <button slot="controls" type="button" class="ctl" id="reset-btn" aria-label="Reset all progress">
    <Icon name="ph:trash" width={18} height={18} aria-hidden="true" />
    <span>Reset</span>
  </button>

  <!-- ========== HERO ========== -->
  <section class="hero-section">
    <div class="hero-content">
      <h1 class="hero-title">Spacebar Clicker</h1>
      <p class="hero-subtitle">
        Press space to feed the reactor. Buy upgrades, hire auto-tappers, and hold a steady rhythm
        for up to 3x energy. Your progress saves in this browser.
      </p>
    </div>
  </section>

  <!-- ========== GAME ========== -->
  <section id="game-section" class="game-section">
    <div class="game-card">
      <div class="game-grid">
        <!-- The reactor face: the instrument the whole game is played on. -->
        <div
          id="sc-reactor"
          class="test-area reactor-face"
          data-state="dormant"
          tabindex="0"
          role="button"
          aria-label="Reactor. Press the spacebar, or tap here, to generate energy."
        >
          <!-- Stage change: the graticule lights in a band travelling out from the core. -->
          <div class="grid-wash" id="sc-wash" aria-hidden="true"></div>

          <!-- The trophy shelf: one pellet per isotope (up to ten shown), kept
               across every reset of the experiment. -->
          <div class="isotope-shelf" id="sc-shelf" role="img" aria-label="No isotopes yet" hidden>
            <span class="pellets" id="sc-pellets"></span>
            <span class="shelf-more readout" id="sc-shelf-more" hidden></span>
          </div>

          <div class="energy-block">
            <p class="energy-row">
              <span class="energy-value readout" id="sc-energy">0</span>
              <span class="energy-unit">energy</span>
            </p>
            <p class="energy-rates">
              <span><span class="readout" id="sc-eps">0.0</span> per second</span>
              <span><span class="readout" id="sc-epp">1</span> per press</span>
            </p>
          </div>

          <div class="core-wrap">
            <!-- The dial: progress to the next state as an arc, and one light per
                 state reached, so the run's history reads at a glance. -->
            <svg class="core-arc" viewBox="0 0 100 100" aria-hidden="true">
              <circle class="arc-track" cx="50" cy="50" r={ARC_R}></circle>
              <circle
                class="arc-fill"
                id="sc-arc"
                cx="50"
                cy="50"
                r={ARC_R}
                stroke-dasharray={ARC_LEN}
                stroke-dashoffset={ARC_LEN}></circle>
              {
                dialLeds.map((led) => (
                  <g class={`dial-led led-${led.id}`} data-led={led.id}>
                    <circle class="led-halo" cx={led.x} cy={led.y} r="3.4" />
                    <circle class="led-dot" cx={led.x} cy={led.y} r="1.5" />
                  </g>
                ))
              }
            </svg>
            <span class="shockwave" id="sc-shockwave" aria-hidden="true"></span>
            <div class="core" id="sc-core" data-state="dormant" aria-hidden="true">
              <svg class="core-bezel" id="sc-bezel" viewBox="0 0 100 100" aria-hidden="true">
                <circle cx="50" cy="50" r={BEZEL_R} stroke-dasharray={BEZEL_DASH}></circle>
              </svg>
              <span class="core-ring core-ring-inner"></span>
              <span class="motes" aria-hidden="true">
                {
                  MOTES.map((m) => (
                    <span
                      class="mote"
                      style={`--rf:${m.rf};--dur:${m.dur};--start:${m.start};--size:${m.size};--dir:${m.dir}`}
                    />
                  ))
                }
              </span>
              <span class="core-heart"></span>
              <!-- Surge (spec §5): the countdown, then the live rate, read from the core. -->
              <span class="core-readout">
                <span class="core-num readout" id="sc-core-num"></span>
                <span class="core-unit" id="sc-core-unit"></span>
              </span>
            </div>
            <div class="sparks" id="sc-sparks" aria-hidden="true"></div>
            <div class="floats" id="sc-floats" aria-hidden="true"></div>

            <!-- Surge results, laid over the core for a few seconds. The numbers
                 tally up; screen readers get the totals from the announcer. -->
            <div class="surge-card" id="sc-surge-summary" aria-hidden="true" hidden>
              <p class="surge-card-title">Surge over</p>
              <dl class="surge-stats">
                <div><dt>Presses</dt><dd class="readout" id="sc-surge-presses">0</dd></div>
                <div><dt>Per second</dt><dd class="readout" id="sc-surge-rate">0.0</dd></div>
                <div><dt>Energy</dt><dd class="readout" id="sc-surge-earned">0</dd></div>
              </dl>
              <p class="surge-best" id="sc-surge-best" hidden>
                <span aria-hidden="true">🏆</span> New best surge
              </p>
            </div>
          </div>

          <p class="state-label" id="sc-state-label">
            <span class="state-name" id="sc-state">Dormant</span>
            <span class="state-noun">reactor</span>
          </p>
          <p class="surge-label" id="sc-surge-label" hidden>Surge incoming</p>

          <div class="combo">
            <div class="combo-row">
              <span class="combo-count readout" id="sc-combo">0</span>
              <span class="combo-tier" id="sc-combo-tier">combo</span>
              <span class="combo-next" id="sc-combo-next">10 to Steady</span>
              <span class="combo-mult readout" id="sc-combo-mult">x1</span>
            </div>
            <div class="combo-track" role="presentation">
              <div class="combo-fill" id="sc-combo-fill"></div>
            </div>
            <!-- The rhythm scope: one spike per press, scrolling left. Even
                 spacing is a steady beat; off-beat presses draw half height. -->
            <canvas class="rhythm-scope" id="sc-scope" aria-hidden="true"></canvas>
          </div>

          <p class="test-hint" id="sc-hint">
            Press the spacebar to generate energy. Keep a steady beat to build a combo.
          </p>
          <p class="keycap" id="sc-keycap" aria-hidden="true">space</p>

          <div class="toast" id="sc-toast" hidden>
            <span id="sc-toast-text"></span>
          </div>

          <p class="visually-hidden" id="sc-announce" aria-live="polite"></p>
        </div>

        <!-- Shop (spec §6), rendered from the rulebook so the first paint is right. -->
        <aside class="shop" aria-labelledby="shop-heading">
          <h2 class="shop-heading" id="shop-heading">Shop</h2>

          <!-- Two tabs, styled like the site's setting buttons. A closed tab that
               gains something (a newly revealed auto-tapper, or an item newly
               affordable at its current price) wears an amber "New" tag until
               it is opened (DESIGN.md, the Shop-Signal Exception). -->
          <div class="shop-tabs" role="tablist" aria-label="Shop sections">
            <button
              type="button"
              class="tab shop-tab"
              role="tab"
              id="sc-shop-tab-press"
              data-shop-tab="press"
              aria-selected="true"
              aria-controls="sc-shop-press"
            >
              Upgrades
              <span class="shop-new-tag" id="sc-new-press" hidden>
                <span aria-hidden="true">New</span>
                <span class="visually-hidden">, new items</span>
              </span>
            </button>
            <button
              type="button"
              class="tab shop-tab"
              role="tab"
              id="sc-shop-tab-auto"
              data-shop-tab="auto"
              aria-selected="false"
              aria-controls="sc-shop-auto"
              tabindex="-1"
            >
              Auto-tappers
              <span class="shop-new-tag" id="sc-new-auto" hidden>
                <span aria-hidden="true">New</span>
                <span class="visually-hidden">, new items</span>
              </span>
            </button>
          </div>

          <div
            class="shop-panel"
            id="sc-shop-press"
            role="tabpanel"
            aria-labelledby="sc-shop-tab-press"
          >
            <ul class="shop-list">
              {
                PRESS_UPGRADES.map((u) => (
                  <li class="shop-item" data-kind="press" data-id={u.id}>
                    <button type="button" class="shop-buy" aria-disabled="true">
                      <span class="shop-icon">
                        <ShopIcon id={u.id} />
                      </span>
                      <span class="shop-text">
                        <span class="shop-name">{u.name}</span>
                        <span class="shop-detail">{u.detail}</span>
                      </span>
                      <span class="shop-nums">
                        <span class="shop-cost readout" data-cost>
                          {whole(u.baseCost)}
                        </span>
                        <span class="shop-level readout" data-level>
                          {u.max === 1 ? '' : `0/${u.max}`}
                        </span>
                      </span>
                    </button>
                  </li>
                ))
              }
            </ul>
          </div>

          <div
            class="shop-panel"
            id="sc-shop-auto"
            role="tabpanel"
            aria-labelledby="sc-shop-tab-auto"
            hidden
          >
            <ul class="shop-list">
              {
                AUTO_TAPPERS.map((t, i) => (
                  <li class="shop-item" data-kind="auto" data-id={t.id} hidden={i > 0}>
                    <button type="button" class="shop-buy" aria-disabled="true">
                      <span class="shop-icon">
                        <ShopIcon id={t.id} />
                      </span>
                      <span class="shop-text">
                        <span class="shop-name">{t.name}</span>
                        <span class="shop-detail">
                          {t.detail}. <span class="readout">{t.eps}</span> per second each.
                        </span>
                      </span>
                      <span class="shop-nums">
                        <span class="shop-cost readout" data-cost>
                          {whole(t.baseCost)}
                        </span>
                        <span class="shop-level readout">
                          <span data-owned>0</span> owned
                        </span>
                      </span>
                    </button>
                  </li>
                ))
              }
            </ul>
            <p class="shop-hint" id="sc-shop-hidden-hint">
              More auto-tappers appear as the reactor earns.
            </p>
          </div>
        </aside>
      </div>

      <!-- Stats, achievements, prestige (spec §9–11) behind tabs. -->
      <div class="panels">
        <div class="tabs" role="tablist" aria-label="Game panels">
          <button
            type="button"
            class="tab"
            role="tab"
            id="sc-tab-stats"
            data-tab="stats"
            aria-selected="true"
            aria-controls="sc-panel-stats">Stats</button
          >
          <button
            type="button"
            class="tab"
            role="tab"
            id="sc-tab-achievements"
            data-tab="achievements"
            aria-selected="false"
            aria-controls="sc-panel-achievements"
            tabindex="-1">Achievements</button
          >
          <button
            type="button"
            class="tab"
            role="tab"
            id="sc-tab-prestige"
            data-tab="prestige"
            aria-selected="false"
            aria-controls="sc-panel-prestige"
            tabindex="-1">Reset the experiment</button
          >
        </div>

        <div class="panel" id="sc-panel-stats" role="tabpanel" aria-labelledby="sc-tab-stats">
          <dl class="stats">
            <div><dt>Total presses</dt><dd class="readout" id="sc-stat-presses">0</dd></div>
            <div><dt>Energy this run</dt><dd class="readout" id="sc-stat-run">0</dd></div>
            <div><dt>Energy all time</dt><dd class="readout" id="sc-stat-lifetime">0</dd></div>
            <div><dt>Energy per second</dt><dd class="readout" id="sc-stat-eps">0.0</dd></div>
            <div><dt>Energy per press</dt><dd class="readout" id="sc-stat-epp">1</dd></div>
            <div><dt>Best combo</dt><dd class="readout" id="sc-stat-best-combo">0</dd></div>
            <div>
              <dt>Best surge, per second</dt><dd class="readout" id="sc-stat-best-surge">—</dd>
            </div>
            <div><dt>Isotopes</dt><dd class="readout" id="sc-stat-isotopes">0</dd></div>
            <div><dt>Experiments reset</dt><dd class="readout" id="sc-stat-prestiges">0</dd></div>
            <div><dt>Time played</dt><dd class="readout" id="sc-stat-played">0s</dd></div>
          </dl>
        </div>

        <div
          class="panel"
          id="sc-panel-achievements"
          role="tabpanel"
          aria-labelledby="sc-tab-achievements"
          hidden
        >
          <p class="panel-intro">
            <span class="readout" id="sc-ach-count">0 of {ACHIEVEMENTS.length}</span> unlocked
          </p>
          <ul class="achievements">
            {
              ACHIEVEMENTS.map((a) => (
                <li class="achievement" data-id={a.id}>
                  <span class="achievement-mark" aria-hidden="true">
                    ✗
                  </span>
                  <span class="achievement-text">
                    <span class="achievement-name">{a.name}</span>
                    <span class="achievement-detail">{a.detail}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="panel"
          id="sc-panel-prestige"
          role="tabpanel"
          aria-labelledby="sc-tab-prestige"
          hidden
        >
          <div class="prestige">
            <p class="prestige-copy">
              Resetting the experiment wipes your energy, upgrades, auto-tappers and reactor state.
              In return you keep isotopes, and each one adds 10% to every gain from then on. You
              hold <span class="readout" id="sc-isotopes">0</span> isotopes, worth
              <span class="readout" id="sc-isotope-bonus">+0%</span>.
            </p>
            <p class="prestige-locked" id="sc-prestige-locked">
              Unlocks at <span class="readout">{whole(PRESTIGE_UNLOCK)}</span> energy earned this run.
              You are at <span class="readout" id="sc-prestige-progress">0 of 1.00M</span>.
            </p>
            <div class="prestige-ready" id="sc-prestige-ready" hidden>
              <p class="prestige-gain-row">
                Resetting now gives <span class="prestige-gain readout" id="sc-prestige-gain"
                  >1</span
                > isotopes.
              </p>
              <button type="button" class="btn btn-primary" id="sc-prestige-btn"
                >Reset the experiment</button
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <ResetModal
      message="your energy, upgrades, auto-tappers, isotopes, achievements and stats. Sound settings stay"
    />

    <!-- Prestige confirm (spec §9: the player must confirm). -->
    <div
      class="modal-overlay"
      id="sc-prestige-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sc-prestige-modal-title"
      hidden
    >
      <div class="modal">
        <h3 class="modal-title" id="sc-prestige-modal-title">Reset the experiment?</h3>
        <p class="modal-message">
          Your energy, upgrades, auto-tappers and reactor state go back to zero. You gain
          <span class="readout" id="sc-prestige-modal-gain">1</span> isotopes and keep your achievements
          and records.
        </p>
        <div class="modal-actions">
          <button class="btn btn-secondary" id="sc-prestige-cancel" type="button">Keep going</button
          >
          <button class="btn btn-primary" id="sc-prestige-confirm" type="button"
            >Reset and collect</button
          >
        </div>
      </div>
    </div>

    <!-- Offline progress (spec §7). -->
    <div
      class="modal-overlay"
      id="sc-away-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sc-away-title"
      hidden
    >
      <div class="modal">
        <h3 class="modal-title" id="sc-away-title">While you were away</h3>
        <p class="modal-message">
          Your auto-tappers ran for <span class="readout" id="sc-away-time">0s</span> at half speed and
          made <span class="readout" id="sc-away-energy">0</span> energy.
        </p>
        <div class="modal-actions">
          <button class="btn btn-primary" id="sc-away-collect" type="button">Collect</button>
        </div>
      </div>
    </div>
  </section>

  <Content />

  <RelatedTools current="/spacebar-clicker" />
</BaseLayout>

<script>
  import '../scripts/spacebar-clicker';
</script>

<style>
  /* --- Top-bar controls (slot content, styled by the page) ---------------- */

  .ctl {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    color: var(--ink-secondary);
    font-size: var(--text-label-size);
  }

  .ctl:hover {
    background-color: var(--panel-hover);
    color: var(--ink-primary);
  }

  .ctl.muted {
    color: var(--ink-muted);
  }

  .ctl-icon {
    display: inline-flex;
  }

  /* --- Hero ----------------------------------------------------------------- */

  .hero-section {
    padding: var(--space-xl) 0 var(--space-md);
    text-align: center;
  }

  .hero-content {
    max-width: 620px;
    margin-inline: auto;
  }

  .hero-title {
    margin-block-end: var(--space-md);
    font-size: var(--text-display-size);
    font-weight: var(--text-display-weight);
    line-height: var(--text-display-lh);
    letter-spacing: var(--text-display-ls);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--ink-secondary);
  }

  /* --- Game card --------------------------------------------------------------- */

  .game-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    padding-block: var(--space-md) var(--space-2xl);
  }

  .game-card {
    display: flex;
    width: 100%;
    max-width: 960px;
    flex-direction: column;
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--line);
    border-radius: var(--radius-2xl);
    background-color: var(--panel-02);
  }

  /* Stretch, so the shop column is pinned to the reactor's height and the two
     read as one instrument; the shop scrolls inside itself if it must. */
  .game-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: var(--space-lg);
    align-items: stretch;
  }

  /* --- Reactor face ------------------------------------------------------------- */

  /* State is carried by custom properties set per data-state, so the core,
     dial, lights, gains and stage name all read one source.

     The Reactor-Ramp Exception (DESIGN.md): the reactor climbs a closed
     five-step ramp grounded in Cherenkov glow, the blue light of a working
     water-cooled reactor. Green, teal, cyan, Cherenkov blue, then blue-white
     at Supercritical. No red, no amber; every color change is paired with the
     stage name. Nothing flickers.

     The color properties are registered, so a stage change fades between
     colors rather than swapping. Without @property support they simply swap. */
  .reactor-face {
    container: reactor / inline-size;

    --ramp-green: #22c55e;
    --ramp-teal: #2dd4bf;
    --ramp-cyan: #22d3ee;
    --ramp-blue: #38bdf8;
    --ramp-white: #e0f2fe;
    /* Surge Gold: the reactor in overdrive. Lighter than Caution Amber, so it
       never reads as the shop's "New" tag. */
    --gold: #fcd34d;
    --gold-deep: #fbbf24;
    --gold-ink: #fef3c7;

    --stage: var(--ramp-green);
    /* The dial follows the stage, except while a surge counts down. */
    --dial: var(--stage);
    --halo: var(--ramp-green);
    --core-heart: color-mix(in srgb, var(--ramp-green) 45%, transparent);
    --core-alpha: 14%;
    --core-glow: 0px;
    --core-pulse: 0s;
    --stage-fade:
      --stage 800ms ease, --halo 800ms ease, --core-heart 800ms ease, --core-alpha 800ms ease,
      --core-glow 800ms ease;

    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 520px;
    padding: var(--space-lg);
    border: 2px solid var(--line);
    border-radius: var(--radius-xl);
    background-color: var(--panel-03);
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    cursor: pointer;
    transition:
      border-color var(--duration-base) var(--ease),
      box-shadow var(--duration-base) var(--ease),
      var(--stage-fade);
  }

  /* On first paint the saved stage applies without fading up from Dormant. */
  .reactor-face.is-booting {
    transition: none;
  }

  .reactor-face:focus-visible {
    outline: 2px solid var(--signal-green);
    outline-offset: 3px;
  }

  .reactor-face[data-state='warming'] {
    --core-alpha: 26%;
    --core-glow: 14px;
    --core-pulse: 3.2s;
  }
  .reactor-face[data-state='stable'] {
    --core-alpha: 40%;
    --core-glow: 22px;
    --core-pulse: 2.4s;
  }
  .reactor-face[data-state='charged'] {
    --stage: var(--ramp-teal);
    --halo: var(--ramp-teal);
    --core-heart: rgb(153 246 228 / 85%);
    --core-alpha: 55%;
    --core-glow: 30px;
    --core-pulse: 1.8s;
  }
  .reactor-face[data-state='unstable'] {
    --stage: var(--ramp-cyan);
    --halo: var(--ramp-cyan);
    --core-heart: rgb(165 243 252 / 90%);
    --core-alpha: 70%;
    --core-glow: 40px;
    --core-pulse: 1.3s;
  }
  .reactor-face[data-state='critical'] {
    --stage: var(--ramp-blue);
    --halo: var(--ramp-blue);
    --core-heart: rgb(186 230 253 / 95%);
    --core-alpha: 85%;
    --core-glow: 52px;
    --core-pulse: 0.95s;
  }
  /* Supercritical: a blue-white core inside a Cherenkov-blue halo. */
  .reactor-face[data-state='supercritical'] {
    --stage: var(--ramp-white);
    --halo: var(--ramp-blue);
    --core-heart: var(--ink-primary);
    --core-alpha: 100%;
    --core-glow: 68px;
    --core-pulse: 0.75s;
  }

  /* --- Surge phases (data-surge) ----------------------------------------------

     warning:  the core counts down 3, 2, 1, the dial drains in gold, and the
               border warms to gold over the three seconds.
     active:   overdrive. The core, halo, gains and dial run gold, the core
               reads the live rate, and the border glows (Glow-Is-A-Signal).
     summary:  the results card; the reactor fades back to its stage color. */

  .reactor-face[data-surge='warning'] {
    --dial: var(--gold);
    border-color: color-mix(in srgb, var(--gold) 75%, transparent);
    transition:
      border-color 3s linear,
      var(--stage-fade);
  }

  .reactor-face[data-surge='active'] {
    --stage: var(--gold);
    --halo: var(--gold-deep);
    --core-heart: var(--gold-ink);
    --dial: var(--gold);
    --core-alpha: 75%;
    --core-glow: 48px;
    --core-pulse: 0.6s;
    /* Into overdrive fast; the way back uses the stage's slower fade. */
    --stage-fade:
      --stage 250ms ease, --halo 250ms ease, --core-heart 250ms ease, --core-alpha 250ms ease,
      --core-glow 250ms ease;
    border-color: var(--gold);
    box-shadow:
      0 0 20px color-mix(in srgb, var(--gold) 22%, transparent),
      0 0 40px color-mix(in srgb, var(--gold) 14%, transparent);
  }

  /* The two hottest stages are already brighter than overdrive's floor. */
  .reactor-face[data-surge='active'][data-state='critical'] {
    --core-alpha: 85%;
    --core-glow: 52px;
  }
  .reactor-face[data-surge='active'][data-state='supercritical'] {
    --core-alpha: 100%;
    --core-glow: 68px;
  }

  .energy-block {
    z-index: 1;
    text-align: center;
  }

  .energy-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-sm);
    line-height: 1;
  }

  .energy-value {
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .energy-unit {
    font-size: var(--text-title-size);
    color: var(--ink-secondary);
  }

  .energy-rates {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    margin-block-start: var(--space-sm);
    font-size: var(--text-label-size);
    color: var(--ink-secondary);
  }

  .energy-rates .readout {
    color: var(--ink-primary);
  }

  /* The core: a disc of light inside two rings. Depth is tonal; the only
     shadow is the glow, which reports state. */
  .core-wrap {
    --core-size: 168px;

    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    /* Room for the dial and its lights outside the core. */
    padding: 26px 0;
  }

  /* The dial: the arc fills toward the next state; the lights record each
     state reached this run. */
  .core-arc {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: calc(var(--core-size) + 56px);
    height: calc(var(--core-size) + 56px);
    overflow: visible;
    transform: translate(-50%, -50%) rotate(-90deg);
    pointer-events: none;
    transition:
      opacity 900ms ease,
      filter 900ms ease;
  }

  .arc-track,
  .arc-fill {
    fill: none;
    stroke-width: 2.2;
  }

  .arc-track {
    stroke: var(--line);
  }

  .arc-fill {
    stroke: var(--dial);
    stroke-linecap: round;
    transition: stroke-dashoffset var(--duration-base) linear;
  }

  /* Stage reached: the arc snaps full and holds, then sweeps back to the
     start of the new stage. */
  .arc-fill.is-complete {
    transition-duration: 180ms;
  }

  .arc-fill.is-sweeping {
    transition: stroke-dashoffset 800ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .led-dot,
  .led-halo {
    stroke: none;
  }

  .led-dot {
    fill: var(--ink-disabled);
    transition: fill 400ms var(--ease);
  }

  .led-halo {
    fill: var(--led);
    opacity: 0;
    transition: opacity 400ms var(--ease);
  }

  /* Each light keeps the color of the state it marks, so a lit dial reads as
     the run's own ramp. */
  .led-warming,
  .led-stable {
    --led: var(--ramp-green);
  }
  .led-charged {
    --led: var(--ramp-teal);
  }
  .led-unstable {
    --led: var(--ramp-cyan);
  }
  .led-critical {
    --led: var(--ramp-blue);
  }
  .led-supercritical {
    --led: var(--ramp-white);
  }

  .dial-led.is-lit .led-dot {
    fill: var(--led);
  }

  .dial-led.is-lit .led-halo {
    opacity: 0.3;
  }

  .dial-led.is-new {
    transform-box: fill-box;
    transform-origin: center;
    animation: led-pop 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes led-pop {
    0% {
      transform: scale(2.6);
    }
    100% {
      transform: scale(1);
    }
  }

  /* One ring of light rolling out from the core on a stage change. */
  .shockwave {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: var(--core-size);
    height: var(--core-size);
    border: 2px solid var(--stage);
    border-radius: var(--radius-full);
    box-shadow:
      0 0 24px color-mix(in srgb, var(--stage) 40%, transparent),
      inset 0 0 24px color-mix(in srgb, var(--stage) 25%, transparent);
    opacity: 0;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .shockwave.is-firing {
    animation: shockwave 1000ms cubic-bezier(0.2, 0.6, 0.3, 1);
  }

  @keyframes shockwave {
    0% {
      opacity: 0.9;
      transform: translate(-50%, -50%) scale(0.9);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(3.4);
    }
  }

  /* The graticule lit in the stage color, masked to a soft band whose radius
     travels outward. The script centres it on the core. */
  .grid-wash {
    --wash-x: 50%;
    --wash-y: 45%;

    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--stage) 45%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--stage) 45%, transparent) 1px,
        transparent 1px
      );
    background-size: 32px 32px;
    background-position: center;
    opacity: 0;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(
      circle at var(--wash-x) var(--wash-y),
      transparent calc(var(--wash-r) - 140px),
      #000 calc(var(--wash-r) - 50px),
      transparent var(--wash-r)
    );
    mask-image: radial-gradient(
      circle at var(--wash-x) var(--wash-y),
      transparent calc(var(--wash-r) - 140px),
      #000 calc(var(--wash-r) - 50px),
      transparent var(--wash-r)
    );
  }

  .grid-wash.is-washing {
    animation: grid-wash 1100ms ease-out;
  }

  @keyframes grid-wash {
    0% {
      --wash-r: 0px;
      opacity: 1;
    }
    75% {
      opacity: 0.9;
    }
    100% {
      --wash-r: 760px;
      opacity: 0;
    }
  }

  .core {
    position: relative;
    width: var(--core-size);
    height: var(--core-size);
    border-radius: var(--radius-full);
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--stage) var(--core-alpha), transparent) 0%,
      color-mix(in srgb, var(--halo) calc(var(--core-alpha) * 0.45), transparent) 42%,
      transparent 72%
    );
    box-shadow:
      0 0 var(--core-glow) color-mix(in srgb, var(--halo) 25%, transparent),
      0 0 calc(var(--core-glow) * 2) color-mix(in srgb, var(--halo) 12%, transparent);
    animation: core-breathe var(--core-pulse) ease-in-out infinite;
    transition:
      opacity 900ms ease,
      filter 900ms ease;
  }

  /* --- Bezel and motes ---------------------------------------------------------- */

  /* A dashed bezel just inside the core's edge. The script turns it, faster
     as energy per second climbs; it holds still with no auto-tappers. */
  .core-bezel {
    position: absolute;
    inset: 0;
    overflow: visible;
    pointer-events: none;
  }

  .core-bezel circle {
    fill: none;
    stroke: color-mix(in srgb, var(--stage) 35%, var(--line));
    stroke-width: 0.9;
  }

  /* Faint particles orbiting inside the core: none while Dormant, two more
     with each stage, twelve at Supercritical. */
  .motes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .mote {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    display: none;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2);
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--stage) 70%, #fff);
    box-shadow: 0 0 6px color-mix(in srgb, var(--stage) 80%, transparent);
    opacity: 0.55;
    animation: mote-orbit var(--dur) linear infinite;
    animation-direction: var(--dir);
  }

  .reactor-face[data-state='warming'] .mote:nth-child(-n + 2),
  .reactor-face[data-state='stable'] .mote:nth-child(-n + 4),
  .reactor-face[data-state='charged'] .mote:nth-child(-n + 6),
  .reactor-face[data-state='unstable'] .mote:nth-child(-n + 8),
  .reactor-face[data-state='critical'] .mote:nth-child(-n + 10),
  .reactor-face[data-state='supercritical'] .mote {
    display: block;
  }

  @keyframes mote-orbit {
    from {
      transform: rotate(var(--start)) translateX(calc(var(--core-size) * var(--rf)));
    }
    to {
      transform: rotate(calc(var(--start) + 360deg)) translateX(calc(var(--core-size) * var(--rf)));
    }
  }

  /* --- Asleep (while you were away) and the reset sequence ------------------- */

  /* Asleep: the core and dial sit dim behind the "While you were away" dialog,
     then brighten over the same 0.9 s the energy takes to count in. */
  .reactor-face.is-asleep .core,
  .reactor-face.is-asleep .core-arc {
    opacity: 0.35;
    filter: saturate(0.3);
  }

  /* Reset the experiment: everything else on the face dims while the core
     collapses to a point; then it blooms back as Dormant. No flash. */
  .reactor-face
    > :is(.energy-block, .state-label, .surge-label, .combo, .test-hint, .keycap, .isotope-shelf) {
    transition: opacity 600ms ease;
  }

  .reactor-face.is-imploding
    > :is(.energy-block, .state-label, .surge-label, .combo, .test-hint, .keycap, .isotope-shelf) {
    opacity: 0.3;
    transition-duration: 400ms;
  }

  .reactor-face.is-imploding .core {
    animation: implode 500ms cubic-bezier(0.55, 0, 1, 0.45) forwards;
  }

  .reactor-face.is-blooming .core {
    animation: bloom 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes implode {
    0% {
      transform: scale(1);
    }
    25% {
      transform: scale(1.06);
    }
    100% {
      transform: scale(0.04);
    }
  }

  @keyframes bloom {
    0% {
      transform: scale(0.04);
    }
    100% {
      transform: scale(1);
    }
  }

  /* --- Isotope shelf ---------------------------------------------------------- */

  /* When the face is narrow (a phone, or a laptop with the shop beside it),
     the centred energy readout reaches under the shelf. Once there is a
     shelf, step the readout down clear of it. Keyed to the face's own width,
     not the screen's. */
  @container reactor (max-width: 520px) {
    .reactor-face:has(> .isotope-shelf:not([hidden])) .energy-block {
      padding-block-start: 0.875rem;
    }
  }

  .isotope-shelf {
    position: absolute;
    inset-block-start: 12px;
    inset-inline-start: 14px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    pointer-events: none;
  }

  .pellets {
    display: flex;
    gap: 4px;
  }

  /* An isotope: a small blue-white bead with the Cherenkov glow. */
  .pellets :global(.pellet),
  .reactor-face :global(.isotope-flyer) {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: radial-gradient(
      circle at 35% 35%,
      #fff 0,
      var(--ramp-white) 35%,
      var(--ramp-blue) 100%
    );
    box-shadow: 0 0 6px color-mix(in srgb, var(--ramp-blue) 70%, transparent);
  }

  .pellets :global(.pellet.is-pending) {
    opacity: 0;
  }

  .pellets :global(.pellet.is-landed) {
    animation: pellet-land 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes pellet-land {
    0% {
      transform: scale(1.8);
    }
  }

  .reactor-face :global(.isotope-flyer) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 3;
    pointer-events: none;
  }

  .shelf-more {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-secondary);
  }

  .core[data-state='dormant'] {
    animation: none;
  }

  .core-ring {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-full);
    border: 1px solid var(--line);
    pointer-events: none;
  }

  .core-ring-inner {
    inset: 22px;
    border-color: color-mix(in srgb, var(--stage) calc(var(--core-alpha) * 0.6), transparent);
  }

  .core-heart {
    position: absolute;
    inset: 50%;
    width: 18px;
    height: 18px;
    border-radius: var(--radius-full);
    background-color: var(--core-heart);
    transform: translate(-50%, -50%);
  }

  .core.is-pressed {
    animation: core-press 160ms var(--ease);
  }

  /* Reaching a new state: one larger snap as the glow steps up. */
  .core.is-stepped {
    animation: core-step 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes core-step {
    0% {
      transform: scale(1.18);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes core-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.04);
    }
  }

  @keyframes core-press {
    0% {
      transform: scale(1.08);
    }
    100% {
      transform: scale(1);
    }
  }

  .floats {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .floats :global(.float) {
    position: absolute;
    font-size: var(--text-title-size);
    font-weight: 700;
    color: var(--stage); /* a gain takes the reactor's current stage color */
    white-space: nowrap;
    transform: translate(-50%, -50%);
    animation: float-rise 720ms ease-out forwards;
  }

  @keyframes float-rise {
    0% {
      opacity: 0.95;
      transform: translate(-50%, -50%);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, calc(-50% - 72px));
    }
  }

  /* A lucky press (Double Tap): gold, with a small bounce before it rises. */
  .floats :global(.float.is-lucky) {
    color: var(--gold);
    text-shadow: 0 0 10px color-mix(in srgb, var(--gold) 55%, transparent);
    animation: lucky-rise 820ms cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
  }

  @keyframes lucky-rise {
    0% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(0.6);
    }
    18% {
      transform: translate(-50%, calc(-50% - 10px)) scale(1.25);
    }
    32% {
      transform: translate(-50%, calc(-50% - 16px)) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, calc(-50% - 84px)) scale(1);
    }
  }

  /* Idle income: small, dim, slow, drifting off the core's rim. */
  .floats :global(.float.is-idle) {
    font-size: var(--text-label-size);
    font-weight: 600;
    animation: idle-drift 1700ms ease-out forwards;
  }

  @keyframes idle-drift {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%);
    }
    20% {
      opacity: 0.5;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, calc(-50% - 40px));
    }
  }

  /* Overdrive gains: gold (via --stage) and larger, so the 10x reads at once. */
  .reactor-face[data-surge='active'] .floats :global(.float) {
    font-size: 1.375rem;
    text-shadow: 0 0 12px color-mix(in srgb, var(--gold) 55%, transparent);
  }

  /* --- Core readout (surge countdown and live rate) ------------------------- */

  .core-readout {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease);
  }

  .reactor-face[data-surge='warning'] .core-readout,
  .reactor-face[data-surge='active'] .core-readout {
    opacity: 1;
  }

  /* The readout takes the heart's place while it shows. */
  .core-heart {
    transition: opacity var(--duration-base) var(--ease);
  }

  .reactor-face[data-surge='warning'] .core-heart,
  .reactor-face[data-surge='active'] .core-heart {
    opacity: 0;
  }

  .core-num {
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--gold-ink);
    text-shadow: 0 0 18px color-mix(in srgb, var(--gold) 70%, transparent);
  }

  .reactor-face[data-surge='warning'] .core-num {
    color: var(--gold);
  }

  .core-unit {
    font-size: 0.75rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--gold) 65%, var(--ink-primary));
  }

  /* Each countdown second lands with a snap. */
  .core-num.is-tick {
    animation: core-tick 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes core-tick {
    0% {
      opacity: 0;
      transform: scale(1.6);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* --- Sparks (one burst per overdrive press) -------------------------------- */

  .sparks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* A short streak that flies out from the core's rim along its own angle.
     Placed at the core's centre by the script; rotate, then travel. */
  .sparks :global(.spark) {
    position: absolute;
    width: 14px;
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(to right, transparent, var(--gold-ink));
    box-shadow: 0 0 6px color-mix(in srgb, var(--gold) 80%, transparent);
    transform-origin: 0 50%;
    animation: spark 480ms ease-out forwards;
  }

  @keyframes spark {
    0% {
      opacity: 1;
      transform: rotate(var(--a)) translateX(var(--r0));
    }
    100% {
      opacity: 0;
      transform: rotate(var(--a)) translateX(var(--r1)) scaleX(0.3);
    }
  }

  .state-label {
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-size: var(--text-title-size);
  }

  /* Tinted toward the stage color, so the name and the glow read together. */
  .state-name {
    font-weight: 700;
    color: color-mix(in srgb, var(--stage) 50%, var(--ink-primary));
  }

  .state-name.is-settling {
    animation: name-settle 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes name-settle {
    0% {
      opacity: 0;
      letter-spacing: 0.3em;
    }
    100% {
      opacity: 1;
      letter-spacing: 0;
    }
  }

  .state-noun {
    color: var(--ink-muted);
  }

  /* Stands in for the state label while a surge counts down and runs. */
  .surge-label {
    z-index: 1;
    font-size: var(--text-title-size);
    font-weight: 700;
    color: var(--gold);
  }

  /* --- Combo meter ----------------------------------------------------------- */

  .combo {
    z-index: 1;
    width: min(360px, 100%);
  }

  .combo-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-block-end: var(--space-xs);
  }

  .combo-count {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .combo-tier {
    font-size: var(--text-label-size);
    color: var(--ink-muted);
  }

  .combo-tier.is-tiered {
    font-weight: 600;
    color: var(--ink-primary);
  }

  /* Tier up: the label snaps, the way the GO state does. */
  .combo-tier.is-up {
    animation: tier-up 360ms cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: left center;
  }

  @keyframes tier-up {
    0% {
      transform: scale(1.35);
      color: var(--signal-green);
    }
    100% {
      transform: scale(1);
    }
  }

  /* The next target, so the player chases a number rather than waits. */
  .combo-next {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .combo-mult {
    margin-inline-start: auto;
    font-size: var(--text-title-size);
    font-weight: 700;
    color: var(--ink-secondary);
  }

  .combo-track {
    width: 100%;
    height: 4px;
    border-radius: var(--radius-full);
    background-color: var(--panel-01);
    overflow: hidden;
  }

  /* The fill draining is the grace window: green as "active", and it fades to
     nothing the moment the combo is gone. */
  .combo-fill {
    width: 100%;
    height: 100%;
    background-color: var(--signal-green);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  .test-hint {
    z-index: 1;
    max-width: 38ch;
    font-size: var(--text-label-size);
    font-style: italic;
    color: var(--ink-muted);
    text-align: center;
  }

  .keycap {
    z-index: 1;
    display: block;
    width: min(320px, 70%);
    padding: var(--space-sm) 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--panel-01);
    /* The key's lip is a shadow, not a border, so pressing it moves nothing
       around it. */
    box-shadow: 0 2px 0 var(--line);
    color: var(--ink-muted);
    font-size: var(--text-label-size);
    font-weight: var(--text-label-weight);
    letter-spacing: 0.24em;
    text-align: center;
    text-transform: uppercase;
  }

  /* Every press bottoms the key out for a moment, lit in the stage color. */
  .keycap.is-down {
    animation: key-down 170ms var(--ease);
  }

  @keyframes key-down {
    0% {
      transform: translateY(2px);
      box-shadow: 0 0 0 var(--line);
      border-color: color-mix(in srgb, var(--stage) 45%, var(--line));
      color: var(--stage);
    }
  }

  /* --- Rhythm scope ------------------------------------------------------------ */

  /* Drawn by the script. The left edge fades out, so old presses scroll away
     rather than drop off a cliff. */
  .rhythm-scope {
    display: block;
    width: 100%;
    height: 24px;
    margin-block-start: 6px;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 30%);
    mask-image: linear-gradient(to right, transparent, #000 30%);
  }

  /* --- Surge results card ------------------------------------------------------ */

  .surge-card {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    min-width: min(300px, calc(100vw - 4rem));
    padding: var(--space-md) var(--space-lg);
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    border-radius: var(--radius-lg);
    background-color: var(--panel-01);
    box-shadow: 0 0 32px color-mix(in srgb, var(--gold) 12%, transparent);
    text-align: center;
    transform: translate(-50%, -50%);
    pointer-events: none;
    animation: card-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translate(-50%, calc(-50% + 10px));
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%);
    }
  }

  .surge-card-title {
    font-size: var(--text-label-size);
    font-weight: 700;
    color: var(--gold);
  }

  .surge-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
    width: 100%;
  }

  .surge-stats > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .surge-stats dt {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .surge-stats dd {
    font-size: var(--text-headline-size);
    font-weight: 700;
    line-height: 1.1;
  }

  .surge-best {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
    background-color: rgb(34 197 94 / 10%);
    color: var(--signal-green); /* "your best" */
    font-size: var(--text-label-size);
    font-weight: 600;
    overflow: hidden;
  }

  /* One sheen across the chip once the numbers land. */
  .surge-best.is-shining::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgb(255 255 255 / 40%) 50%,
      transparent 70%
    );
    transform: translateX(-100%);
    animation: sheen 900ms ease-out forwards;
  }

  @keyframes sheen {
    to {
      transform: translateX(100%);
    }
  }

  /* --- Toast ---------------------------------------------------------------- */

  .toast {
    position: absolute;
    inset-block-start: var(--space-md);
    inset-inline-end: var(--space-md);
    z-index: 3;
    max-width: 60%;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--panel-01);
    font-size: var(--text-label-size);
    font-weight: 500;
    color: var(--ink-primary);
  }

  .toast.is-in {
    animation: toast-in var(--duration-base) var(--ease);
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --- Shop -------------------------------------------------------------------- */

  .shop {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
    min-height: 0; /* lets the list scroll inside the pinned height */
  }

  .shop-heading {
    font-size: var(--text-title-size);
    font-weight: var(--text-title-weight);
  }

  /* The tabs themselves take the shared .tab look (setting-button parity);
     these rules only lay them out and carry the tag. */
  .shop-tabs {
    display: flex;
    gap: var(--space-sm);
    margin-block-end: var(--space-xs);
  }

  .shop-tab {
    position: relative;
    flex: 1;
  }

  /* Shop-Signal Exception: amber means "something new to spend on". Pinned to
     the tab's top-right corner so it never shifts the label. */
  .shop-new-tag {
    position: absolute;
    inset-block-start: -9px;
    inset-inline-end: -6px;
    padding: 2px 7px;
    border-radius: var(--radius-full);
    background-color: var(--caution-amber);
    color: var(--chassis-black);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.02em;
    pointer-events: none;
    animation: new-tag-in 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes new-tag-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .shop-panel {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .shop-list {
    display: flex;
    flex: 1;
    min-height: 0;
    flex-direction: column;
    gap: var(--space-xs);
    padding: 0;
    overflow-y: auto;
    list-style: none;
  }

  /* Three fixed columns: glyph tile, text, numbers. Every row puts its name at
     the same x, whatever the price beside it. */
  .shop-buy {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.75rem;
    width: 100%;
    padding: var(--space-sm) var(--space-md) var(--space-sm) var(--space-sm);
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
    background-color: var(--panel-03);
    color: var(--ink-secondary);
    text-align: start;
    cursor: default;
    transition:
      border-color var(--duration-fast) var(--ease),
      background-color var(--duration-fast) var(--ease);
  }

  .shop-buy.is-affordable {
    border-color: var(--line);
    color: var(--ink-primary);
    cursor: pointer;
  }

  .shop-buy.is-affordable:hover {
    background-color: var(--panel-hover);
    border-color: var(--ink-muted);
  }

  .shop-buy.is-maxed {
    opacity: 0.7;
  }

  /* A recessed tile for the glyph, as the related-tools cards do. It
     brightens with the row when the item is affordable. */
  .shop-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-subtle);
    border-radius: var(--radius-md);
    background-color: var(--panel-01);
    color: var(--ink-muted);
    transition:
      color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease);
  }

  .shop-buy.is-affordable .shop-icon {
    border-color: var(--line);
    color: var(--ink-primary);
  }

  .shop-text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .shop-name {
    font-size: var(--text-label-size);
    font-weight: 600;
  }

  .shop-detail {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .shop-nums {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .shop-cost {
    font-size: var(--text-label-size);
    font-weight: 700;
    color: var(--ink-muted);
  }

  .shop-buy.is-affordable .shop-cost {
    color: var(--ink-primary);
  }

  .shop-level {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .shop-hint {
    font-size: 0.75rem;
    font-style: italic;
    color: var(--ink-muted);
  }

  /* --- Panels -------------------------------------------------------------------- */

  .panels {
    padding-block-start: var(--space-lg);
    border-block-start: 1px solid var(--line-subtle);
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-block-end: var(--space-lg);
  }

  .tab {
    min-width: 44px;
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--panel-03);
    color: var(--ink-secondary);
    font-size: var(--text-label-size);
    font-weight: var(--text-label-weight);
    transition: all var(--duration-fast) var(--ease);
  }

  .tab:hover {
    background-color: var(--panel-hover);
    border-color: var(--ink-muted);
    color: var(--ink-primary);
  }

  /* Selected reads as the active setting button: a recessed, illuminated key.
     Shared by the shop tabs and the panel tabs. */
  .tab[aria-selected='true'] {
    background-color: var(--chassis-black);
    border-color: var(--signal-green);
    color: var(--ink-primary);
  }

  .tab[aria-selected='true']:hover {
    background-color: var(--panel-hover);
    border-color: var(--signal-green);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-sm) var(--space-lg);
  }

  .stats > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    background-color: var(--panel-03);
  }

  .stats dt {
    font-size: var(--text-label-size);
    color: var(--ink-secondary);
  }

  .stats dd {
    font-weight: 700;
  }

  .panel-intro {
    margin-block-end: var(--space-md);
    font-size: var(--text-label-size);
    color: var(--ink-secondary);
  }

  .achievements {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-sm);
    padding: 0;
    list-style: none;
  }

  .achievement {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    background-color: var(--panel-03);
  }

  .achievement-mark {
    min-width: 20px;
    font-weight: 700;
    color: var(--ink-muted);
  }

  .achievement.is-unlocked .achievement-mark {
    color: var(--signal-green); /* achieved, as the rank checklist does */
  }

  .achievement-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .achievement-name {
    font-size: var(--text-label-size);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .achievement.is-unlocked .achievement-name {
    color: var(--ink-primary);
  }

  .achievement-detail {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .prestige {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 60ch;
  }

  .prestige-copy,
  .prestige-locked {
    font-size: var(--text-label-size);
    line-height: 1.7;
    color: var(--ink-secondary);
  }

  .prestige-copy .readout,
  .prestige-locked .readout {
    color: var(--ink-primary);
  }

  .prestige-ready {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }

  .prestige-gain-row {
    color: var(--ink-secondary);
  }

  .prestige-gain {
    font-size: var(--text-headline-size);
    font-weight: 700;
    color: var(--ink-primary);
  }

  /* --- Buttons and dialogs ---------------------------------------------------------- */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    font-size: var(--text-label-size);
    font-weight: 600;
    transition: all var(--duration-fast) var(--ease);
  }

  .btn-primary {
    background-color: var(--signal-green);
    border-color: var(--signal-green);
    color: var(--chassis-black);
  }

  .btn-primary:hover {
    background-color: var(--signal-green-deep);
    border-color: var(--signal-green-deep);
    transform: translateY(-1px);
    box-shadow:
      0 0 20px rgb(34 197 94 / 20%),
      0 0 40px rgb(34 197 94 / 20%);
  }

  .btn-secondary {
    border-color: var(--line);
    background: transparent;
    color: var(--ink-primary);
  }

  .btn-secondary:hover {
    background-color: var(--panel-hover);
    border-color: var(--ink-muted);
  }

  /* Mirrors ResetModal.astro so the three dialogs read as one component. */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-lg);
    background-color: rgb(0 0 0 / 70%);
    backdrop-filter: blur(4px);
  }

  .modal {
    width: 100%;
    max-width: 400px;
    padding: var(--space-xl);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background-color: var(--panel-02);
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 40%),
      0 4px 6px -4px rgb(0 0 0 / 30%);
    text-align: center;
  }

  .modal-title {
    margin-block-end: var(--space-md);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .modal-message {
    margin-block-end: var(--space-xl);
    font-size: var(--text-label-size);
    line-height: 1.7;
    color: var(--ink-secondary);
  }

  .modal-message .readout {
    color: var(--ink-primary);
    font-weight: 700;
  }

  .modal-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
  }

  /* --- Responsive ------------------------------------------------------------------- */

  @media (max-width: 900px) {
    .game-grid {
      grid-template-columns: 1fr;
    }

    .reactor-face {
      min-height: 460px;
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: var(--text-body-size);
    }

    .game-card {
      padding: var(--space-md);
    }

    .reactor-face {
      padding: var(--space-md);
    }

    .core-wrap {
      --core-size: 140px;
    }

    .keycap {
      width: 100%;
    }

    .surge-summary {
      gap: var(--space-md);
    }

    .toast {
      max-width: 80%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .core,
    .core.is-pressed,
    .core.is-stepped,
    .combo-tier.is-up,
    .arc-fill,
    .arc-fill.is-sweeping,
    .dial-led.is-new,
    .state-name.is-settling,
    .core-num.is-tick,
    .surge-card,
    .keycap.is-down,
    .pellets :global(.pellet.is-landed),
    .reactor-face.is-imploding .core,
    .reactor-face.is-blooming .core,
    .toast.is-in,
    .shop-new-tag {
      animation: none;
      transition: none;
    }

    /* Movement goes; the color fades stay, since they are not motion and
       they carry the change. */
    .reactor-face[data-surge='warning'] {
      transition: var(--stage-fade);
    }

    .floats :global(.float),
    .sparks,
    .motes,
    .surge-best.is-shining::after,
    .shockwave,
    .grid-wash {
      display: none;
    }
  }

  /* Registered so stage changes fade between values instead of swapping, and
     so the wash's radius can animate. Browsers without @property swap. */
  @property --stage {
    syntax: '<color>';
    inherits: true;
    initial-value: #22c55e;
  }

  @property --halo {
    syntax: '<color>';
    inherits: true;
    initial-value: #22c55e;
  }

  @property --core-heart {
    syntax: '<color>';
    inherits: true;
    initial-value: transparent;
  }

  @property --core-alpha {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 14%;
  }

  @property --core-glow {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  @property --wash-r {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }
</style>
