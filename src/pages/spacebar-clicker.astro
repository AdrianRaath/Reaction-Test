  /* The dial: the arc fills toward the next state; the lights record each
     state reached this run. */
  .core-arc {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: calc(var(--core-size) + 56px);
    height: calc(var(--core-size) + 56px);
    overflow: visible;
    transform: translate(-50%, -50%) rotate(-90deg);
    pointer-events: none;
    transition:
      opacity 900ms ease,
      filter 900ms ease;
