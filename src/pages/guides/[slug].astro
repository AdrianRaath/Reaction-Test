---
import { getCollection, render } from 'astro:content';
import TocSidebar from '../../components/guides/TocSidebar.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/article.css';

// Guides use the same shell as tools — no separate reading layout (§5).
// The entry id is the URL slug; these are live, ranked URLs (§7).

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);

const site = Astro.site ?? new URL('https://reflexlab.co');
const path = `/guides/${guide.id}`;
const canonical = new URL(path, site).href;

const updated = new Date(guide.data.dateModified).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Read time at ~200 wpm, derived from the raw body so it never drifts from
// the content.
const words = (guide.body ?? '')
  .replace(/<[^>]*>/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 200));

// Article JSON-LD. Attribution is publisher-level (the site), deliberately —
// no personal byline anywhere on ReflexLab.
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.data.title,
  description: guide.data.description,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  datePublished: guide.data.datePublished,
  dateModified: guide.data.dateModified,
  author: { '@type': 'Organization', name: 'ReflexLab', url: site.href },
  publisher: {
    '@type': 'Organization',
    name: 'ReflexLab',
    url: site.href,
    logo: { '@type': 'ImageObject', url: new URL('/assets/reflex-favicon.png', site).href },
  },
  image: new URL('/assets/reflex-og.png', site).href,
};

// FAQPage JSON-LD, from frontmatter — same pattern as the tools collection.
const faqLd = guide.data.faq && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guide.data.faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<BaseLayout
  title={guide.data.pageTitle}
  description={guide.data.description}
  path={path}
  ogType="article"
  topbarLabel="Guides"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleLd)} />
    {faqLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <div class="guide-layout">
    <article class="article-container">
      <header class="article-header">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="breadcrumbs-separator">/</span>
          <a href="/guides">Guides</a>
          <span class="breadcrumbs-separator">/</span>
          <span class="breadcrumbs-current">{guide.data.title}</span>
        </nav>
        <p class="article-eyebrow">
          {guide.data.emoji && <span aria-hidden="true">{guide.data.emoji}</span>}
          Guide
        </p>
        <h1 class="article-title">{guide.data.title}</h1>
        <p class="article-subtitle">{guide.data.subtitle}</p>
        <p class="article-meta">
          Updated <time datetime={guide.data.dateModified}>{updated}</time>
          <span class="article-meta-sep" aria-hidden="true"></span>
          <span class="article-meta-num">{minutes}</span> min read
        </p>
      </header>

      <div class="article-content">
        <Content />
      </div>
    </article>

    <TocSidebar headings={headings} labels={guide.data.tocLabels} />
  </div>

  <section class="disclaimer-section">
    <div class="container">
      <p class="disclaimer">
        <strong>Disclaimer:</strong> Guides share general information about human performance, not medical
        advice. Measured reaction times vary with your device, browser, and testing conditions.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Single column by default; on wide viewports the TOC rail joins the grid.
     The rail is part of the main column's layout — the shell's reserved
     right rail (ads, §4.2) stays untouched. */
  .guide-layout {
    display: block;
  }

  @media (min-width: 1100px) {
    .guide-layout {
      display: grid;
      grid-template-columns: minmax(0, 720px) 200px;
      justify-content: center;
      column-gap: var(--space-2xl);
    }
  }

  .disclaimer-section {
    padding: var(--space-xl) 0 0;
    border-block-start: 1px solid var(--line-subtle);
  }

  .disclaimer {
    max-width: 720px;
    margin-inline: auto;
    font-size: var(--text-label-size);
    color: var(--ink-muted);
    text-align: center;
  }

  .container {
    width: 100%;
    max-width: 960px;
    margin-inline: auto;
  }
</style>
