---
// TEMPORARY — delete before cutover to main.
//
// The shell (§3.5) is built in phase 1 but does not get a real page until the
// CPS port in phase 3. This page exists only so the layout can be reviewed in
// the Vercel preview deployment in the meantime. It is noindexed and is not in
// the sitemap. Tracked as a known temp artifact in REVAMP.md §7.
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout
  title="Shell preview"
  description="Internal layout preview. Not a public page."
  path="/shell-preview"
  topbarLabel="Shell preview"
  noindex
>
  <button slot="controls" type="button" class="ctl" aria-label="Toggle sound">
    <Icon name="ph:speaker-high" width={18} height={18} aria-hidden="true" />
  </button>
  <button slot="controls" type="button" class="ctl">
    <Icon name="ph:trash" width={18} height={18} aria-hidden="true" />
    <span>Reset</span>
  </button>

  <div class="stack">
    <section class="panel">
      <p class="eyebrow">Test surface stand-in</p>
      <p class="readout">247<span class="unit">ms</span></p>
      <p class="muted">
        Roughly the vertical space a tool occupies. The page scrolls normally
        beneath it.
      </p>
    </section>

    <section class="prose">
      <h1>Long-form content sits here</h1>
      <p>
        Tool pages carry substantial prose because that copy is what ranks. The
        sidebar and top bar stay fixed while this column scrolls, which is what
        keeps an app-like shell compatible with pages that need hundreds of
        lines of content below the fold.
      </p>
      <h2>Measured values use the monospace readout</h2>
      <p>
        Prose is never monospace and measured values always are, so digits never
        reflow as a number changes. This paragraph is capped at the prose
        measure so it stays readable in the narrowed column.
      </p>
      <p>
        Resize below 900px to check the drawer: the sidebar slides off-canvas,
        the top bar stops being sticky so it cannot eat vertical space, and the
        menu button appears.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: center;
    justify-content: center;
    min-height: 40vh;
    padding: var(--space-xl);
    border: 1px solid var(--line);
    border-radius: var(--radius-2xl);
    background-color: var(--panel-02);
    text-align: center;
  }

  .eyebrow {
    color: var(--ink-muted);
    font-size: var(--text-label-size);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .readout {
    font-family: var(--font-mono);
    font-size: var(--text-readout-size);
    font-weight: var(--text-readout-weight);
    line-height: var(--text-readout-lh);
    font-variant-numeric: tabular-nums;
  }

  .unit {
    color: var(--ink-muted);
    font-size: var(--text-headline-size);
  }

  .muted {
    max-width: 40ch;
    color: var(--ink-secondary);
  }

  .prose {
    max-width: var(--content-max);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .prose h1 {
    font-size: var(--text-display-size);
    letter-spacing: var(--text-display-ls);
    line-height: var(--text-display-lh);
  }

  .prose h2 {
    font-size: var(--text-headline-size);
    margin-block-start: var(--space-md);
  }

  .prose p {
    color: var(--ink-secondary);
  }

  .ctl {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    color: var(--ink-secondary);
    font-size: var(--text-label-size);
  }

  .ctl:hover {
    background-color: var(--panel-hover);
    color: var(--ink-primary);
  }

  @media (max-width: 900px) {
    .prose h1 {
      font-size: 2rem;
    }
  }
</style>
