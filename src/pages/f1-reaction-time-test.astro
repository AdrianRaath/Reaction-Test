---
import { getEntry, render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgressWidgets from '../components/tool/ProgressWidgets.astro';
import RelatedTools from '../components/tool/RelatedTools.astro';
import ResetModal from '../components/tool/ResetModal.astro';
import { f1ReactionTool } from '../data/tool-defs';
import '../styles/content.css';
import '../styles/instrument.css';

// Tool-page titles target the primary keyword and carry no "| ReflexLab"
// suffix (NEW-TOOL.md). Primary keyword: "F1 Reaction Time Test".
//
// Positioning: an independent practice tool that copies the start-light
// sequence. Never "official", never affiliated — the trademark disclaimer at
// the foot of the content is part of the page, not an optional extra.
const TITLE = 'F1 Reaction Time Test - Five Lights, Lights Out, Your Time';
const DESCRIPTION =
  'Free F1 reaction time test. Five red lights come on, hold for a random moment, then go out. React like a race start, get your time in milliseconds, and track your best.';

const entry = await getEntry('tools', 'f1-reaction-time');
if (!entry) throw new Error('Missing tools/f1-reaction-time content entry');
const { Content } = await render(entry);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entry.data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

// Milestones read easiest-first, the order they are reached in.
const milestones = f1ReactionTool.milestones ?? [];
const lightColumns = [1, 2, 3, 4, 5];
---

<BaseLayout
  title={TITLE}
  description={DESCRIPTION}
  path="/f1-reaction-time-test"
  topbarLabel="F1 Start Test"
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <button slot="controls" type="button" class="ctl" id="sound-toggle" aria-label="Toggle sound">
    <span class="ctl-icon" id="sound-icon-on">
      <Icon name="ph:speaker-high" width={18} height={18} aria-hidden="true" />
    </span>
    <span class="ctl-icon" id="sound-icon-off" hidden>
      <Icon name="ph:speaker-slash" width={18} height={18} aria-hidden="true" />
    </span>
  </button>
  <button slot="controls" type="button" class="ctl" id="reset-btn" aria-label="Reset all data">
    <Icon name="ph:trash" width={18} height={18} aria-hidden="true" />
    <span>Reset</span>
  </button>

  <!-- ========== HERO ========== -->
  <section class="hero-section">
    <div class="hero-content">
      <h1 class="hero-title">F1 Reaction Time Test</h1>
      <p class="hero-subtitle">
        Test your reaction time on a race start. Five red lights, a random hold, then lights out. F1
        drivers launch in about 0.2 seconds. See how close you get.
      </p>
    </div>
  </section>

  <!-- ========== TEST ========== -->
  <section id="test-section" class="test-section">
    <div class="test-card">
      <div class="settings-panel">
        <div class="setting-group">
          <span class="setting-label" id="rounds-label">Starts per session</span>
          <div class="btn-group" id="rounds-group" role="group" aria-labelledby="rounds-label">
            <button type="button" class="btn-option" data-value="1">1</button>
            <button type="button" class="btn-option" data-value="3">3</button>
            <button type="button" class="btn-option active" data-value="5">5</button>
            <button type="button" class="btn-option" data-value="10">10</button>
          </div>
        </div>
        <div class="setting-group">
          <span class="setting-label" id="input-label">Input Method</span>
          <div class="btn-group" id="input-group" role="group" aria-labelledby="input-label">
            <button type="button" class="btn-option active" data-value="mouse">Mouse Click</button>
            <button type="button" class="btn-option" data-value="spacebar">Spacebar Hit</button>
          </div>
        </div>
      </div>

      <div
        id="f1-area"
        class="test-area state-idle"
        tabindex="0"
        role="button"
        aria-label="F1 start test area. Press Enter or Space to start the light sequence, then click or press Space the moment all five lights go out."
      >
        <!-- Default content (shown during the test) -->
        <div class="test-area-content" id="f1-content-default">
          <!-- The start gantry: five columns, two lamps each, lit in order by
               the script via .lit on the column. Lit lamps are Hold Red (wait);
               dark lamps are the stimulus. -->
          <div class="f1-gantry" id="f1-gantry" aria-hidden="true">
            {
              lightColumns.map(() => (
                <div class="f1-column">
                  <span class="f1-lamp" />
                  <span class="f1-lamp" />
                </div>
              ))
            }
          </div>
          <p class="test-hint" id="f1-hint">
            Five red lights come on one at a time. When they all go out, click as fast as you can.
          </p>
          <p class="test-status" id="f1-status" aria-live="polite">Click to start</p>
          <p class="test-result readout" id="f1-result"></p>
          <p class="test-instruction" id="f1-instruction"></p>
        </div>

        <!-- Results content (shown after the session) -->
        <div class="test-area-results" id="f1-content-results" hidden>
          <div class="attempts-row" id="f1-attempts-list">
            <!-- Attempts populated by JS -->
          </div>

          <div class="main-result-card">
            <p class="result-heading">Your average start was</p>
            <div class="result-time-row">
              <span class="result-time readout" id="f1-avg-time">0</span>
              <span class="result-unit">ms</span>
            </div>
            <p class="f1-best-flag" id="f1-best-flag" hidden>
              <span aria-hidden="true">🏆</span> New best!
            </p>
          </div>

          <p class="result-message" id="f1-result-message">Run it again and watch the trend.</p>

          <button class="btn btn-try-again" id="f1-try-again" type="button">Try Again</button>
        </div>

        <!-- Screen-reader live announcements -->
        <p class="visually-hidden" id="f1-announce" aria-live="assertive"></p>
      </div>

      <!-- Round progress bar -->
      <div class="progress-bar-container" role="presentation">
        <div class="progress-bar" id="f1-progress-bar"></div>
      </div>
    </div>

    <ResetModal message="your best start, session history, and milestones" />

    <ProgressWidgets
      unit="ms"
      bestTitle="Best Start"
      bestSubtitle="Your fastest session average"
      bestEmpty="Complete a session to set your best start."
      avgTitle="Average Start"
      avgNoun="sessions"
      avgEmpty="Complete a session to see your average."
      chartDescription="Average start reaction time (ms) over your last sessions"
      chartEmpty="Complete a session to see your trend graph"
      historyEmpty="Complete a session to see your history"
      milestones={milestones}
    />
  </section>

  <Content />

  <RelatedTools current="/f1-reaction-time-test" />
</BaseLayout>

<script>
  import '../scripts/f1-reaction-time';
</script>

<style>
  /* --- Top-bar controls ------------------------------------------------------ */

  .ctl {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    color: var(--ink-secondary);
    font-size: var(--text-label-size);
  }

  .ctl:hover {
    background-color: var(--panel-hover);
    color: var(--ink-primary);
  }

  .ctl.muted {
    color: var(--ink-muted);
  }

  .ctl-icon {
    display: inline-flex;
  }

  /* --- Hero ----------------------------------------------------------------- */

  .hero-section {
    padding: var(--space-xl) 0 var(--space-md);
    text-align: center;
  }

  .hero-content {
    max-width: 600px;
    margin-inline: auto;
  }

  .hero-title {
    margin-block-end: var(--space-md);
    font-size: var(--text-display-size);
    font-weight: var(--text-display-weight);
    line-height: var(--text-display-lh);
    letter-spacing: var(--text-display-ls);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--ink-secondary);
  }

  /* --- Test card --------------------------------------------------------------- */

  .test-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    padding-block: var(--space-md) var(--space-2xl);
  }

  .test-card {
    display: flex;
    width: 100%;
    max-width: 960px;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg);
    border: 1px solid var(--line);
    border-radius: var(--radius-2xl);
    background-color: var(--panel-02);
  }

  .settings-panel {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-xl);
    padding-block-end: var(--space-lg);
    border-block-end: 1px solid var(--line-subtle);
  }

  .setting-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .setting-label {
    font-size: var(--text-label-size);
    font-weight: var(--text-label-weight);
    color: var(--ink-secondary);
  }

  .btn-group {
    display: flex;
    gap: var(--space-sm);
  }

  .btn-option {
    min-width: 44px;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--panel-03);
    color: var(--ink-secondary);
    font-size: var(--text-label-size);
    font-weight: var(--text-label-weight);
    text-align: center;
    transition: all var(--duration-fast) var(--ease);
  }

  .btn-option:hover {
    background-color: var(--panel-hover);
    border-color: var(--ink-muted);
    color: var(--ink-primary);
  }

  .btn-option.active {
    background-color: var(--chassis-black);
    border-color: var(--signal-green);
    color: var(--ink-primary);
  }

  .btn-option.active:hover {
    background-color: var(--panel-hover);
    border-color: var(--signal-green);
  }

  /* --- Test area (the instrument face) ------------------------------------------
     Each state pairs its colour with a distinct text message, so state is
     never signalled by colour alone. The stimulus itself is lights going
     dark, a luminance change, which reads the same for every kind of colour
     vision. */

  .test-area {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 380px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    transition: all var(--duration-base) var(--ease);
  }

  .test-area:focus-visible {
    outline: 2px solid var(--signal-green);
    outline-offset: 3px;
  }

  .test-area:active:not(.state-lights):not(.state-session-complete) {
    transform: scale(0.98);
  }

  .test-area.state-idle {
    background-color: var(--panel-03);
    border: 2px solid var(--line);
  }

  .test-area.state-idle:hover {
    background-color: var(--panel-hover);
    border-color: var(--ink-secondary);
  }

  /* Lights on: red is "wait" — the gantry carries it, the frame stays quiet
     so the lamps are the only thing that changes at lights-out. */
  .test-area.state-lights {
    background-color: var(--panel-03);
    border: 2px solid var(--line);
  }

  /* Lights out: the frame goes green with the text cue. The lamps going dark
     and this border change land in the same paint. */
  .test-area.state-go {
    background-color: var(--panel-03);
    border: 2px solid var(--signal-green);
    box-shadow:
      0 0 20px rgb(34 197 94 / 20%),
      0 0 40px rgb(34 197 94 / 20%);
  }

  .test-area.state-go :global(.test-status) {
    color: var(--signal-green);
  }

  .test-area.state-result {
    background-color: var(--panel-03);
    border: 2px solid var(--line);
  }

  .test-area.state-result :global(.test-result) {
    color: var(--signal-green);
  }

  .test-area.state-jump-start {
    background: linear-gradient(135deg, #450a0a 0%, #7f1d1d 100%);
    border: 2px solid var(--hold-red);
    box-shadow:
      0 0 20px rgb(239 68 68 / 20%),
      0 0 40px rgb(239 68 68 / 20%);
  }

  .test-area.state-jump-start :global(.test-status) {
    color: var(--hold-red);
    animation: shake 0.4s ease-out;
  }

  @keyframes shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-5px);
    }
    75% {
      transform: translateX(5px);
    }
  }

  .test-area.state-session-complete {
    background-color: var(--panel-03);
    border: 2px solid var(--line);
    min-height: 320px;
    cursor: default;
  }

  .test-area-content {
    z-index: 1;
    padding: 0 var(--space-lg);
    text-align: center;
  }

  /* --- The start gantry ----------------------------------------------------------
     Five columns of two lamps, the layout of the real thing. A column lights
     when the script adds .lit. Lit = Hold Red with a glow (state telemetry:
     "wait"); dark = a recessed lens. Size scales with the viewport so all
     five columns fit at 320px. */

  .f1-gantry {
    --lamp: clamp(34px, 9vw, 52px);
    display: flex;
    justify-content: center;
    gap: clamp(8px, 2.5vw, 16px);
    width: fit-content;
    margin: 0 auto var(--space-lg);
    padding: clamp(10px, 2.5vw, 16px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background-color: var(--panel-01);
  }

  .f1-column {
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 1.8vw, 10px);
  }

  .f1-lamp {
    display: block;
    width: var(--lamp);
    height: var(--lamp);
    border: 2px solid var(--line);
    border-radius: var(--radius-full);
    background-color: var(--chassis-black);
    box-shadow: inset 0 2px 4px rgb(0 0 0 / 60%);
    transition:
      background-color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease),
      box-shadow var(--duration-fast) var(--ease);
  }

  .f1-column.lit .f1-lamp {
    border-color: var(--hold-red);
    background-color: var(--hold-red);
    box-shadow:
      0 0 12px rgb(239 68 68 / 60%),
      0 0 28px rgb(239 68 68 / 30%);
  }

  /* Lights-out must be instant: no fade on the way to dark. The transition
     above only softens the way lamps come on. */
  .f1-column:not(.lit) .f1-lamp {
    transition: none;
  }

  .test-hint {
    margin-block-end: var(--space-lg);
    font-size: var(--text-label-size);
    font-style: italic;
    color: var(--ink-muted);
  }

  .test-status {
    margin-block-end: var(--space-xs);
    font-size: var(--text-headline-size);
    font-weight: var(--text-headline-weight);
  }

  .test-result {
    margin-block-end: var(--space-xs);
    font-size: 2.5rem;
    font-weight: 700;
  }

  .test-result:empty {
    display: none;
  }

  .test-instruction {
    font-size: var(--text-label-size);
    color: var(--ink-muted);
  }

  /* --- Results ------------------------------------------------------------------ */

  .test-area-results {
    z-index: 1;
    width: 100%;
    padding: var(--space-lg);
    text-align: center;
  }

  /* Attempt columns are JS-created, so :global. */
  .attempts-row {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    margin-block-end: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background-color: var(--panel-01);
  }

  .attempts-row :global(.attempt-column) {
    min-width: 60px;
    text-align: center;
  }

  .attempts-row :global(.attempt-time) {
    display: block;
    margin-block-end: var(--space-xs);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .attempts-row :global(.attempt-label) {
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .main-result-card {
    margin-block-end: var(--space-lg);
    padding: var(--space-xl) var(--space-2xl);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background-color: var(--panel-01);
  }

  .result-heading {
    margin-block-end: var(--space-sm);
    color: var(--ink-secondary);
  }

  .result-time-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .result-time {
    font-size: var(--text-readout-size);
    font-weight: var(--text-readout-weight);
    line-height: var(--text-readout-lh);
  }

  .result-unit {
    font-size: var(--text-headline-size);
    font-weight: 500;
    color: var(--ink-secondary);
  }

  .f1-best-flag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-start: var(--space-md);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-full);
    background-color: rgb(34 197 94 / 10%);
    color: var(--signal-green); /* "your best" — sanctioned */
    font-size: var(--text-label-size);
    font-weight: 600;
    letter-spacing: 0.02em;
    animation: best-pop 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes best-pop {
    0% {
      opacity: 0;
      transform: translateY(6px) scale(0.9);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .result-message {
    margin-block-end: var(--space-lg);
    color: var(--ink-secondary);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid transparent;
    border-radius: var(--radius-lg);
    font-size: var(--text-label-size);
    font-weight: 600;
    transition: all var(--duration-fast) var(--ease);
  }

  .btn-try-again {
    min-width: 160px;
    background-color: var(--ink-primary);
    border-color: var(--ink-primary);
    color: var(--chassis-black);
  }

  .btn-try-again:hover {
    background-color: var(--ink-secondary);
    border-color: var(--ink-secondary);
  }

  /* --- Round progress bar ----------------------------------------------------------- */

  .progress-bar-container {
    width: 100%;
    height: 4px;
    border-radius: var(--radius-full);
    background-color: var(--panel-03);
    overflow: hidden;
  }

  .progress-bar {
    width: 0%;
    height: 100%;
    border-radius: var(--radius-full);
    background-color: var(--signal-green);
    transition: width var(--duration-base) var(--ease);
  }

  /* --- Responsive --------------------------------------------------------------------- */

  @media (max-width: 992px) {
    .settings-panel {
      order: 3;
      padding-block: var(--space-lg) 0;
      border-block-end: none;
      border-block-start: 1px solid var(--line-subtle);
      flex-wrap: wrap;
      gap: var(--space-md) var(--space-xl);
    }

    .progress-bar-container {
      order: 2;
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: var(--text-body-size);
    }

    .test-card {
      padding: var(--space-md);
    }

    .settings-panel {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-md);
    }

    .btn-group {
      width: 100%;
      flex-wrap: wrap;
    }

    .btn-option {
      flex: 1;
      min-height: 44px;
      padding: var(--space-sm);
    }

    .test-area {
      min-height: 340px;
    }

    .test-area-content {
      padding: 0 var(--space-md);
    }

    .attempts-row {
      gap: var(--space-md);
      padding: var(--space-sm) var(--space-md);
      flex-wrap: wrap;
    }

    .attempts-row :global(.attempt-column) {
      min-width: 50px;
    }

    .attempts-row :global(.attempt-time) {
      font-size: var(--text-body-size);
    }

    .main-result-card {
      padding: var(--space-lg);
    }

    .result-time {
      font-size: 3rem;
    }
  }

  /* Reduced motion: every state keeps its text cue; the motion goes quiet. */
  @media (prefers-reduced-motion: reduce) {
    .test-area.state-jump-start :global(.test-status) {
      animation: none;
    }

    .f1-best-flag {
      animation: none;
    }

    .f1-lamp {
      transition: none;
    }
  }
</style>
